&НаСервереБезКонтекста
Процедура Документы_(Д)

	// Закупки товаров: месяц, день, поставщик, позиции «ключ*количество».
	Закупки = СтрРазделить(
		"7|2|ккт|фн*20,касса*6;7|3|сканер|сканер*15;8|4|ккт|фн*15,касса*5;"
		+ "9|2|ккт|фн*18,касса*6;9|3|сканер|сканер*10;10|1|ккт|фн*10,касса*4", ";");
	Для Каждого Строка Из Закупки Цикл
		Поля = СтрРазделить(Строка, "|");
		Дата = Дата(2026, Число(Поля[0]), Число(Поля[1]), 10, 0, 0);
		Поступление = ТоварныйДокумент(Д, "purchase", Поля[2], Поля[3], Дата, "Закупка");
		Провести(Д, Поступление, Дата);
		СчетФактураПолученный(Д, Поступление, Дата);
		Оплата(Д, Документы.СписаниеСРасчетногоСчета, Поступление, Дата + 86400);
	КонецЦикла;

	// Продажи: месяц, день, покупатель, позиции, способ оплаты (банк/касса/нет), договор для техносферы.
	Продажи = СтрРазделить(
		"7|6|альфа|фн*4,касса*2|банк;7|8|лотос|прошивка*2|касса;7|10|строймастер|касса*1,фн*1|банк;"
		+ "7|14|громов|регистрация*1|касса;7|17|техносфера|фн*5|банк;7|21|сидоренко|прошивка*1|касса;"
		+ "7|24|альфа|обслуживание*3|банк;7|28|белова|сканер*2|касса;"
		+ "8|5|альфа|фн*3,сканер*4|банк;8|7|строймастер|прошивка*3|банк;8|12|лотос|сканер*1|касса;"
		+ "8|15|техносфера|касса*2|банк;8|19|громов|прошивка*1|касса;8|22|белова|регистрация*2|касса;"
		+ "8|26|альфа|обслуживание*3|банк;8|29|строймастер|фн*2|нет;"
		+ "9|4|альфа|фн*5,касса*2|банк;9|9|техносфера|сканер*5|банк;9|11|лотос|прошивка*2|касса;"
		+ "9|16|строймастер|касса*2|банк;9|18|сидоренко|регистрация*1|касса;9|23|громов|сканер*3|касса;"
		+ "9|25|альфа|обслуживание*3|нет;9|29|белова|фн*1|нет;"
		+ "10|6|альфа|фн*3|банк;10|9|строймастер|прошивка*2|банк;10|14|лотос|сканер*2|касса;"
		+ "10|17|громов|регистрация*1|касса;10|20|техносфера|касса*1|нет", ";");
	Счетчик = 0;
	Для Каждого Строка Из Продажи Цикл
		Поля = СтрРазделить(Строка, "|");
		Дата = Дата(2026, Число(Поля[0]), Число(Поля[1]), 12, 0, 0);
		Реализация = ТоварныйДокумент(Д, "sale", Поля[2], Поля[3], Дата, "");
		Провести(Д, Реализация, Дата);
		Если Поля[2] <> "сидоренко" Тогда
			СчетФактураВыданный(Д, Реализация, Дата);
		КонецЕсли;
		Если Поля[4] = "банк" Тогда
			Оплата(Д, Документы.ПоступлениеНаРасчетныйСчет, Реализация, Дата + 3 * 86400);
		ИначеЕсли Поля[4] = "касса" Тогда
			Оплата(Д, Документы.ПриходныйКассовыйОрдер, Реализация, Дата + 600);
		КонецЕсли;
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Д.Лог.Добавить("Продаж проведено: " + Счетчик);

	// Черновики 26.10.2026 — для поведенческих тестов.
	Дата = Дата(2026, 10, 26, 11, 0, 0);
	Черновик1 = ТоварныйДокумент(Д, "sale", "техносфера", "фн*2", Дата, "", Ложь); // два договора — не проведётся
	Записать(Черновик1, Дата);
	Черновик2 = ТоварныйДокумент(Д, "sale", "альфа", "прошивка*2", Дата + 60, "");
	Записать(Черновик2, Дата + 60);
	Реализация3 = ТоварныйДокумент(Д, "sale", "строймастер", "сканер*2", Дата + 120, "");
	Провести(Д, Реализация3, Дата + 120); // проведена, без счёта-фактуры — для «создай на основании»
	Д.Лог.Добавить("Черновик без договора (не проведётся): " + Черновик1);
	Д.Лог.Добавить("Черновик к проведению: " + Черновик2);
	Д.Лог.Добавить("Проведена без счёта-фактуры: " + Реализация3);

КонецПроцедуры

// Проблема для закрытия октября 2026 (тесты «что мешает закрыть месяц, что исправить»): товар продан,
// а его поступление осталось непроведённым — отрицательный остаток на 41 и нарушенная последовательность.
// Само закрытие БП 3.0 при этом выполняет (отрицательные остатки и ручные проводки на 20/25/52 без
// аналитики регламентные операции не останавливают — проверено), поэтому ценность кейса в проверке
// готовности и объяснении, а не в состоянии «выполнено с ошибками».
&НаСервереБезКонтекста
Процедура ПроблемаЗакрытия(Д, Режим = "проблема")

	Поступление = ТоварныйДокумент(Д, "purchase", "сканер", "сканер*50", Дата(2026, 10, 8, 10, 0, 0), "Закупка");
	Провести(Д, Поступление, Дата(2026, 10, 8, 10, 0, 0));
	Реализация = ТоварныйДокумент(Д, "sale", "громов", "сканер*50", Дата(2026, 10, 12, 11, 0, 0), "");
	Провести(Д, Реализация, Дата(2026, 10, 12, 11, 0, 0));
	Объект = Поступление.ПолучитьОбъект();
	Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения); // «случайно» распровели поступление
	Д.Лог.Добавить("Проблема «остаток»: " + Реализация + " продана без остатка — поступление "
		+ Поступление + " не проведено");

КонецПроцедуры

// Создаёт черновик реализации или поступления функцией расширения консультанта.
&НаСервереБезКонтекста
Функция ТоварныйДокумент(Д, Вид, Контрагент, Позиции, Дата, Пояснение, СДоговором = Истина)

	Строки = Новый Массив;
	Для Каждого Позиция Из СтрРазделить(Позиции, ",") Цикл
		Части = СтрРазделить(Позиция, "*");
		Цена = ?(Вид = "sale", Д.Цены[Части[0]].Продажа, Д.Цены[Части[0]].Закупка);
		Строки.Добавить(СтрШаблон("{""item"": %1, ""quantity"": %2, ""price"": %3}",
			РефJSON(Д.Номенклатура[Части[0]]), Части[1], Формат(Цена, "ЧГ=; ЧРД=.")));
	КонецЦикла;
	Аргументы = СтрШаблон("""organization"": %1, ""counterparty"": %2, ""warehouse"": %3, ""items"": [%4]",
		РефJSON(Д.Организация), РефJSON(Д.Контрагенты[Контрагент]), РефJSON(Д.Склад), СтрСоединить(Строки, ", "));
	Если СДоговором Тогда
		Договор = ДоговорКонтрагента(Д.Контрагенты[Контрагент]);
		Аргументы = Аргументы + ", ""contract"": " + РефJSON(Договор);
	КонецЕсли;
	Если Вид = "purchase" Тогда
		Аргументы = Аргументы + СтрШаблон(", ""incoming_number"": ""%1"", ""incoming_date"": ""%2""",
			"П-" + Формат(Дата, "ДФ=MMdd"), Формат(Дата, "ДФ=yyyy-MM-dd"));
	КонецЕсли;
	Если СДоговором Тогда
		Результат = иик_Инструменты.СоздатьЧерновикТоварногоДокумента("{""args"": {" + Аргументы + "}}", Вид);
	Иначе
		// Без договора типовой подбор вызовет исключение «несколько договоров» — создаём напрямую.
		Результат = иик_Инструменты.СоздатьЧерновикТоварногоДокумента("{""args"": {" + Аргументы
			+ ", ""contract"": " + РефJSON(Справочники.ДоговорыКонтрагентов.ПустаяСсылка()) + "}}", Вид);
	КонецЕсли;
	Объект = Результат.Ссылка.ПолучитьОбъект();
	Объект.Комментарий = Пояснение;
	Объект.Дата = Дата;
	Объект.Записать(РежимЗаписиДокумента.Запись);
	Возврат Объект.Ссылка;

КонецФункции

&НаСервереБезКонтекста
Функция ДоговорКонтрагента(Контрагент)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Д
		|ГДЕ Д.Владелец = &Контрагент УПОРЯДОЧИТЬ ПО Д.Наименование");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;

КонецФункции

&НаСервереБезКонтекста
Функция РефJSON(Ссылка)

	Возврат СтрШаблон("{""_ref"": ""%1"", ""uuid"": ""%2""}", Ссылка.Метаданные().ПолноеИмя(),
		Строка(Ссылка.УникальныйИдентификатор()));

КонецФункции

&НаСервереБезКонтекста
Процедура Провести(Д, Ссылка, Дата)

	Объект = Ссылка.ПолучитьОбъект();
	Объект.Дата = Дата;
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Тексты = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		ВызватьИсключение "Не проводится " + Ссылка + ": " + СтрСоединить(Тексты, "; ") + " | "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура Записать(Ссылка, Дата)

	Объект = Ссылка.ПолучитьОбъект();
	Объект.Дата = Дата;
	Объект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СчетФактураВыданный(Д, Реализация, Дата)

	Объект = Документы.СчетФактураВыданный.СоздатьДокумент();
	Объект.Заполнить(Реализация);
	Объект.Дата = Дата + 60;
	Провести(Д, Сохранить(Объект), Дата + 60);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СчетФактураПолученный(Д, Поступление, Дата)

	Объект = Документы.СчетФактураПолученный.СоздатьДокумент();
	Объект.Заполнить(Поступление);
	Объект.Дата = Дата;
	Объект.НомерВходящегоДокумента = Поступление.НомерВходящегоДокумента;
	Объект.ДатаВходящегоДокумента = Поступление.ДатаВходящегоДокумента;
	Объект.НДСПредъявленКВычету = Истина;
	Провести(Д, Сохранить(Объект), Дата);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура Оплата(Д, Менеджер, Основание, Дата)

	Объект = Менеджер.СоздатьДокумент();
	Объект.Заполнить(Основание);
	Объект.Дата = Дата;
	Провести(Д, Сохранить(Объект), Дата);

КонецПроцедуры

&НаСервереБезКонтекста
Функция Сохранить(Объект)

	Объект.Записать(РежимЗаписиДокумента.Запись);
	Возврат Объект.Ссылка;

КонецФункции

#КонецОбласти
