&НаСервереБезКонтекста
Процедура Проводка(Набор, Объект, СчетДт, Сумма, СубконтоДт)

	Запись = Набор.Добавить();
	Запись.Период = Объект.Дата;
	Запись.Организация = Объект.Организация;
	Запись.СчетДт = СчетДт;
	Запись.СчетКт = ПланыСчетов.Хозрасчетный.НераспределеннаяПрибыльВОбращении;
	Запись.Сумма = Сумма;
	Запись.Содержание = Объект.Содержание;
	Если СубконтоДт <> Неопределено Тогда
		Запись.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.БанковскиеСчета] = СубконтоДт;
	КонецЕсли;

