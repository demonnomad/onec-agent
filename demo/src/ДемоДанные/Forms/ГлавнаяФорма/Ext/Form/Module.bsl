// Заполняет пустую «Бухгалтерию предприятия 3.0» вымышленными данными для тестов ИИ-консультанта.
// Запуск без интерфейса (см. demo/make-demo.sh):
//   1cv8 ENTERPRISE /F<база> /Execute ДемоДанные.epf /C<файл лога>
// Все организации, люди, ИНН и банк вымышлены. Документы товаров и услуг создаются теми же функциями
// расширения иик_ИИКонсультант, что и в работе консультанта, поэтому расширение должно быть загружено.

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// /C"<лог>|<режим>": режим «проблема» — только документ с ошибкой закрытия месяца в уже заполненную базу.
	Части = СтрРазделить(ПараметрЗапуска, "|", Истина);
	Лог = ЗаполнитьНаСервере(?(Части.Количество() > 1, Части[1], ""));
	Если Части.Количество() > 0 И ЗначениеЗаполнено(Части[0]) Тогда
		Запись = Новый ЗаписьТекста(Части[0], КодировкаТекста.UTF8);
		Запись.Записать(Лог);
		Запись.Закрыть();
	КонецЕсли;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьНаСервере(Режим = "")

	Лог = Новый Массив;
	Попытка
		Д = Новый Структура;
		Д.Вставить("Лог", Лог);
		Д.Вставить("Организация", Организация());
		Лог.Добавить("Организация: " + Д.Организация + ", префикс " + Д.Организация.Префикс);
		Если СтрНачинаетсяС(Режим, "проблема") Тогда // только проблемный кейс в уже заполненную базу
			Д.Вставить("Склад", Склад());
			Д.Вставить("Счет", БанковскийСчет(Д.Организация));
			Справочники_(Д, Истина);
			ПроблемаЗакрытия(Д, Режим);
		Иначе
			Д.Вставить("Склад", Склад());
			Д.Вставить("Счет", БанковскийСчет(Д.Организация));
			Справочники_(Д);
			НачальныеОстатки(Д);
			Документы_(Д);
			ПроблемаЗакрытия(Д, "проблема");
		КонецЕсли;
	Исключение
		Лог.Добавить("ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Лог.Добавить("сообщение: " + Сообщение.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

#Область Справочники

&НаСервереБезКонтекста
Функция Организация()

	Ссылка = Справочники.Организации.НайтиПоРеквизиту("ИНН", "7704000017");
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Реквизиты = Новый Структура("Наименование, НаименованиеПолное, НаименованиеСокращенное, ИНН, КПП, ОписаниеОшибки",
		"Демо-Сервис", "Общество с ограниченной ответственностью «Демо-Сервис»", "ООО «Демо-Сервис»",
		"7704000017", "770401001", "");
	Параметры = Новый Структура;
	Параметры.Вставить("ВидОрганизации", Обработки.НачалоРаботы.ВидОрганизации("7704000017"));
	Параметры.Вставить("ИНН", "7704000017");
	Параметры.Вставить("Реквизиты", Реквизиты);
	Параметры.Вставить("СистемаНалогообложения", "Общая");
	Параметры.Вставить("ПлательщикЕНВД", Ложь);
	Параметры.Вставить("ПрименяетсяУСНПатент", Ложь);
	Параметры.Вставить("ПлательщикТорговогоСбора", Ложь);
	Параметры.Вставить("ИспользуетсяТрудНаемныхРаботников", Ложь);
	Параметры.Вставить("ДатаАктуальности", Дата(2026, 1, 1));
	Ссылка = Справочники.Организации.СоздатьОрганизацию(Параметры);
	Объект = Ссылка.ПолучитьОбъект();
	Объект.Префикс = "ДС";
	Объект.Записать();
	// Пустая организация из начального заполнения не нужна: с ней консультант спрашивал бы «от какой».
	Выборка = Справочники.Организации.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка <> Ссылка И Не Выборка.ПометкаУдаления Тогда
			Выборка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Ссылка;

КонецФункции

&НаСервереБезКонтекста
Функция Склад()

	Выборка = Справочники.Склады.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ЭтоГруппа И Не Выборка.ПометкаУдаления Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Объект = Справочники.Склады.СоздатьЭлемент();
	Объект.Наименование = "Основной склад";
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

&НаСервереБезКонтекста
Функция БанковскийСчет(Организация)

	Если ЗначениеЗаполнено(Организация.ОсновнойБанковскийСчет) Тогда
		Возврат Организация.ОсновнойБанковскийСчет;
	КонецЕсли;
	Банк = Справочники.Банки.НайтиПоКоду("044525999");
	Если Не ЗначениеЗаполнено(Банк) Тогда
		Объект = Справочники.Банки.СоздатьЭлемент();
		Объект.Код = "044525999";
		Объект.Наименование = "АО «ДЕМО-БАНК»";
		Объект.КоррСчет = "30101810400000000999";
		Объект.Город = "г. Москва";
		Объект.Записать();
		Банк = Объект.Ссылка;
	КонецЕсли;
	Объект = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Объект.Владелец = Организация;
	Объект.Наименование = "Расчетный счет в АО «ДЕМО-БАНК»";
	Объект.НомерСчета = "40702810900000000001";
	Объект.Банк = Банк;
	Объект.ВалютаДенежныхСредств = Константы.ВалютаРегламентированногоУчета.Получить();
	ЗаполнитьЗначенияСвойств(Объект, Новый Структура("ВидСчета", "Расчетный"));
	Объект.Записать();
	ОбъектОрганизации = Организация.ПолучитьОбъект();
	ОбъектОрганизации.ОсновнойБанковскийСчет = Объект.Ссылка;
	ОбъектОрганизации.Записать();
	Возврат Объект.Ссылка;

КонецФункции

&НаСервереБезКонтекста
Процедура Справочники_(Д, ТолькоНайти = Ложь)

	// Ключ, наименование, полное наименование, ИНН, КПП, роль (покупатель/поставщик), вид лица.
	Контрагенты = Новый Соответствие;
	Для Каждого Строка Из СтрРазделить(
		"альфа|АЛЬФА-ИНЖИНИРИНГ ООО|Общество с ограниченной ответственностью «Альфа-Инжиниринг»|7704000024|770401001|покупатель|ЮЛ;"
		+ "строймастер|СТРОЙМАСТЕР ООО|Общество с ограниченной ответственностью «Строймастер»|7704000031|770401001|покупатель|ЮЛ;"
		+ "техносфера|ТЕХНОСФЕРА ООО|Общество с ограниченной ответственностью «Техносфера»|7704000049|770401001|покупатель2|ЮЛ;"
		+ "лотос|Сидоренко Павел Андреевич ИП «Лотос»|Индивидуальный предприниматель Сидоренко Павел Андреевич|770400010159||покупатель|ИП;"
		+ "сидоренко|Сидоренко Мария Олеговна|Сидоренко Мария Олеговна|770400010222||покупатель|ФЛ;"
		+ "громов|Громов Илья Сергеевич ИП|Индивидуальный предприниматель Громов Илья Сергеевич|770400010303||покупатель|ИП;"
		+ "белова|Белова Наталья Викторовна ИП|Индивидуальный предприниматель Белова Наталья Викторовна|770400010470||покупатель|ИП;"
		+ "ккт|ККТ-ПОСТАВКА ООО|Общество с ограниченной ответственностью «ККТ-Поставка»|7714000055|771401001|поставщик|ЮЛ;"
		+ "сканер|СКАН-ОПТ ООО|Общество с ограниченной ответственностью «Скан-Опт»|7714000062|771401001|поставщик|ЮЛ", ";") Цикл
		Поля = СтрРазделить(Строка, "|");
		Если ТолькоНайти Тогда // режим «проблема»: база уже заполнена, берём существующих
			Контрагенты.Вставить(Поля[0], Справочники.Контрагенты.НайтиПоНаименованию(Поля[1], Истина));
			Продолжить;
		КонецЕсли;
		Объект = Справочники.Контрагенты.СоздатьЭлемент();
		Объект.Заполнить(Неопределено);
		Объект.Наименование = Поля[1];
		Объект.НаименованиеПолное = Поля[2];
		Объект.ИНН = Поля[3];
		Объект.КПП = Поля[4];
		Объект.ЮридическоеФизическоеЛицо = ?(Поля[6] = "ЮЛ", Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо,
			Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо);
		Если Поля[6] = "ИП" Тогда
			ЗаполнитьЗначенияСвойств(Объект, Новый Структура("ИндивидуальныйПредприниматель", Истина));
		КонецЕсли;
		Объект.СтранаРегистрации = Справочники.СтраныМира.Россия;
		Объект.Записать();
		Контрагенты.Вставить(Поля[0], Объект.Ссылка);
		Если Поля[5] = "поставщик" Тогда
			Договор(Д, Объект.Ссылка, Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком, "Основной договор");
		ИначеЕсли Поля[5] = "покупатель2" Тогда
			Договор(Д, Объект.Ссылка, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем, "Договор поставки № 12");
			Договор(Д, Объект.Ссылка, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем, "Договор на обслуживание № 7");
		Иначе
			Договор(Д, Объект.Ссылка, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем, "Основной договор");
		КонецЕсли;
	КонецЦикла;
	Д.Вставить("Контрагенты", Контрагенты);

	Штука = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	Если Не ЗначениеЗаполнено(Штука) Тогда
		Объект = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
		Объект.Код = "796";
		Объект.Наименование = "шт";
		Объект.НаименованиеПолное = "Штука";
		Объект.Записать();
		Штука = Объект.Ссылка;
	КонецЕсли;

	// Ключ, наименование, услуга, цена закупки, цена продажи.
	Номенклатура = Новый Соответствие;
	Цены = Новый Соответствие;
	Для Каждого Строка Из СтрРазделить(
		"фн|Фискальный накопитель ФН-1.2 36 мес.|0|8000|11500;"
		+ "касса|Онлайн-касса «Меркурий-185Ф»|0|14000|19900;"
		+ "сканер|Сканер штрихкодов 2D проводной|0|2500|3900;"
		+ "прошивка|Услуга по обновлению прошивки ККТ|1|0|3000;"
		+ "регистрация|Регистрация ККТ в ФНС|1|0|2500;"
		+ "обслуживание|Техническое обслуживание ККТ (месяц)|1|0|1800", ";") Цикл
		Поля = СтрРазделить(Строка, "|");
		Услуга = (Поля[2] = "1");
		Если ТолькоНайти Тогда
			Номенклатура.Вставить(Поля[0], Справочники.Номенклатура.НайтиПоНаименованию(Поля[1], Истина));
			Цены.Вставить(Поля[0], Новый Структура("Закупка, Продажа", Число(Поля[3]), Число(Поля[4])));
			Продолжить;
		КонецЕсли;
		Объект = Справочники.Номенклатура.СоздатьЭлемент();
		Объект.Заполнить(Неопределено);
		Объект.Наименование = Поля[1];
		Объект.НаименованиеПолное = Поля[1];
		Объект.Услуга = Услуга;
		Объект.ЕдиницаИзмерения = Штука;
		Объект.ВидНоменклатуры = ВидНоменклатуры(Услуга);
		Объект.Записать();
		Номенклатура.Вставить(Поля[0], Объект.Ссылка);
		Цены.Вставить(Поля[0], Новый Структура("Закупка, Продажа", Число(Поля[3]), Число(Поля[4])));
	КонецЦикла;
	Д.Вставить("Номенклатура", Номенклатура);
	Д.Вставить("Цены", Цены);
	Д.Лог.Добавить("Справочники: контрагентов " + Контрагенты.Количество() + ", номенклатуры " + Номенклатура.Количество());

КонецПроцедуры

&НаСервереБезКонтекста
Процедура Договор(Д, Контрагент, ВидДоговора, Наименование)

	Объект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Объект.Заполнить(Новый Структура("Владелец, Организация, ВидДоговора", Контрагент, Д.Организация, ВидДоговора));
	Объект.Владелец = Контрагент;
	Объект.Организация = Д.Организация;
	Объект.ВидДоговора = ВидДоговора;
	Объект.Наименование = Наименование;
	Объект.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчета.Получить();
	Объект.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВидНоменклатуры(Услуга)

	Имя = ?(Услуга, "Услуги", "Товары");
	Ссылка = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
	Объект.Наименование = Имя;
	ЗаполнитьЗначенияСвойств(Объект, Новый Структура("Услуга", Услуга));
	Объект.Записать();
	Возврат Объект.Ссылка;

