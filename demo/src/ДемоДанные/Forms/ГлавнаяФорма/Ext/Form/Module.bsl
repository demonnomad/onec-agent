Процедура НачальныеОстатки(Д)

	Объект = Документы.ОперацияБух.СоздатьДокумент();
	Объект.Дата = Дата(2026, 6, 30, 23, 0, 0);
	Объект.Организация = Д.Организация;
	Объект.Содержание = "Остатки денежных средств на 30.06.2026";
	Объект.СуммаОперации = 1520000;
	Объект.Записать();
	Набор = Объект.Движения.Хозрасчетный;
	Набор.Отбор.Регистратор.Установить(Объект.Ссылка);
	Проводка(Набор, Объект, ПланыСчетов.Хозрасчетный.РасчетныеСчета, 1500000, Д.Счет);
	Проводка(Набор, Объект, ПланыСчетов.Хозрасчетный.КассаОрганизации, 20000, Неопределено);
	Набор.Записать();
	Д.Лог.Добавить("Начальные остатки: 51 — 1 500 000, 50 — 20 000");

