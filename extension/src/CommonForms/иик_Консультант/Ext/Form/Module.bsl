// Окно ИИ-консультанта.
//
// Интерфейс чата — веб-страница сервера агента, загруженная в поле HTML.
// Форма служит мостом: забирает со страницы вызовы инструментов, выполняет
// их через иик_Инструменты и возвращает результат.
//
// Мост устроен только на строках и кликах в DOM (см. ui.js): веб-клиент 1С
// падает целиком — мимо Попытка — на обращении к window страницы и вызове
// JS-функций, а чтение .value и .click() работают и в веб-, и в тонком клиенте.
//
// Действия, меняющие что-либо у пользователя, подтверждаются здесь, нативным
// диалогом 1С — страница с сервера подтвердить их сама не может.

#Область ОписаниеПеременных

&НаКлиенте
Перем МостГотов;

&НаКлиенте
Перем ИдетВыполнение;

&НаКлиенте
Перем СкриптПодключен;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресСервераАгента = иик_Инструменты.АдресСервера();
	КонтекстJSON = иик_Инструменты.КонтекстБазыJSON();
	// Выбор модели (в т.ч. облачного API — данные базы уходят провайдеру) — только администратору.
	Элементы.ФормаНастройкиМодели.Видимость = ПравоДоступа("Администрирование", Метаданные);
	ЗагрузитьСтраницу();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	МостГотов = Ложь;
	ИдетВыполнение = Ложь;
	СкриптПодключен = Ложь;

	#Если ВебКлиент Тогда
	Клиент = "веб-клиент";
	#Иначе
	Клиент = "тонкий клиент";
	#КонецЕсли
	КонтекстJSON = СтрЗаменить(КонтекстJSON, "__CLIENT__", Клиент);

	// В веб-клиенте интервал обработчика ожидания не меньше секунды.
	ПодключитьОбработчикОжидания("ОпросМоста", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ОпросМоста");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Сигнал страницы «в #bridge-out новый вызов» — клик по скрытой #bridge-ping. Забираем вызов
// сразу, не дожидаясь таймера: в скрытой вкладке браузер тормозит его до минуты.
&НаКлиенте
Процедура ПолеЧатПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Попытка
		Ид = ДанныеСобытия.Element.id;
	Исключение
		Ид = "";
	КонецПопытки;
	Если Ид = "bridge-ping" Тогда
		СтандартнаяОбработка = Ложь;
		ОпросМоста();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НовыйДиалог(Команда)

	ОтправитьНаСтраницу("reset", "");

КонецПроцедуры

// Окно настроек рисует страница чата: проверить подключение к модели и сохранить профиль
// может только сервер агента, к которому у страницы есть соединение (у сервера 1С в безопасном режиме — нет).
&НаКлиенте
Процедура НастройкиМодели(Команда)

	ОтправитьНаСтраницу("settings", "");

КонецПроцедуры

&НаКлиенте
Процедура АдресСервера(Команда)

	Оповещение = Новый ОписаниеОповещения("АдресСервераЗавершение", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, АдресСервераАгента, "Адрес сервера ИИ-консультанта", 200, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура АдресСервераЗавершение(Строка, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат;
	КонецЕсли;
	СохранитьАдресСервера(СокрЛП(Строка));
	МостГотов = Ложь;
	СкриптПодключен = Ложь;
	Оповещение = Новый ОписаниеОповещения("ТокенСервераЗавершение", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, "", "Токен доступа (файл server/data/token на сервере консультанта; "
		+ "пусто — оставить прежний)", 200, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ТокенСервераЗавершение(Строка, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат;
	КонецЕсли;
	СохранитьТокенСервера(СокрЛП(Строка));
	#Если ВебКлиент Тогда
	КонтекстJSON = СтрЗаменить(КонтекстJSON, "__CLIENT__", "веб-клиент");
	#Иначе
	КонтекстJSON = СтрЗаменить(КонтекстJSON, "__CLIENT__", "тонкий клиент");
	#КонецЕсли
	МостГотов = Ложь;
	СкриптПодключен = Ложь;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьСтраницу()

	// Страница задаётся текстом, а не URL: тогда документ поля HTML остаётся
	// в одном источнике с 1С и код формы может обращаться к его DOM — в том
	// числе в веб-клиенте, где страница с другого адреса была бы недоступна.
	// Веб-клиент не выполняет <script> из текста поля, поэтому скрипт интерфейса
	// форма подключает сама через DOM (ДокументЧата).
	ПолеЧат = "<!DOCTYPE html><html><head><meta charset=""utf-8""></head>"
		+ "<body style=""margin:0;background:#1e1f22;color:#8b8e94;font:13px Menlo,monospace"">"
		+ "<div style=""padding:12px"">Загрузка ИИ-консультанта с " + АдресСервераАгента + "…</div>"
		+ "</body></html>";

КонецПроцедуры

&НаСервере
Процедура СохранитьТокенСервера(Токен)

	иик_Инструменты.СохранитьТокенСервера(Токен);
	КонтекстJSON = иик_Инструменты.КонтекстБазыJSON();
	ЗагрузитьСтраницу();

КонецПроцедуры

&НаСервере
Процедура СохранитьАдресСервера(Адрес)

	иик_Инструменты.СохранитьАдресСервера(Адрес);
	АдресСервераАгента = Адрес;
	ЗагрузитьСтраницу();

КонецПроцедуры

// Документ страницы чата — только когда её скрипт загружен (метка в title).
// Пока не загружен, подключает скрипт и возвращает Неопределено.
&НаКлиенте
Функция ДокументЧата()

	Попытка
		Документ = Элементы.ПолеЧат.Документ;
		Если Документ = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Документ.title = "onec-agent-ready" Тогда
			Возврат Документ;
		КонецЕсли;
		Если Не СкриптПодключен И Документ.readyState = "complete" Тогда
			Скрипт = Документ.createElement("script");
			Скрипт.src = АдресСервераАгента + "/ui.js";
			Документ.body.appendChild(Скрипт);
			СкриптПодключен = Истина;
		КонецЕсли;
		Возврат Неопределено;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Передаёт странице сообщение: "вид\nданные" в #bridge-in и клик по #bridge-btn.
&НаКлиенте
Функция ОтправитьНаСтраницу(Вид, Данные)

	Документ = ДокументЧата();
	Если Документ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Документ.getElementById("bridge-in").value = Вид + Символы.ПС + Данные;
	Документ.getElementById("bridge-btn").click();
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ОпросМоста() Экспорт

	Если ИдетВыполнение Тогда
		Возврат;
	КонецЕсли;

	Документ = ДокументЧата();
	Если Документ = Неопределено Тогда
		МостГотов = Ложь;
		Возврат;
	КонецЕсли;

	Если Не МостГотов Тогда
		МостГотов = ОтправитьНаСтраницу("hello", КонтекстJSON);
	КонецЕсли;

	Выход = Документ.getElementById("bridge-out");
	ТекстВызова = Выход.value;
	Если Не ЗначениеЗаполнено(ТекстВызова) Тогда
		Возврат;
	КонецЕсли;
	Выход.value = "";
	ОбработатьВызов(ТекстВызова);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВызов(ТекстВызова)

	Вызов = иик_Инструменты.ЗаголовокВызова(ТекстВызова);
	Имя = Вызов.Имя;
	Ид = Вызов.Ид;

	Если Имя = "open_object" Тогда
		// Кнопка «Посмотреть» на карточке в чате: пользователь нажал её сам, а открытие формы
		// ничего не меняет — подтверждение не нужно, права на просмотр проверит 1С.
		Попытка
			ПоказатьЗначение(, иик_Инструменты.СсылкаИзВызова(ТекстВызова));
			Ответ = иик_Инструменты.ОтветJSON(Ид, Истина, "открыто", , "открыто");
		Исключение
			Ответ = иик_Инструменты.ОтветJSON(Ид, Ложь, , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		ОтправитьНаСтраницу("result", Ответ);
		Возврат;
	КонецЕсли;

	Если Имя = "open_list" Тогда
		// Открытие списка ничего не меняет — без подтверждения.
		Попытка
			Список = иик_Инструменты.ПараметрыСписка(ТекстВызова);
			ОткрытьФорму(Список.ИмяФормы, Новый Структура("Отбор", Список.Отбор));
			Ответ = иик_Инструменты.ОтветJSON(Ид, Истина, "Открыт список «" + Список.Представление + "»", ,
				"открыт список");
		Исключение
			Ответ = иик_Инструменты.ОтветJSON(Ид, Ложь, , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		ОтправитьНаСтраницу("result", Ответ);
		Возврат;
	КонецЕсли;

	Если Имя = "document_post" Или Имя = "document_unpost" Тогда
		// Меняет учёт — только после согласия пользователя в нативном окне.
		ИдетВыполнение = Истина;
		ДопПараметры = Новый Структура("Ид, ТекстВызова, Провести", Ид, ТекстВызова, Имя = "document_post");
		Оповещение = Новый ОписаниеОповещения("ПроведениеПодтверждено", ЭтотОбъект, ДопПараметры);
		Текст = ?(ДопПараметры.Провести, "Провести документ?", "Отменить проведение документа?") + Символы.ПС
			+ Вызов.Заголовок;
		// По умолчанию «Нет»: случайный Enter не должен менять учёт.
		ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "ИИ-консультант");
		Возврат;
	КонецЕсли;

	Если Имя = "object_update" Тогда
		ИзменитьПослеСогласия(Ид, ТекстВызова);
		Возврат;
	КонецЕсли;

	Если Имя = "invoice_create" Или Имя = "object_create" Или Имя = "sale_create" Или Имя = "purchase_create"
		Или Имя = "create_based_on" Тогда
		СоздатьИСпросить(Ид, Имя, ТекстВызова);
		Возврат;
	КонецЕсли;

	Если Имя = "ui_open" Тогда
		// Действие на стороне пользователя — только после его согласия.
		ИдетВыполнение = Истина;
		// Не «Параметры»: в модуле формы это свойство формы, только для чтения.
		ДопПараметры = Новый Структура("Ид, ТекстВызова", Ид, ТекстВызова);
		Оповещение = Новый ОписаниеОповещения("ОткрытиеФормыПодтверждено", ЭтотОбъект, ДопПараметры);
		Текст = "ИИ-консультант хочет открыть: " + Вызов.Заголовок + Символы.ПС + "Разрешить?";
		ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "ИИ-консультант");
		Возврат;
	КонецЕсли;

	ИдетВыполнение = Истина;
	Попытка
		Ответ = иик_Инструменты.ВыполнитьВызов(ТекстВызова);
	Исключение
		Ответ = иик_Инструменты.ОтветJSON(Ид, Ложь, , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ИдетВыполнение = Ложь;
	ОтправитьНаСтраницу("result", Ответ);

КонецПроцедуры

// Объект создаётся сразу (документ — черновиком, без проведения), затем пользователь
// решает, что с ним делать: документ — посмотреть / провести / оставить,
// элемент справочника — посмотреть / оставить / отменить (пометка на удаление).
&НаКлиенте
Процедура СоздатьИСпросить(Ид, Имя, ТекстВызова)

	ИдетВыполнение = Истина;
	Попытка
		Если Имя = "invoice_create" Тогда
			Черновик = иик_Инструменты.СоздатьЧерновикСчета(ТекстВызова);
		ИначеЕсли Имя = "sale_create" Тогда
			Черновик = иик_Инструменты.СоздатьЧерновикТоварногоДокумента(ТекстВызова, "sale");
		ИначеЕсли Имя = "purchase_create" Тогда
			Черновик = иик_Инструменты.СоздатьЧерновикТоварногоДокумента(ТекстВызова, "purchase");
		ИначеЕсли Имя = "create_based_on" Тогда
			Черновик = иик_Инструменты.СоздатьНаОсновании(ТекстВызова);
		Иначе
			Черновик = иик_Инструменты.СоздатьОбъект(ТекстВызова);
		КонецЕсли;
	Исключение
		ИдетВыполнение = Ложь;
		ОтправитьНаСтраницу("result", иик_Инструменты.ОтветJSON(Ид, Ложь, ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("view", "Посмотреть");
	Если Черновик.ЭтоДокумент Тогда
		Кнопки.Добавить("post", "Провести без проверки");
		Кнопки.Добавить("keep", "Оставить черновик");
		ТекстЗаголовка = "Создан черновик (не проведён):";
	Иначе
		Кнопки.Добавить("keep", "Оставить");
		Кнопки.Добавить("undo", "Отменить");
		ТекстЗаголовка = "Создан элемент справочника:";
	КонецЕсли;
	ДопПараметры = Новый Структура("Ид, Ссылка, ЭтоДокумент", Ид, Черновик.Ссылка, Черновик.ЭтоДокумент);
	Оповещение = Новый ОписаниеОповещения("ДействиеСЧерновикомВыбрано", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(Оповещение, ТекстЗаголовка + Символы.ПС + Символы.ПС + Черновик.Описание,
		Кнопки, , "view", "ИИ-консультант");

КонецПроцедуры

// Изменение существующего объекта: окно с «было → станет», по умолчанию «Нет».
&НаКлиенте
Процедура ИзменитьПослеСогласия(Ид, ТекстВызова)

	Попытка
		Изменение = иик_Инструменты.ПодготовитьИзменение(ТекстВызова);
	Исключение
		ОтправитьНаСтраницу("result", иик_Инструменты.ОтветJSON(Ид, Ложь, , КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;
	ИдетВыполнение = Истина;
	ДопПараметры = Новый Структура("Ид, ТекстВызова, Ссылка, ВерсияДанных", Ид, ТекстВызова, Изменение.Ссылка,
		Изменение.ВерсияДанных);
	Оповещение = Новый ОписаниеОповещения("ИзменениеПодтверждено", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(Оповещение, "Изменить?" + Символы.ПС + Изменение.Описание, РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет, "ИИ-консультант");

КонецПроцедуры

&НаКлиенте
Процедура ИзменениеПодтверждено(РезультатВопроса, ДопПараметры) Экспорт

	ИдетВыполнение = Ложь;
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		ОтправитьНаСтраницу("result", иик_Инструменты.ОтветJSON(ДопПараметры.Ид, Ложь, , "Пользователь отклонил изменение"));
		Возврат;
	КонецЕсли;
	Попытка
		Итог = иик_Инструменты.ПрименитьИзменение(ДопПараметры.ТекстВызова, ДопПараметры.ВерсияДанных);
		Ответ = иик_Инструменты.ОтветДействияJSON(ДопПараметры.Ид, ДопПараметры.Ссылка, Итог.Текст, Итог.Успех);
	Исключение
		Ответ = иик_Инструменты.ОтветJSON(ДопПараметры.Ид, Ложь, , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ОтправитьНаСтраницу("result", Ответ);

КонецПроцедуры

&НаКлиенте
Процедура ДействиеСЧерновикомВыбрано(Выбор, ДопПараметры) Экспорт

	ИдетВыполнение = Ложь;
	Если Выбор = "view" Тогда
		ПоказатьЗначение(, ДопПараметры.Ссылка);
		Итог = ?(ДопПараметры.ЭтоДокумент, "черновик создан", "элемент создан") + ", пользователь открыл его для проверки";
	ИначеЕсли Выбор = "post" Тогда
		Проведение = иик_Инструменты.ПровестиДокумент(ДопПараметры.Ссылка);
		Итог = "черновик создан; " + Проведение.Текст;
		ОтправитьНаСтраницу("result", иик_Инструменты.ОтветДействияJSON(ДопПараметры.Ид, ДопПараметры.Ссылка, Итог,
			Проведение.Успех));
		Возврат;
	ИначеЕсли Выбор = "undo" Тогда
		иик_Инструменты.ПометитьНаУдаление(ДопПараметры.Ссылка);
		Итог = "пользователь отменил создание: элемент помечен на удаление";
	ИначеЕсли ДопПараметры.ЭтоДокумент Тогда
		Итог = "черновик создан и оставлен без проведения";
	Иначе
		Итог = "элемент справочника создан";
	КонецЕсли;
	ОтправитьНаСтраницу("result", иик_Инструменты.ОтветДействияJSON(ДопПараметры.Ид, ДопПараметры.Ссылка, Итог));

КонецПроцедуры

