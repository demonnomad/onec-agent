КонецПроцедуры

// Приводит значение 1С к виду, который понимает JSON и модель.
// Ссылки — {"_ref", "uuid", "repr"}: модель может передать их обратно в другие инструменты.
Функция ЗначениеДляJSON(Значение)

	Т = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	ИначеЕсли Т = Тип("Строка") Или Т = Тип("Число") Или Т = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли Т = Тип("Дата") Тогда
		Возврат ?(Значение = Дата(1, 1, 1), Неопределено, Значение);
	ИначеЕсли Т = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	ИначеЕсли Т = Тип("ХранилищеЗначения") Тогда
		Возврат "<ХранилищеЗначения>";
	КонецЕсли;

	МД = Метаданные.НайтиПоТипу(Т);
	Если МД <> Неопределено Тогда
		Если Метаданные.Перечисления.Содержит(МД) Тогда
			Возврат Строка(Значение);
		КонецЕсли;
		Попытка
			Если Значение.Пустая() Тогда
				Возврат Неопределено;
			КонецЕсли;
			Результат = Новый Соответствие;
			Результат.Вставить("_ref", МД.ПолноеИмя());
			Результат.Вставить("uuid", Строка(Значение.УникальныйИдентификатор()));
			Результат.Вставить("repr", Строка(Значение));
			Возврат Результат;
		Исключение
			Возврат Строка(Значение);
		КонецПопытки;
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Обратное преобразование для параметров запросов: ссылки, даты ISO, массивы.
Функция ЗначениеИзJSON(Значение)

	Т = ТипЗнч(Значение);
	Если Т = Тип("Соответствие") И Значение.Получить("_ref") <> Неопределено Тогда
		Возврат СсылкаИзJSON(Значение);
	ИначеЕсли Т = Тип("Массив") Тогда
		Массив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Массив.Добавить(ЗначениеИзJSON(Элемент));
		КонецЦикла;
		Возврат Массив;
	ИначеЕсли Т = Тип("Строка") И ПохожеНаДату(Значение) Тогда
		Попытка
			Возврат XMLЗначение(Тип("Дата"), ?(СтрДлина(Значение) = 10, Значение + "T00:00:00", Лев(Значение, 19)));
		Исключение
			Возврат Значение;
		КонецПопытки;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ПохожеНаДату(Текст)

	Если СтрДлина(Текст) <> 10 И СтрДлина(Текст) < 19 Тогда
		Возврат Ложь;
	КонецЕсли;
	Шаблон = "0000-00-00";
	Для Позиция = 1 По 10 Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Сред(Шаблон, Позиция, 1) = "-" Тогда
			Если Символ <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция СсылкаИзJSON(Описание)

	Если ТипЗнч(Описание) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Ожидалась ссылка вида {""_ref"": ""Документ.Имя"", ""uuid"": ""…""}";
	КонецЕсли;
	ПолноеИмя = Описание.Получить("_ref");
	МД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МД = Неопределено Тогда
		ВызватьИсключение "Нет объекта метаданных " + ПолноеИмя;
	КонецЕсли;
	Возврат МенеджерОбъекта(МД).ПолучитьСсылку(Новый УникальныйИдентификатор(Описание.Получить("uuid")));

КонецФункции

Функция МенеджерОбъекта(МД)

	Если Метаданные.Документы.Содержит(МД) Тогда
		Возврат Документы[МД.Имя];
	ИначеЕсли Метаданные.Справочники.Содержит(МД) Тогда
		Возврат Справочники[МД.Имя];
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МД) Тогда
		Возврат ПланыВидовХарактеристик[МД.Имя];
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(МД) Тогда
		Возврат ПланыСчетов[МД.Имя];
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(МД) Тогда
		Возврат ПланыВидовРасчета[МД.Имя];
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(МД) Тогда
		Возврат ПланыОбмена[МД.Имя];
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(МД) Тогда
		Возврат БизнесПроцессы[МД.Имя];
	ИначеЕсли Метаданные.Задачи.Содержит(МД) Тогда
		Возврат Задачи[МД.Имя];
	КонецЕсли;
	ВызватьИсключение "Для " + МД.ПолноеИмя() + " ссылки не поддерживаются";

