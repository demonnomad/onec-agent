КонецФункции

// Тексты ошибок регламентной операции: типовая хранит их табличным документом в ОписаниеОшибок.
Функция ОшибкиРегламентнойОперации(Ссылка)

	Тексты = Новый Массив;
	Попытка
		Описание = Ссылка.ОписаниеОшибок;
		Если ТипЗнч(Описание) = Тип("ХранилищеЗначения") Тогда
			Описание = Описание.Получить();
		КонецЕсли;
		Если ТипЗнч(Описание) = Тип("ТабличныйДокумент") Тогда
			Для НомерСтроки = 1 По Описание.ВысотаТаблицы Цикл
				Для НомерКолонки = 1 По Описание.ШиринаТаблицы Цикл
					Текст = СокрЛП(Описание.Область(НомерСтроки, НомерКолонки).Текст);
					Если Текст <> "" И Тексты.Найти(Текст) = Неопределено И Тексты.Количество() < 30 Тогда
						Тексты.Добавить(Лев(Текст, 400));
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		ИначеЕсли ТипЗнч(Описание) = Тип("Строка") И СокрЛП(Описание) <> "" Тогда
			Тексты.Добавить(Лев(Описание, 2000));
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если Тексты.Количество() = 0 Тогда
		Для Каждого Строка Из Ссылка.УдалитьОшибки Цикл
			Тексты.Добавить(Лев(Строка.Описание, 400));
		КонецЦикла;
	КонецЕсли;
	Возврат Тексты;

КонецФункции

Функция ОписаниеСтатуса(Период, Организация, Таблица, Сводка)

	Операции = Новый Массив;
	СОшибками = 0;
	НеВыполнено = 0;
	Устарело = 0;
	Для Каждого Строка Из Таблица Цикл
		Если Не Строка.Требуется И Не ЗначениеЗаполнено(Строка.Ссылка) Тогда
			Продолжить; // операция этой организации в этом месяце не нужна
		КонецЕсли;
		Операция = Новый Соответствие;
		Операция.Вставить("operation", Строка(Строка.ВидОперации));
		Операция.Вставить("kind", XMLСтрока(Строка.ВидОперации));
		Операция.Вставить("group", Строка.НомерГруппы);
		Операция.Вставить("required", Строка.Требуется);
		Операция.Вставить("state", Строка(Строка.Состояние));
		Если Строка.Устарела Тогда
			Операция.Вставить("outdated", Истина);
			Устарело = Устарело + 1;
		КонецЕсли;
		Если Строка.РучнаяКорректировка Тогда
			Операция.Вставить("manual", Истина);
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.Ссылка) Тогда
			Операция.Вставить("ref", ЗначениеДляJSON(Строка.Ссылка));
			Если Строка.Состояние = Перечисления.ВидыСостоянийРегламентныхОпераций.ВыполненоСОшибками Тогда
				Операция.Вставить("errors", ОшибкиРегламентнойОперации(Строка.Ссылка));
			КонецЕсли;
		КонецЕсли;
		Если Строка.Состояние = Перечисления.ВидыСостоянийРегламентныхОпераций.ВыполненоСОшибками Тогда
			СОшибками = СОшибками + 1;
		ИначеЕсли Строка.Требуется И Строка.Состояние = Перечисления.ВидыСостоянийРегламентныхОпераций.НеВыполнено Тогда
			НеВыполнено = НеВыполнено + 1;
		КонецЕсли;
		Операции.Добавить(Операция);
	КонецЦикла;

	Закрыт = Обработки.ЗакрытиеМесяца.Выполнено(Организация, Период);
	КПерепроведению = ДокументовКПерепроведению(Организация, Период);
	Ответ = Новый Соответствие;
	Ответ.Вставить("period", Формат(Период, "ДФ='MMMM yyyy'"));
	Ответ.Вставить("organization", Строка(Организация));
	Ответ.Вставить("closed", Закрыт);
	Ответ.Вставить("documents_to_repost", КПерепроведению);
	Момент = МоментНарушенияПоследовательности(Организация, Период);
	Если Момент <> Неопределено Тогда
		Ответ.Вставить("sequence_broken", ОписаниеНарушения(Момент));
	КонецЕсли;
	Ответ.Вставить("operations", Операции);
	Ответ.Вставить("note", "state: Выполнено / Не выполнено / Выполнено с ошибками / Пропущено; outdated — после операции "
		+ "правили документы, её нужно выполнить заново; documents_to_repost > 0 — сначала перепроведение (month_close_run сделает его сам)");
	Сводка = ?(Закрыт, "месяц закрыт", "месяц не закрыт") + ": операций " + Операции.Количество()
		+ ", не выполнено " + НеВыполнено + ", с ошибками " + СОшибками + ", устарело " + Устарело
		+ ?(КПерепроведению > 0, ", к перепроведению документов: " + КПерепроведению, "")
		+ ?(Момент <> Неопределено, ", нарушена последовательность с " + Формат(Момент.Дата, "ДЛФ=D"), "");
	Возврат Ответ;

КонецФункции

Функция СтатусЗакрытияМесяца(Аргументы, Сводка)

	Период = ПериодЗакрытия(Аргументы);
	Организация = ОрганизацияЗакрытия(Аргументы);
	Возврат ОписаниеСтатуса(Период, Организация, ТаблицаСтатусаЗакрытия(Период, Организация), Сводка);

КонецФункции

// Что мешает закрыть месяц: непроведённые документы, отрицательные остатки запасов, деньги в пути,
// НДС не к вычету, документы к перепроведению, операции с ошибками.
Функция ПроверкаГотовностиКЗакрытию(Аргументы, Сводка)

	Период = ПериодЗакрытия(Аргументы);
	Организация = ОрганизацияЗакрытия(Аргументы);
	Начало = Период;
	Конец = КонецМесяца(Период);
	Проблемы = Новый Массив;

	// 1. Непроведённые документы периода — по основным видам, у которых есть Организация.
	Виды = СтрРазделить("РеализацияТоваровУслуг,ПоступлениеТоваровУслуг,СчетФактураВыданный,СчетФактураПолученный,"
		+ "ПоступлениеНаРасчетныйСчет,СписаниеСРасчетногоСчета,ПриходныйКассовыйОрдер,РасходныйКассовыйОрдер,"
		+ "АвансовыйОтчет,ОперацияБух,НачислениеЗарплаты,ТребованиеНакладная,ОтчетПроизводстваЗаСмену,"
		+ "ПринятиеКУчетуОС,ПоступлениеДопРасходов,КорректировкаДолга,СписаниеТоваров,ОприходованиеТоваров", ",");
	Непроведённые = Новый Массив;
	ВсегоНепроведённых = 0;
	Для Каждого ИмяВида Из Виды Цикл
		МД = Метаданные.Документы.Найти(ИмяВида);
		Если МД = Неопределено Или МД.Реквизиты.Найти("Организация") = Неопределено
			Или МД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
			Продолжить; // операции вручную не проводятся — непроведённость для них норма
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 6 Т.Ссылка КАК Ссылка ИЗ " + МД.ПолноеИмя() + " КАК Т
			|ГДЕ Т.Дата МЕЖДУ &Начало И &Конец И НЕ Т.Проведен И НЕ Т.ПометкаУдаления И Т.Организация = &Организация
			|УПОРЯДОЧИТЬ ПО Т.Дата");
		Запрос.УстановитьПараметр("Начало", Начало);
		Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
		Запрос.УстановитьПараметр("Организация", Организация);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ВсегоНепроведённых = ВсегоНепроведённых + 1;
			Если Непроведённые.Количество() < 20 Тогда
				Непроведённые.Добавить(ЗначениеДляJSON(Выборка.Ссылка));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ВсегоНепроведённых > 0 Тогда
		Проблема = Новый Соответствие;
		Проблема.Вставить("problem", "Непроведённые документы периода: " + ВсегоНепроведённых
			+ " — они не попадут в учёт; проведите или пометьте на удаление (posting_check покажет, почему не проводится)");
		Проблема.Вставить("documents", Непроведённые);
		Проблемы.Добавить(Проблема);
	КонецЕсли;

	// 2. Отрицательные остатки запасов и затрат на конец месяца.
	Счета = Новый Массив;
	Для Каждого Код Из СтрРазделить("10,41,43,20,21,23,44,50,51", ",") Цикл
		Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Счет) Тогда
			Счета.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 20 Т.Счет.Код КАК Счет, ПРЕДСТАВЛЕНИЕ(Т.Субконто1) КАК Субконто,
		|	Т.КоличествоОстаток КАК Количество, Т.СуммаОстаток КАК Сумма
		|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Конец, Счет В ИЕРАРХИИ (&Счета), , Организация = &Организация) КАК Т
		|ГДЕ Т.КоличествоОстаток < 0 ИЛИ (Т.СуммаОстаток < 0 И Т.Счет.Код <> ""20"" И Т.Счет.Код <> ""23"")
		|УПОРЯДОЧИТЬ ПО Т.Счет.Код");
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("Организация", Организация);
	Отрицательные = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отрицательные.Добавить(СтрШаблон("%1 · %2: количество %3, сумма %4", Выборка.Счет, Выборка.Субконто,
			Формат(Выборка.Количество, "ЧГ=0"), Формат(Выборка.Сумма, "ЧДЦ=2; ЧГ=0")));
	КонецЦикла;
	Если Отрицательные.Количество() > 0 Тогда
		Проблема = Новый Соответствие;
		Проблема.Вставить("problem", "Отрицательные остатки на конец месяца — списано больше, чем было (нет поступления, "
			+ "неверная дата или склад): " + Отрицательные.Количество());
		Проблема.Вставить("balances", Отрицательные);
		Проблемы.Добавить(Проблема);
	КонецЕсли;

	// 3. Деньги в пути (57) и НДС, не принятый к вычету (19), на конец месяца.
	Для Каждого Пара Из СтрРазделить("57|Деньги в пути не разнесены: сальдо 57 на конец месяца;"
		+ "19|НДС по приобретённым ценностям не принят к вычету (сальдо 19) — проверьте счета-фактуры полученные", ";") Цикл
		Код = Лев(Пара, СтрНайти(Пара, "|") - 1);
		Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(Код);
		Если Не ЗначениеЗаполнено(Счет) Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ СУММА(Т.СуммаОстатокДт) КАК Дт, СУММА(Т.СуммаОстатокКт) КАК Кт
			|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Конец, Счет В ИЕРАРХИИ (&Счет), , Организация = &Организация) КАК Т");
		Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
		Запрос.УстановитьПараметр("Счет", Счет);
		Запрос.УстановитьПараметр("Организация", Организация);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И (Выборка.Дт <> 0 И Выборка.Дт <> NULL Или Выборка.Кт <> 0 И Выборка.Кт <> NULL) Тогда
			Проблема = Новый Соответствие;
			Проблема.Вставить("problem", Сред(Пара, СтрНайти(Пара, "|") + 1));
			Проблема.Вставить("balance_dt", ?(Выборка.Дт = NULL, 0, Выборка.Дт));
			Проблема.Вставить("balance_kt", ?(Выборка.Кт = NULL, 0, Выборка.Кт));
			Проблема.Вставить("severity", ?(Код = "19", "предупреждение", "ошибка"));
			Проблемы.Добавить(Проблема);
		КонецЕсли;
	КонецЦикла;

	// 4. Состояние регламентных операций.
	Статус = ТаблицаСтатусаЗакрытия(Период, Организация);
	КПерепроведению = ДокументовКПерепроведению(Организация, Период);
	Если КПерепроведению > 0 Тогда
		Проблема = Новый Соответствие;
		Проблема.Вставить("problem", "Документов к перепроведению: " + КПерепроведению
			+ " — после закрытия меняли документы; month_close_run перепроведёт их сам");
		Проблемы.Добавить(Проблема);
	КонецЕсли;
	Момент = МоментНарушенияПоследовательности(Организация, Период);
	Если Момент <> Неопределено Тогда
		Проблема = Новый Соответствие;
		Проблема.Вставить("problem", "Нарушена последовательность проведения с " + Формат(Момент.Дата, "ДЛФ=D")
			+ " (" + Строка(Момент.Ссылка) + " записан задним числом) — документы после него нужно перепровести; "
			+ "month_close_run сделает это сам");
		Проблема.Вставить("sequence_broken", ОписаниеНарушения(Момент));
		Проблемы.Добавить(Проблема);
	КонецЕсли;
	Для Каждого Строка Из Статус Цикл
		Если Строка.Состояние = Перечисления.ВидыСостоянийРегламентныхОпераций.ВыполненоСОшибками Тогда
			Проблема = Новый Соответствие;
			Проблема.Вставить("problem", "Регламентная операция с ошибками: " + Строка(Строка.ВидОперации));
			Проблема.Вставить("errors", ОшибкиРегламентнойОперации(Строка.Ссылка));
			Проблема.Вставить("ref", ЗначениеДляJSON(Строка.Ссылка));
			Проблемы.Добавить(Проблема);
		ИначеЕсли Строка.Требуется И Строка.Устарела Тогда
			Проблема = Новый Соответствие;
			Проблема.Вставить("problem", "Операция устарела (после неё правили документы), нужно выполнить заново: " + Строка(Строка.ВидОперации));
			Проблемы.Добавить(Проблема);
		КонецЕсли;
	КонецЦикла;

	Ответ = Новый Соответствие;
	Ответ.Вставить("period", Формат(Период, "ДФ='MMMM yyyy'"));
	Ответ.Вставить("organization", Строка(Организация));
	Ответ.Вставить("closed", Обработки.ЗакрытиеМесяца.Выполнено(Организация, Период));
	Ответ.Вставить("problems", Проблемы);
	Ответ.Вставить("ready", Проблемы.Количество() = 0);
	Сводка = ?(Проблемы.Количество() = 0, "препятствий не найдено", "проблем: " + Проблемы.Количество());
	Возврат Ответ;

КонецФункции

// Закрытие месяца: перепроведение при необходимости и регламентные операции по порядку.
// until — имя вида операции (kind из статуса), до которой выполнять включительно.
Функция ЗакрытьМесяц(Аргументы, Сводка) Экспорт

	Период = ПериодЗакрытия(Аргументы);
	Организация = ОрганизацияЗакрытия(Аргументы);
	Шаги = Новый Массив;

	КПерепроведению = ДокументовКПерепроведению(Организация, Период);
	Момент = МоментНарушенияПоследовательности(Организация, Период);
	Если КПерепроведению > 0 Или Момент <> Неопределено Тогда
		Попытка
			// Как форма «Закрытие месяца» → «Перепроведение документов»: без ЭтоЗакрытиеМесяца типовая
			// актуализирует только до конца дня Период, то есть первый день месяца.
			Параметры = ЗакрытиеМесяцаКлиентСервер.НовыеПараметрыАктуализации();
			Параметры.Организация = Организация;
			Параметры.Период = Период;
			Параметры.УникальныйИдентификаторФормы = Новый УникальныйИдентификатор;
			Параметры.АдресХранилищаСОшибками = ПоместитьВоВременноеХранилище(Неопределено, Параметры.УникальныйИдентификаторФормы);
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("СамостоятельнаяОперация", Истина);
			ДополнительныеПараметры.Вставить("ВидОперации", "Актуализация");
			Для Каждого Пара Из Новый Структура("АктуализироватьВесьПериод, ЭтоЗакрытиеМесяца, ЭтоИнтерактивныйЗапуск, "
				+ "АктуализацияДляРасчетаНалога, ДополнительныеПараметры", Истина, Истина, Ложь, Ложь, ДополнительныеПараметры) Цикл
				Если Параметры.Свойство(Пара.Ключ) Тогда
					Параметры[Пара.Ключ] = Пара.Значение;
				Иначе
					Параметры.Вставить(Пара.Ключ, Пара.Значение);
				КонецЕсли;
			КонецЦикла;
			Адрес = ПоместитьВоВременноеХранилище(Неопределено, Параметры.УникальныйИдентификаторФормы);
			Обработки.ЗакрытиеМесяца.АктуализироватьВФоне(Параметры, Адрес);
			Шаги.Добавить("Перепроведение документов" + ?(КПерепроведению > 0, ": " + КПерепроведению, "")
				+ ?(Момент <> Неопределено, " с " + Формат(Момент.Дата, "ДЛФ=D"), "") + " — выполнено");
			Если МоментНарушенияПоследовательности(Организация, Период) <> Неопределено Тогда
				Шаги.Добавить("Последовательность всё ещё нарушена — часть документов не перепровелась, см. ошибки");
			КонецЕсли;
		Исключение
			ВызватьИсключение "Перед закрытием нужно перепровести документы (" + КПерепроведению + "), а автоматически не вышло: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ". Сделайте это в форме «Закрытие месяца» → «Перепроведение документов»";
		КонецПопытки;
	КонецЕсли;

	Финишная = Неопределено;
	ИмяФинишной = СокрЛП(Строка(Аргументы.Получить("until")));
	Если ИмяФинишной <> "" Тогда
		Попытка
			Финишная = Перечисления.ВидыРегламентныхОпераций[ИмяФинишной];
		Исключение
			ВызватьИсключение "until: нет вида операции " + ИмяФинишной + " — возьми kind из month_close_status";
		КонецПопытки;
	КонецЕсли;

	Таблица = ТаблицаСтатусаЗакрытия(Период, Организация);
	Проверки = Обработки.ЗакрытиеМесяца.ПроверкиВозможностиВыполненияОперации();
	Результат = Обработки.ЗакрытиеМесяца.ВыполнитьЗакрытиеМесяца(Период, Организация, Таблица,
		Перечисления.ВидыСостоянийРегламентныхОпераций.Выполнено, Финишная, Ложь, Проверки, Ложь);
	Для Каждого Строка Из Результат.Операции Цикл
		Шаги.Добавить(Строка(Строка.ВидОперации) + ": " + Строка(Строка.Состояние));
	КонецЦикла;

	Ответ = ОписаниеСтатуса(Период, Организация, ТаблицаСтатусаЗакрытия(Период, Организация), Сводка);
	Ответ.Вставить("executed", Шаги);
	Если Результат.ВыполнениеОстановлено Тогда
		Ответ.Вставить("stopped", "выполнение остановлено: пользователи записывают документы периода или закрытие отменено");
	КонецЕсли;
	Сводка = "выполнено операций: " + Результат.Операции.Количество() + "; " + Сводка;
	Возврат Ответ;

КонецФункции

// Вызов из формы после согласия пользователя.
Функция ЗакрытьМесяцПоВызову(ТекстВызова) Экспорт

	Вызов = ИзJSON(ТекстВызова);
	Аргументы = Вызов.Получить("args");
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	Сводка = "";
	Попытка
		Результат = ЗакрытьМесяц(Аргументы, Сводка);
		Возврат ОтветJSON(Вызов.Получить("id"), Истина, Результат, , Сводка);
	Исключение
		Возврат ОтветJSON(Вызов.Получить("id"), Ложь, , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ИсходныйКодИБазаЗнаний

// Тексты модулей в сеансе 1С недоступны, поэтому их загружают заранее (extension/load-sources.sh)
// в регистр иик_ИсходныйКод: основная конфигурация (Источник = «Конфигурация») и расширения.
// Имена модулей — как в тексте ошибки: Документ.X.МодульОбъекта, ОбщийМодуль.X, Документ.X.Форма.Y.Форма.

Функция ПрочитатьКод(Аргументы, Сводка)

	Имя = СокрЛП(Строка(Аргументы.Получить("module")));
	НомерСтроки = ЧислоИлиНоль(Аргументы.Получить("line"));
	// Фрагмент текста ошибки: «{Документ.X.МодульОбъекта(512)}» — номер строки в скобках.
	Имя = СокрЛП(СтрЗаменить(СтрЗаменить(Имя, "{", ""), "}", ""));
	Если СтрЗаканчиваетсяНа(Имя, ")") И СтрНайти(Имя, "(") > 0 Тогда
		Позиция = СтрНайти(Имя, "(", НаправлениеПоиска.СКонца);
		НомерВИмени = ЧислоИлиНоль(Сред(Имя, Позиция + 1, СтрДлина(Имя) - Позиция - 1));
		Имя = СокрЛП(Лев(Имя, Позиция - 1));
		Если НомерСтроки = 0 Тогда
			НомерСтроки = НомерВИмени;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ Т.Источник КАК Источник, Т.Текст КАК Текст, Т.Методы КАК Методы
		|ИЗ РегистрСведений.иик_ИсходныйКод КАК Т ГДЕ Т.Модуль = &Модуль
		|УПОРЯДОЧИТЬ ПО ВЫБОР КОГДА Т.Источник = ""Конфигурация"" ТОГДА 0 ИНАЧЕ 1 КОНЕЦ, Т.Источник");
	Запрос.УстановитьПараметр("Модуль", Имя);
	Найдено = Запрос.Выполнить().Выгрузить();
	ВсеИсточники = Найдено.Скопировать();
	Источник = СокрЛП(Строка(Аргументы.Получить("source")));
	Если ЗначениеЗаполнено(Источник) И Источник <> "Неопределено" Тогда
		Для Индекс = -Найдено.Количество() + 1 По 0 Цикл
			Если НРег(Найдено[-Индекс].Источник) <> НРег(Источник) Тогда
				Найдено.Удалить(-Индекс);
			КонецЕсли;
		КонецЦикла;
		Если Найдено.Количество() = 0 И ВсеИсточники.Количество() > 0 Тогда
			ВызватьИсключение "Модуля " + Имя + " нет в источнике «" + Источник + "». Он есть в: "
				+ СтрСоединить(ВсеИсточники.ВыгрузитьКолонку("Источник"), ", ");
		КонецЕсли;
	КонецЕсли;
	Если Найдено.Количество() = 0 Тогда
		ПроверитьЗагрузкуИсходников();
		// Частая ошибка — имя объекта без вида модуля («Отчет.КнигаПродаж»): подскажем, какие модули у него есть.
		ЗапросПохожих = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 15 Т.Модуль КАК Модуль, Т.Источник КАК Источник
			|ИЗ РегистрСведений.иик_ИсходныйКод КАК Т ГДЕ Т.Модуль ПОДОБНО &Начало СПЕЦСИМВОЛ ""~"" УПОРЯДОЧИТЬ ПО Т.Модуль");
		ЗапросПохожих.УстановитьПараметр("Начало", ЭкранироватьПодобно(Имя) + ".%");
		Похожие = Новый Массив;
		Для Каждого Строка_ Из ЗапросПохожих.Выполнить().Выгрузить() Цикл
			Похожие.Добавить(Строка_.Модуль + ?(Строка_.Источник = "Конфигурация", "", " [" + Строка_.Источник + "]"));
		КонецЦикла;
		Если Похожие.Количество() > 0 Тогда
			ВызватьИсключение "«" + Имя + "» — это объект, а нужен модуль. Есть: " + СтрСоединить(Похожие, "; ");
		КонецЕсли;
		ВызватьИсключение "Модуль " + Имя + " не найден в загруженных исходниках. Примеры имён: "
			+ "Документ.РеализацияТоваровУслуг.МодульОбъекта, ОбщийМодуль.ОбщегоНазначения, "
			+ "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента.Форма. Место можно найти через code_search.";
	КонецЕсли;

	Строки = СтрРазделить(Найдено[0].Текст, Символы.ПС, Истина);
	Методы = РазобратьМетоды(Найдено[0].Методы);
	Результат = Новый Соответствие;
	Результат.Вставить("module", Имя);
	Результат.Вставить("source", Найдено[0].Источник);
	Результат.Вставить("lines_total", Строки.Количество());
	// Модуль доработан в расширении: показываем, что именно оно перехватывает, — иначе агент описывает
	// типовой код как код расширения.
	ЕщеВ = Новый Массив;
	Для Каждого Другой Из ВсеИсточники Цикл
		Если Другой.Источник = Найдено[0].Источник Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Соответствие;
		Описание.Вставить("source", Другой.Источник);
		Перехваты = Новый Массив;
		Для Каждого Метод Из РазобратьМетоды(Другой.Методы) Цикл
			Перехваты.Добавить(СтрШаблон("%1 %2%3", Метод.Вид, Метод.Имя, ?(ЗначениеЗаполнено(Метод.Аннотация), " " + Метод.Аннотация, "")));
		КонецЦикла;
		Описание.Вставить("methods", Перехваты);
		Описание.Вставить("read", СтрШаблон("code_read module=""%1"" source=""%2""", Имя, Другой.Источник));
		ЕщеВ.Добавить(Описание);
	КонецЦикла;
	Если ЕщеВ.Количество() > 0 Тогда
		Результат.Вставить("also_in", ЕщеВ);
		Результат.Вставить("note", "Показан код «" + Найдено[0].Источник + "». Этот модуль есть ещё в: "
			+ СтрСоединить(ВсеИсточники.ВыгрузитьКолонку("Источник"), ", ")
			+ ". Код расширения — только перехваты из also_in; про расширение отвечай по его коду (source).");
	КонецЕсли;
	Сводка = Имя;

	Процедура_ = СокрЛП(Строка(Аргументы.Получить("procedure")));
	Если ЗначениеЗаполнено(Процедура_) И Процедура_ <> "Неопределено" Тогда
		Цель = Неопределено;
		Для Каждого Метод Из Методы Цикл
			Если НРег(Метод.Имя) = НРег(Процедура_) Тогда
				Цель = Метод;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Цель = Неопределено Тогда
			Имена = Новый Массив;
			Для Каждого Метод Из Методы Цикл
				Если Имена.Количество() < 60 Тогда
					Имена.Добавить(Метод.Имя);
				КонецЕсли;
			КонецЦикла;
			ВызватьИсключение "В " + Имя + " нет процедуры или функции «" + Процедура_ + "». Есть: " + СтрСоединить(Имена, ", ");
		КонецЕсли;
		Первая = ЧислоИлиНоль(Аргументы.Получить("start"));
		Первая = ?(Первая > 0, Первая, Цель.Строка);
		Конец_ = Первая;
		Пока Конец_ < Строки.Количество() И Не ЭтоКонецМетода(Строки[Конец_ - 1]) Цикл
			Конец_ = Конец_ + 1;
		КонецЦикла;
		Последняя = Мин(Конец_, Первая + 159);
		Результат.Вставить("code", ПронумероватьСтроки(Строки, Первая, Последняя, 0));
		Сводка = Имя + ": " + Цель.Имя;
		Если Последняя < Конец_ Тогда
			Результат.Вставить("more", СтрШаблон("показаны строки %1–%2 из %3–%4: продолжение — start=%5",
				Первая, Последняя, Цель.Строка, Конец_, Последняя + 1));
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если НомерСтроки > 0 Тогда
		Если НомерСтроки > Строки.Количество() Тогда
			ВызватьИсключение СтрШаблон("В %1 всего %2 строк — строки %3 нет (исходники другой версии?)", Имя, Строки.Количество(), НомерСтроки);
		КонецЕсли;
		Владелец = Неопределено;
		Для Каждого Метод Из Методы Цикл
			Если Метод.Строка <= НомерСтроки Тогда
				Владелец = Метод;
			КонецЕсли;
		КонецЦикла;
		Если Владелец <> Неопределено Тогда
			Результат.Вставить("inside", СтрШаблон("%1 %2 (строка %3)", Владелец.Вид, Владелец.Имя, Владелец.Строка));
		КонецЕсли;
		Результат.Вставить("code", ПронумероватьСтроки(Строки, НомерСтроки - 25, НомерСтроки + 25, НомерСтроки));
		Сводка = Имя + "(" + Формат(НомерСтроки, "ЧГ=0") + ")";
		Возврат Результат;
	КонецЕсли;

	Список = Новый Массив;
	Для Каждого Метод Из Методы Цикл
		Если Список.Количество() = 300 Тогда
			Список.Добавить("… всего " + Методы.Количество());
			Прервать;
		КонецЕсли;
		Список.Добавить(СтрШаблон("%1: %2 %3%4%5", Формат(Метод.Строка, "ЧГ=0"), Метод.Вид, Метод.Имя, ?(Метод.Экспорт, " Экспорт", ""),
			?(ЗначениеЗаполнено(Метод.Аннотация), " " + Метод.Аннотация, "")));
	КонецЦикла;
	Результат.Вставить("methods", Список);
	// Модуль расширения — это перехваты: сам ответ «что меняет расширение» в их теле.
	Перехваты = Новый Массив;
	Для Каждого Метод Из Методы Цикл
		Если ЗначениеЗаполнено(Метод.Аннотация) И Перехваты.Количество() < 5 Тогда
			Перехваты.Добавить(Метод.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Перехваты.Количество() > 0 Тогда
		Результат.Вставить("next", "Это код расширения: что именно оно меняет — в теле перехватов. Прочитай: "
			+ СтрСоединить(Перехваты, ", ") + " (code_read с procedure и тем же source).");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПоискКода(Аргументы, Сводка)

	Текст = СокрЛП(Строка(Аргументы.Получить("text")));
	Если СтрДлина(Текст) < 3 Или Текст = "Неопределено" Тогда
		ВызватьИсключение "Слишком короткая строка поиска — нужно хотя бы 3 символа";
	КонецЕсли;
	Область = СокрЛП(Строка(Аргументы.Получить("scope")));
	Источник = СокрЛП(Строка(Аргументы.Получить("source")));
	Лимит = ЧислоИлиНоль(Аргументы.Получить("limit"));
	Лимит = ?(Лимит > 0, Мин(Лимит, 200), 40);

	Запрос = Новый Запрос("ВЫБРАТЬ Т.Источник КАК Источник, Т.Модуль КАК Модуль, Т.Текст КАК Текст
		|ИЗ РегистрСведений.иик_ИсходныйКод КАК Т
		|ГДЕ Т.Текст ПОДОБНО &Образец СПЕЦСИМВОЛ ""~""" + ?(ЗначениеЗаполнено(Область) И Область <> "Неопределено",
		" И (Т.Модуль ПОДОБНО &Область СПЕЦСИМВОЛ ""~"" ИЛИ Т.Модуль = &ОбластьТочно)", "")
		+ ?(ЗначениеЗаполнено(Источник) И Источник <> "Неопределено", " И Т.Источник = &Источник", "") + "
		|УПОРЯДОЧИТЬ ПО ВЫБОР КОГДА Т.Источник = ""Конфигурация"" ТОГДА 0 ИНАЧЕ 1 КОНЕЦ, Т.Модуль");
	Запрос.УстановитьПараметр("Образец", "%" + ЭкранироватьПодобно(Текст) + "%");
	Запрос.УстановитьПараметр("Область", ЭкранироватьПодобно(Область) + ".%");
	Запрос.УстановитьПараметр("ОбластьТочно", Область);
	Запрос.УстановитьПараметр("Источник", Источник);
	Выборка = Запрос.Выполнить().Выбрать();

	Совпадения = Новый Массив;
	Всего = 0;
	Модулей = 0;
	Искомое = НРег(Текст);
	Пока Выборка.Следующий() Цикл
		Модулей = Модулей + 1;
		Номер = 0;
		Для Каждого СтрокаКода Из СтрРазделить(Выборка.Текст, Символы.ПС, Истина) Цикл
			Номер = Номер + 1;
			Если СтрНайти(НРег(СтрокаКода), Искомое) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Всего = Всего + 1;
			Если Совпадения.Количество() < Лимит Тогда
				Совпадения.Добавить(СтрШаблон("%1(%2): %3%4", Выборка.Модуль, Формат(Номер, "ЧГ=0"), Лев(СокрЛП(СтрокаКода), 220),
					?(Выборка.Источник = "Конфигурация", "", "  [" + Выборка.Источник + "]")));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Модулей = 0 Тогда
		ПроверитьЗагрузкуИсходников();
	КонецЕсли;

	Результат = Новый Соответствие;
	Результат.Вставить("query", Текст);
	Результат.Вставить("scope", ?(ЗначениеЗаполнено(Область) И Область <> "Неопределено", Область, "вся конфигурация"));
	Результат.Вставить("total", Всего);
	Результат.Вставить("modules", Модулей);
	Результат.Вставить("matches", Совпадения);
	Если Всего > Лимит Тогда
		Результат.Вставить("more", СтрШаблон("показаны %1 из %2 — сузь scope", Лимит, Всего));
	КонецЕсли;
	Сводка = СтрШаблон("«%1»: %2 в %3 модулях", Текст, Всего, Модулей);
	Возврат Результат;

КонецФункции

Процедура ПроверитьЗагрузкуИсходников()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Модуль ИЗ РегистрСведений.иик_ИсходныйКод КАК Т");
	Если Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Исходники конфигурации в базу не загружены — код смотреть не по чему. "
			+ "Администратор загружает их один раз скриптом extension/load-sources.sh из выгрузки конфигурации в файлы.";
	КонецЕсли;

КонецПроцедуры

// «Строка|Вид|Имя|Экспорт» по строке на метод — так их раскладывает загрузчик.
Функция РазобратьМетоды(Текст)

	Методы = Новый Массив;
	Для Каждого Описание Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Поля = СтрРазделить(Описание, "|");
		Если Поля.Количество() >= 3 Тогда
			Методы.Добавить(Новый Структура("Строка, Вид, Имя, Экспорт, Аннотация", Число(Поля[0]), Поля[1], Поля[2],
				Поля.Количество() > 3 И Поля[3] = "1", ?(Поля.Количество() > 4, Поля[4], "")));
		КонецЕсли;
	КонецЦикла;
	Возврат Методы;

КонецФункции

Функция ЭтоКонецМетода(СтрокаКода)

	Начало = НРег(СокрЛ(СтрокаКода));
	Возврат СтрНачинаетсяС(Начало, "конецпроцедуры") Или СтрНачинаетсяС(Начало, "конецфункции");

КонецФункции

Функция ПронумероватьСтроки(Строки, Начало, Конец_, Отметка)

	Вывод = Новый Массив;
	Для Номер = Макс(1, Начало) По Мин(Строки.Количество(), Конец_) Цикл
		Вывод.Добавить(?(Номер = Отметка, ">>", "  ") + Формат(Номер, "ЧЦ=5; ЧВН=; ЧГ=0") + "  "
			+ СокрП(СтрЗаменить(Строки[Номер - 1], Символы.ВК, "")));
	КонецЦикла;
	Возврат СтрСоединить(Вывод, Символы.ПС);

КонецФункции

Функция ЭкранироватьПодобно(Текст)

	Результат = Текст;
	Для Каждого Символ Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Поиск по своей базе знаний (общий макет иик_БазаЗнаний, собирается из kb/ скриптом build-kb.py):
// BM25 по грубым основам слов и бонус за совпадение соседних пар слов (цитаты текста ошибки).
Функция ПоискВБазеЗнаний(Аргументы, Сводка)

	Вопрос = СокрЛП(Строка(Аргументы.Получить("query")));
	Вид = НРег(СокрЛП(Строка(Аргументы.Получить("kind"))));
	Вид = ?(Вид = "tickets" Или Вид = "ticket", "ticket", ?(Вид = "docs" Или Вид = "doc", "doc", ""));
	Лимит = ЧислоИлиНоль(Аргументы.Получить("limit"));
	Лимит = ?(Лимит > 0, Мин(Лимит, 10), 5);

	Куски = КускиБазыЗнаний();
	ЧастотаВКусках = Новый Соответствие;
	СуммаДлин = 0;
	Для Каждого Кусок Из Куски Цикл
		СуммаДлин = СуммаДлин + Кусок.Длина;
		Для Каждого КлючИЗначение Из Кусок.Частоты Цикл
			ЧастотаВКусках.Вставить(КлючИЗначение.Ключ, ЧислоИлиНоль(ЧастотаВКусках.Получить(КлючИЗначение.Ключ)) + 1);
		КонецЦикла;
	КонецЦикла;
	СредняяДлина = ?(Куски.Количество() > 0, СуммаДлин / Куски.Количество(), 1);

	СловаВопроса = ОсновыСлов(Вопрос);
	ПарыВопроса = Новый Соответствие;
	Для Индекс = 1 По СловаВопроса.Количество() - 1 Цикл
		ПарыВопроса.Вставить(СловаВопроса[Индекс - 1] + " " + СловаВопроса[Индекс], Истина);
	КонецЦикла;
	Термины = Новый Соответствие;
	Для Каждого Слово Из СловаВопроса Цикл
		Термины.Вставить(Слово, Истина);
	КонецЦикла;

	Оценки = Новый ТаблицаЗначений;
	Оценки.Колонки.Добавить("Оценка", Новый ОписаниеТипов("Число"));
	Оценки.Колонки.Добавить("Кусок");
	N = Куски.Количество();
	Для Каждого Кусок Из Куски Цикл
		Если ЗначениеЗаполнено(Вид) И Кусок.Вид <> Вид Тогда
			Продолжить;
		КонецЕсли;
		Оценка = 0;
		Для Каждого Термин Из Термины Цикл
			TF = ЧислоИлиНоль(Кусок.Частоты.Получить(Термин.Ключ));
			Если TF = 0 Тогда
				Продолжить;
			КонецЕсли;
			DF = ЧастотаВКусках.Получить(Термин.Ключ);
			IDF = Log(1 + (N - DF + 0.5) / (DF + 0.5));
			Оценка = Оценка + IDF * TF * 2.2 / (TF + 1.2 * (0.25 + 0.75 * Кусок.Длина / СредняяДлина));
		КонецЦикла;
		Для Каждого Пара Из ПарыВопроса Цикл
			Если Кусок.Пары.Получить(Пара.Ключ) <> Неопределено Тогда
				Оценка = Оценка + 2;
			КонецЕсли;
		КонецЦикла;
		Если Оценка > 0 Тогда
			Строка_ = Оценки.Добавить();
			Строка_.Оценка = Оценка;
			Строка_.Кусок = Кусок;
		КонецЕсли;
	КонецЦикла;
	Оценки.Сортировать("Оценка Убыв");

	Найденные = Новый Массив;
	Для Каждого Строка_ Из Оценки Цикл
		Если Найденные.Количество() = Лимит Тогда
			Прервать;
		КонецЕсли;
		Кусок = Строка_.Кусок;
		Описание = Новый Соответствие;
		Описание.Вставить("source", Кусок.Файл + ?(Кусок.Часть > 1, " (часть " + Кусок.Часть + ")", ""));
		Описание.Вставить("kind", ?(Кусок.Вид = "ticket", "решённое обращение", "документ"));
		Описание.Вставить("title", Кусок.Заголовок);
		Описание.Вставить("score", Окр(Строка_.Оценка, 2));
		Описание.Вставить("text", Лев(Кусок.Текст, 1500));
		Найденные.Добавить(Описание);
	КонецЦикла;

	Результат = Новый Соответствие;
	Результат.Вставить("total", Найденные.Количество());
	Результат.Вставить("results", Найденные);
	Если Найденные.Количество() = 0 Тогда
		Результат.Вставить("note", "Ничего не найдено — переформулируй другими словами или скажи пользователю, что в базе знаний этого нет");
	КонецЕсли;
	Сводка = СтрШаблон("найдено %1", Найденные.Количество());
	Возврат Результат;

КонецФункции

// Статьи макета → куски до ~1500 символов по абзацам, с учётом заголовков.
Функция КускиБазыЗнаний()

	Куски = Новый Массив;
	Текст = СтрЗаменить(ПолучитьОбщийМакет("иик_БазаЗнаний").ПолучитьТекст(), Символы.ВК, "");
	// СтрРазделить режет по каждому символу разделителя — многосимвольные метки сначала в один символ.
	Для Каждого Статья Из СтрРазделить(СтрЗаменить(Текст, "=== ФАЙЛ: ", Символ(1)), Символ(1), Ложь) Цикл
		Перенос = СтрНайти(Статья, Символы.ПС);
		Если Перенос = 0 Тогда
			Продолжить;
		КонецЕсли;
		Файл = СокрЛП(Лев(Статья, Перенос - 1));
		Тело = СокрЛП(Сред(Статья, Перенос + 1));
		Заголовок = Файл;
		Для Каждого СтрокаТекста Из СтрРазделить(Тело, Символы.ПС, Ложь) Цикл
			Кандидат = СокрЛП(СтрЗаменить(СтрокаТекста, "#", ""));
			Если ЗначениеЗаполнено(Кандидат) Тогда
				Заголовок = Лев(Кандидат, 120);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Вид = ?(СтрНачинаетсяС(Файл, "tickets/"), "ticket", "doc");
		Текущий = "";
		Части = Новый Массив;
		Для Каждого Абзац Из СтрРазделить(СтрЗаменить(Тело, Символы.ПС + Символы.ПС, Символ(2)), Символ(2), Ложь) Цикл
			Если ЗначениеЗаполнено(Текущий) И (СтрДлина(Текущий) + СтрДлина(Абзац) > 1500 Или СтрНачинаетсяС(СокрЛ(Абзац), "#")) Тогда
				Части.Добавить(СокрЛП(Текущий));
				Текущий = "";
			КонецЕсли;
			Текущий = Текущий + Абзац + Символы.ПС + Символы.ПС;
		КонецЦикла;
		Если ЗначениеЗаполнено(СокрЛП(Текущий)) Тогда
			Части.Добавить(СокрЛП(Текущий));
		КонецЕсли;
		Номер = 0;
		Для Каждого Часть Из Части Цикл
			Номер = Номер + 1;
			Слова = ОсновыСлов(Заголовок + " " + Часть);
			Частоты = Новый Соответствие;
			Пары = Новый Соответствие;
			Для Индекс = 0 По Слова.Количество() - 1 Цикл
				Частоты.Вставить(Слова[Индекс], ЧислоИлиНоль(Частоты.Получить(Слова[Индекс])) + 1);
				Если Индекс > 0 Тогда
					Пары.Вставить(Слова[Индекс - 1] + " " + Слова[Индекс], Истина);
				КонецЕсли;
			КонецЦикла;
			Куски.Добавить(Новый Структура("Файл, Вид, Заголовок, Часть, Текст, Частоты, Пары, Длина",
				Файл, Вид, Заголовок, Номер, Часть, Частоты, Пары, Слова.Количество()));
		КонецЦикла;
	КонецЦикла;
	Возврат Куски;

КонецФункции

// Слова текста → грубые основы (окончания по убыванию длины), без служебных слов вопросов.
Функция ОсновыСлов(Текст)

	Окончания = СтрРазделить("ениям ениях ения ение ений ться ами ями ого его ому ему ыми ими ией иям иях тся ешь ете ишь ите "
		+ "ует уют ают яют ала ила ыла ела али или ыли ели ать ять ить еть уть ом ем ой ей ую юю ая яя ое ее "
		+ "ые ие ый ий ов ев ам ям ах ях ть ся а я о е ы и у ю ь й", " ", Ложь);
	Стоп = " что как это так там тут где когда если или для при по на за из от до во со ко об у в и а с о к мы нас нам вы вас вам "
		+ "он она они его её ее их мой наш ваш быть есть был была было были делать сделать надо нужно можно почему зачем какой какая "
		+ "какие который которая ";
	Основы = Новый Массив;
	Слово = "";
	Для Позиция = 1 По СтрДлина(Текст) + 1 Цикл
		Символ = ?(Позиция <= СтрДлина(Текст), Сред(Текст, Позиция, 1), " ");
		Если ЭтоБукваИлиЦифра(Символ) Тогда
			Слово = Слово + Символ;
			Продолжить;
		КонецЕсли;
		Если СтрДлина(Слово) > 1 Тогда
			Слово = СтрЗаменить(НРег(Слово), "ё", "е");
			Если СтрНайти(Стоп, " " + Слово + " ") = 0 Тогда
				Если СтрДлина(Слово) > 4 И Сред(Слово, 1, 1) >= "а" И Сред(Слово, 1, 1) <= "я" Тогда
					Для Каждого Окончание Из Окончания Цикл
						Если СтрЗаканчиваетсяНа(Слово, Окончание) И СтрДлина(Слово) - СтрДлина(Окончание) >= 4 Тогда
							Слово = Лев(Слово, СтрДлина(Слово) - СтрДлина(Окончание));
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Основы.Добавить(Слово);
			КонецЕсли;
		КонецЕсли;
		Слово = "";
	КонецЦикла;
	Возврат Основы;

КонецФункции

Функция ЭтоБукваИлиЦифра(Символ)

	Код = КодСимвола(Символ);
	Возврат (Код >= 48 И Код <= 57) Или (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122)
		Или (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105;

КонецФункции

#КонецОбласти
