#КонецОбласти

#Область ЗакрытиеМесяца

// Закрытие месяца через типовой механизм БП: детальный статус операций строит
// ЗакрытиеМесяца.СоздатьДетальныйСтатусЗакрытияМесяца, выполняет Обработки.ЗакрытиеМесяца.ВыполнитьЗакрытиеМесяца —
// то же, что кнопка «Выполнить закрытие месяца» в форме. Ошибки операций — из документа РегламентнаяОперация.

// period: «2026-09» или любая дата месяца → начало месяца.
Функция ПериодЗакрытия(Аргументы)

	Текст = СокрЛП(Строка(Аргументы.Получить("period")));
	Если СтрДлина(Текст) = 7 Тогда
		Текст = Текст + "-01";
	КонецЕсли;
	Дата = ЗначениеИзJSON(Текст);
	Если ТипЗнч(Дата) <> Тип("Дата") Или Дата = '00010101' Тогда
		ВызватьИсключение "Нужен период: period, например «2026-09»";
	КонецЕсли;
	Возврат НачалоМесяца(Дата);

КонецФункции

// organization: ссылка или наименование; не названа — единственная организация базы, иначе просим уточнить.
Функция ОрганизацияЗакрытия(Аргументы)

	Значение = Аргументы.Получить("organization");
	Если ТипЗнч(Значение) = Тип("Соответствие") И Значение.Получить("_ref") <> Неопределено Тогда
		Возврат СсылкаИзJSON(Значение);
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Если Текст <> "" Тогда
		Ошибки = Новый Массив;
		Найдено = НайтиПоПредставлению(Метаданные.Справочники.Организации, Текст, Ошибки);
		Если Найдено = Неопределено Тогда
			ВызватьИсключение "organization «" + Текст + "»: " + ?(Ошибки.Количество() > 0, СтрСоединить(Ошибки, "; "), "не найдена");
		КонецЕсли;
		Возврат Найдено;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 5 Т.Ссылка КАК Ссылка, Т.Наименование КАК Наименование
		|ИЗ Справочник.Организации КАК Т ГДЕ НЕ Т.ПометкаУдаления УПОРЯДОЧИТЬ ПО Т.Наименование");
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 1 Тогда
		Возврат Таблица[0].Ссылка;
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Имена.Добавить(Строка.Наименование);
	КонецЦикла;
	ВызватьИсключение "В базе несколько организаций — укажи organization: " + СтрСоединить(Имена, ", ");

КонецФункции

// Таблица операций закрытия с состояниями — как строка таблицы в форме «Закрытие месяца».
Функция ТаблицаСтатусаЗакрытия(Период, Организация)

	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗакрытиеМесяца.СоздатьДетальныйСтатусЗакрытияМесяца(МенеджерВременныхТаблиц, Период, Организация);
	Запрос = Новый Запрос("ВЫБРАТЬ Статус.ВидОперации КАК ВидОперации, Статус.Организация КАК Организация,
		|	Статус.НомерГруппы КАК НомерГруппы, Статус.ПоОрганизацииВЦелом КАК ПоОрганизацииВЦелом,
		|	Статус.Требуется КАК Требуется, Статус.РучнаяКорректировка КАК РучнаяКорректировка,
		|	Статус.Состояние КАК Состояние, Статус.Устарела КАК Устарела, Статус.Ссылка КАК Ссылка
		|ИЗ ДетальныйСтатусЗакрытияМесяца КАК Статус
		|УПОРЯДОЧИТЬ ПО Статус.НомерГруппы, Статус.ВидОперации.Порядок");
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Момент нарушения последовательности проведения до конца месяца: документ записан «задним числом» —
// всё после него нужно перепровести, иначе регламентные операции отказывают.
Функция МоментНарушенияПоследовательности(Организация, Период)

	Попытка
		Момент = РаботаСПоследовательностями.МоментНарушенияПоследовательности(Организация, КонецДня(КонецМесяца(Период)));
		Если Момент <> Неопределено И Момент.Дата <= КонецДня(КонецМесяца(Период)) Тогда
			Возврат Момент;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

Функция ОписаниеНарушения(Момент)

	Описание = Новый Соответствие;
	Описание.Вставить("date", Формат(Момент.Дата, "ДЛФ=D"));
	Описание.Вставить("document", Строка(Момент.Ссылка));
	Если ЗначениеЗаполнено(Момент.Ссылка) Тогда
		Описание.Вставить("ref", ЗначениеДляJSON(Момент.Ссылка));
	КонецЕсли;
	Возврат Описание;

КонецФункции

