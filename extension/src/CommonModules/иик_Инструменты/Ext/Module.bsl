Процедура ДобавитьПоля(Результат, Ключ, Поля)

	Описание = ОписаниеПолей(Поля);
	Если Описание.Количество() > 0 Тогда
		Результат.Вставить(Ключ, Описание);
	КонецЕсли;

КонецПроцедуры

// Компактно: "Имя: Тип — Синоним", чтобы описание крупного документа влезало в контекст модели.
Функция ОписаниеПолей(Поля)

	Описание = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Текст = Поле.Имя + ": " + ТипСтрокой(Поле.Тип);
		Попытка
			Если Поле.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку Тогда
				Текст = Текст + " [обязательный]";
			КонецЕсли;
		Исключение
			// у поля нет проверки заполнения
		КонецПопытки;
		Если ЗначениеЗаполнено(Поле.Синоним) И НРег(СтрЗаменить(Поле.Синоним, " ", "")) <> НРег(Поле.Имя) Тогда
			Текст = Текст + " — " + Поле.Синоним;
		КонецЕсли;
		Описание.Добавить(Текст);
	КонецЦикла;
	Возврат Описание;

КонецФункции

Функция ТипСтрокой(ОписаниеТипов)

	Имена = Новый Массив;
	Типы = ОписаниеТипов.Типы();
	Для Каждого Т Из Типы Цикл
		Если Имена.Количество() >= 5 Тогда
			Имена.Добавить("… ещё " + (Типы.Количество() - 5));
			Прервать;
		КонецЕсли;
		МД = Метаданные.НайтиПоТипу(Т);
		Имена.Добавить(?(МД = Неопределено, Строка(Т), МД.ПолноеИмя()));
	КонецЦикла;
	Возврат СтрСоединить(Имена, " | ");

КонецФункции

Функция ДлинаСвойства(МД, Свойство)

	Попытка
		Возврат ?(Свойство = "Код", МД.ДлинаКода, МД.ДлинаНаименования);
	Исключение
		Возврат 0; // у этого вида объектов нет кода или наименования
	КонецПопытки;

КонецФункции

Функция ЛимитИзАргументов(Аргументы, ПоУмолчанию, Максимум)

	Лимит = Аргументы.Получить("limit");
	Если ТипЗнч(Лимит) <> Тип("Число") Или Лимит <= 0 Тогда
