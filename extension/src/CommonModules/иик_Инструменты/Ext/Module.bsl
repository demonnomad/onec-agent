// Исполнитель инструментов ИИ-консультанта.
//
// Всё выполняется в сеансе и с правами текущего пользователя: модуль не
// привилегированный, запросы — без РАЗРЕШЕННЫЕ, поэтому RLS и права роли
// действуют как при обычной работе. Список инструментов — белый: всё, чего
// нет в ВыполнитьВызов, отклоняется, что бы ни прислал сервер агента.

#Область ПрограммныйИнтерфейс

Функция АдресСервера() Экспорт

	Адрес = ХранилищеОбщихНастроек.Загрузить("иик_ИИКонсультант", "АдресСервера");
	Если ЗначениеЗаполнено(Адрес) Тогда
		Возврат Адрес;
	КонецЕсли;
	Возврат "http://127.0.0.1:8765";

КонецФункции

Процедура СохранитьАдресСервера(Адрес) Экспорт

	ХранилищеОбщихНастроек.Сохранить("иик_ИИКонсультант", "АдресСервера", Адрес);

КонецПроцедуры

// Токен доступа к серверу агента (файл server/data/token на сервере). Хранится в настройках
// пользователя, как и адрес; странице чата передаётся в контексте и в модель не попадает.
Функция ТокенСервера() Экспорт

	Токен = ХранилищеОбщихНастроек.Загрузить("иик_ИИКонсультант", "ТокенСервера");
	Возврат ?(ТипЗнч(Токен) = Тип("Строка"), Токен, "");

КонецФункции

Процедура СохранитьТокенСервера(Токен) Экспорт

	ХранилищеОбщихНастроек.Сохранить("иик_ИИКонсультант", "ТокенСервера", Токен);

КонецПроцедуры

Функция КонтекстБазыJSON() Экспорт

	Информация = Новый СистемнаяИнформация;

	Контекст = Новый Соответствие;
	Контекст.Вставить("config", Метаданные.Синоним);
	Контекст.Вставить("config_name", Метаданные.Имя);
	Контекст.Вставить("config_version", Метаданные.Версия);
	Контекст.Вставить("platform", Информация.ВерсияПриложения);
	Контекст.Вставить("user", ПолноеИмяПользователя());
	Контекст.Вставить("client", "__CLIENT__");
	Контекст.Вставить("today", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd"));
	// Профиль модели сервер агента хранит по базе: идентификатор — хеш строки соединения
	// (сам путь или адрес базы наружу не уходит). Менять профиль может только администратор.
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(СтрокаСоединенияИнформационнойБазы() + "|" + Метаданные.Имя);
	Контекст.Вставить("base_id", Лев(НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма)), 24));
	Контекст.Вставить("is_admin", ПравоДоступа("Администрирование", Метаданные));
	Контекст.Вставить("token", ТокенСервера());

	Возврат ВJSON(Контекст);

КонецФункции

// Выполняет вызов инструмента от агента.
//
// Параметры:
//   ТекстВызова - Строка - JSON {"id", "name", "args"}
//
// Возвращаемое значение:
//   Строка - JSON {"id", "ok", "result", "summary", "error"}
//
Функция ВыполнитьВызов(ТекстВызова) Экспорт

	Ответ = Новый Соответствие;
	Попытка
		Вызов = ИзJSON(ТекстВызова);
		Ответ.Вставить("id", Вызов.Получить("id"));
		Имя = Вызов.Получить("name");
		Аргументы = Вызов.Получить("args");
		Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
			Аргументы = Новый Соответствие;
		КонецЕсли;

		Сводка = "";
		Если Имя = "metadata_search" Тогда
			Результат = ПоискМетаданных(Аргументы, Сводка);
		ИначеЕсли Имя = "metadata_describe" Тогда
			Результат = ОписаниеМетаданных(Аргументы, Сводка);
		ИначеЕсли Имя = "object_find" Тогда
			Результат = ПоискОбъектов(Аргументы, Сводка);
		ИначеЕсли Имя = "object_get" Тогда
			Результат = ДанныеОбъекта(Аргументы, Сводка);
		ИначеЕсли Имя = "document_movements" Тогда
			Результат = ДвиженияДокумента(Аргументы, Сводка);
		ИначеЕсли Имя = "query_run" Тогда
			Результат = ВыполнитьЗапрос(Аргументы, Сводка);
		ИначеЕсли Имя = "posting_check" Тогда
			Результат = ПробноеПроведение(Аргументы, Сводка);
		ИначеЕсли Имя = "eventlog_search" Тогда
			Результат = ПоискВЖурнале(Аргументы, Сводка);
		ИначеЕсли Имя = "register_balance" Тогда
			Результат = ИтогиРегистра(Аргументы, Сводка, "balance");
		ИначеЕсли Имя = "register_turnover" Тогда
			Результат = ИтогиРегистра(Аргументы, Сводка, "turnover");
		ИначеЕсли Имя = "account_report" Тогда
			Результат = ОтчетПоСчету(Аргументы, Сводка);
		ИначеЕсли Имя = "report_run" Тогда
			Результат = ЗапуститьОтчет(Аргументы, Сводка);
		ИначеЕсли Имя = "month_close_status" Тогда
			Результат = СтатусЗакрытияМесяца(Аргументы, Сводка);
		ИначеЕсли Имя = "month_close_check" Тогда
			Результат = ПроверкаГотовностиКЗакрытию(Аргументы, Сводка);
		ИначеЕсли Имя = "extensions_list" Тогда
			Результат = СписокРасширений(Аргументы, Сводка);
		ИначеЕсли Имя = "regulated_report" Тогда
			Результат = РегламентированныйОтчет(Аргументы, Сводка);
		ИначеЕсли Имя = "vat_book" Тогда
			Результат = КнигаНДС(Аргументы, Сводка);
		ИначеЕсли Имя = "vat_reconcile" Тогда
			Результат = СверкаНДС(Аргументы, Сводка);
		ИначеЕсли Имя = "code_read" Тогда
			Результат = ПрочитатьКод(Аргументы, Сводка);
		ИначеЕсли Имя = "code_search" Тогда
			Результат = ПоискКода(Аргументы, Сводка);
		ИначеЕсли Имя = "kb_search" Тогда
			Результат = ПоискВБазеЗнаний(Аргументы, Сводка);
		Иначе
			ВызватьИсключение "Инструмент не разрешён расширением: " + Имя;
		КонецЕсли;

		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("result", ВJSON(Результат));
		Ответ.Вставить("summary", Сводка);
	Исключение
		Ответ.Вставить("ok", Ложь);
		Ответ.Вставить("error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ВJSON(Ответ);

КонецФункции

// Имя, идентификатор и заголовок вызова — форме для подтверждения действий
// (в веб-клиенте разбирать JSON на клиенте нечем).
Функция ЗаголовокВызова(ТекстВызова) Экспорт
	
	Вызов = ИзJSON(ТекстВызова);
	Возврат Новый Структура("Имя, Ид, Заголовок", Вызов.Получить("name"), Вызов.Получить("id"), Вызов.Получить("title"));
	
КонецФункции

// Ответ на вызов в формате моста: {"id", "ok", "result", "summary", "error"}.
Функция ОтветJSON(Ид, Успех, Результат = Неопределено, ТекстОшибки = Неопределено, Сводка = Неопределено) Экспорт
	
	Ответ = Новый Соответствие;
	Ответ.Вставить("id", Ид);
	Ответ.Вставить("ok", Успех);
	Если Результат <> Неопределено Тогда
		Ответ.Вставить("result", Результат);
	КонецЕсли;
	Если ТекстОшибки <> Неопределено Тогда
		Ответ.Вставить("error", ТекстОшибки);
	КонецЕсли;
	Если Сводка <> Неопределено Тогда
		Ответ.Вставить("summary", Сводка);
	КонецЕсли;
	Возврат ВJSON(Ответ);
	
КонецФункции

// Возвращает ссылку из аргумента ref вызова — для действий на клиенте (ui_open).
Функция СсылкаИзВызова(ТекстВызова) Экспорт

	Вызов = ИзJSON(ТекстВызова);
	Аргументы = Вызов.Получить("args");
	Возврат СсылкаИзJSON(Аргументы.Получить("ref"));

КонецФункции

#КонецОбласти

#Область Действия

// Действия, меняющие данные. Вызываются только из формы чата — после них форма
// показывает пользователю нативный диалог выбора. В ВыполнитьВызов их нет:
// сервер агента не может инициировать их в обход формы.

// Создаёт черновик счёта на оплату покупателю (запись без проведения).
// Цены и количество — от пользователя; ставки и суммы НДС, организацию, договор,
// условия счёта заполняет типовой код БП (ОбработкаЗаполнения документа).
//
// Возвращаемое значение:
//   Структура - Ссылка, Описание (текст для диалога)
//
Функция СоздатьЧерновикСчета(ТекстВызова) Экспорт

	Аргументы = ИзJSON(ТекстВызова).Получить("args");
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Нет аргументов вызова";
	КонецЕсли;

	Контрагент = СсылкаИзJSON(Аргументы.Получить("counterparty"));
	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
		ВызватьИсключение "counterparty должен быть ссылкой на Справочник.Контрагенты";
	КонецЕсли;

	Позиции = Аргументы.Получить("items");
	Если ТипЗнч(Позиции) <> Тип("Массив") Или Позиции.Количество() = 0 Тогда
		ВызватьИсключение "items: нужен хотя бы один товар или услуга";
	КонецЕсли;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Количество");
	Таблица.Колонки.Добавить("Цена");
	Таблица.Колонки.Добавить("Сумма");
	Для Каждого Позиция Из Позиции Цикл
		Номенклатура = СсылкаИзJSON(Позиция.Получить("item"));
		Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
			ВызватьИсключение "item должен быть ссылкой на Справочник.Номенклатура";
		КонецЕсли;
		Количество = Позиция.Получить("quantity");
		Цена = Позиция.Получить("price");
		Если ТипЗнч(Количество) <> Тип("Число") Или Количество <= 0 Тогда
			ВызватьИсключение "quantity для «" + Номенклатура + "» должно быть больше нуля";
		КонецЕсли;
		Если ТипЗнч(Цена) <> Тип("Число") Или Цена <= 0 Тогда
			ВызватьИсключение "price для «" + Номенклатура + "» не указана — спроси цену у пользователя";
		КонецЕсли;
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Номенклатура = Номенклатура;
		НоваяСтрока.Количество = Количество;
		НоваяСтрока.Цена = Цена;
		НоваяСтрока.Сумма = Окр(Количество * Цена, 2);
	КонецЦикла;

	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Организация", ОрганизацияДляДокумента(Аргументы.Получить("organization")));
	ДанныеЗаполнения.Вставить("Контрагент", Контрагент);
	ДанныеЗаполнения.Вставить("АдресТаблицыНоменклатуры", ПоместитьВоВременноеХранилище(Таблица));

	Документ = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Заполнить(ДанныеЗаполнения);
	Пояснение = СокрЛП(Строка(Аргументы.Получить("comment")));
	Документ.Комментарий = "Создан ИИ-консультантом" + ?(ЗначениеЗаполнено(Пояснение) И Пояснение <> "Неопределено",
		". " + Пояснение, "");
	Если Не ЗначениеЗаполнено(Документ.Организация) Тогда
		ВызватьИсключение "Не удалось определить организацию — черновик не создан";
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Запись);

	Возврат Новый Структура("Ссылка, Описание, ЭтоДокумент", Документ.Ссылка, ОписаниеСчета(Документ), Истина);

КонецФункции

// Создаёт черновик реализации или поступления товаров и услуг (БП 3.0).
// Товары и услуги разносятся по своим табличным частям, счета учёта, ставки и суммы НДС
// заполняет типовой код БП; от пользователя — кто, что, сколько и почём.
//
// Параметры:
//   ТекстВызова - Строка - JSON вызова: counterparty, items [{item, quantity, price}],
//                 необязательно organization, warehouse, comment; для поступления —
//                 incoming_number, incoming_date
//   Вид - Строка - "sale" или "purchase"
//
// Возвращаемое значение:
//   Структура - Ссылка, Описание, ЭтоДокумент
//
Функция СоздатьЧерновикТоварногоДокумента(ТекстВызова, Вид) Экспорт

	Аргументы = ИзJSON(ТекстВызова).Получить("args");
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Нет аргументов вызова";
	КонецЕсли;
	ЭтоРеализация = (Вид = "sale");
	МД = ?(ЭтоРеализация, Метаданные.Документы.РеализацияТоваровУслуг, Метаданные.Документы.ПоступлениеТоваровУслуг);
	Если Не ПравоДоступа("Добавление", МД) Тогда
		ВызватьИсключение "У пользователя нет права добавлять " + МД.Синоним;
	КонецЕсли;

	ДанныеЗаполнения = Новый Структура;
	Организация = Аргументы.Получить("organization");
	Если Организация = Неопределено Тогда
		ДанныеЗаполнения.Вставить("Организация", ОрганизацияДляДокумента(Неопределено));
	Иначе
		ДанныеЗаполнения.Вставить("Организация", ПривестиЗначение(Организация, ТипРеквизита(МД, "Организация"), "organization"));
	КонецЕсли;
	ДанныеЗаполнения.Вставить("Контрагент",
		ПривестиЗначение(Аргументы.Получить("counterparty"), ТипРеквизита(МД, "Контрагент"), "counterparty"));
	Если Аргументы.Получить("warehouse") <> Неопределено Тогда
		ДанныеЗаполнения.Вставить("Склад", ПривестиЗначение(Аргументы.Получить("warehouse"), ТипРеквизита(МД, "Склад"), "warehouse"));
	КонецЕсли;

	Таблица = ТаблицаПозиций(Аргументы.Получить("items"), МД);

	// Вид операции — по составу: у реализации БП при записи стирает «Услуги» для вида «Товары»
	// и «Товары» для вида «Услуги», поэтому товары и услуги в одной реализации не совместить.
	ЧислоУслуг = 0;
	Для Каждого Позиция Из Таблица Цикл
		Если Позиция.Номенклатура.Услуга Тогда
			ЧислоУслуг = ЧислоУслуг + 1;
		КонецЕсли;
	КонецЦикла;
	ТолькоУслуги = (ЧислоУслуг = Таблица.Количество());
	Если ЭтоРеализация И ЧислоУслуг > 0 И Не ТолькоУслуги Тогда
		ВызватьИсключение "В одной реализации БП не совмещает товары и услуги — создай два документа: "
			+ "отдельно товары, отдельно услуги";
	КонецЕсли;
	Если ЭтоРеализация Тогда
		ДанныеЗаполнения.Вставить("ВидОперации", ?(ТолькоУслуги, Перечисления.ВидыОперацийРеализацияТоваров.Услуги,
			Перечисления.ВидыОперацийРеализацияТоваров.Товары));
	Иначе
		ДанныеЗаполнения.Вставить("ВидОперации", ?(ТолькоУслуги, Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Услуги,
			Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Товары));
	КонецЕсли;

	Если ЭтоРеализация Тогда
		Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		ДанныеЗаполнения.Вставить("АдресТаблицыНоменклатуры", ПоместитьВоВременноеХранилище(Таблица));
	Иначе
		Документ = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	КонецЕсли;
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Заполнить(ДанныеЗаполнения);
	ЗаполнитьЗначенияСвойств(Документ, ДанныеЗаполнения, "Организация, Контрагент, ВидОперации");
	Если ДанныеЗаполнения.Свойство("Склад") Тогда
		Документ.Склад = ДанныеЗаполнения.Склад;
	КонецЕсли;
	ПодобратьДоговор(Документ, МД, Аргументы.Получить("contract"), ?(ЭтоРеализация,
		Перечисления.ВидыДоговоровКонтрагентов.СПокупателем, Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком));

	Если Не ЭтоРеализация Тогда
		ЗаполнитьПоступлениеИзТаблицы(Документ, Таблица);
		Если Аргументы.Получить("incoming_number") <> Неопределено Тогда
			Документ.НомерВходящегоДокумента = Строка(Аргументы.Получить("incoming_number"));
		КонецЕсли;
		Если Аргументы.Получить("incoming_date") <> Неопределено Тогда
			Документ.ДатаВходящегоДокумента = ПривестиЗначение(Аргументы.Получить("incoming_date"),
				ТипРеквизита(МД, "ДатаВходящегоДокумента"), "incoming_date");
		КонецЕсли;
	КонецЕсли;

	Пояснение = Аргументы.Получить("comment");
	Документ.Комментарий = "Создан ИИ-консультантом" + ?(ЗначениеЗаполнено(Пояснение), ". " + Пояснение, "");
	Если Не ЗначениеЗаполнено(Документ.Организация) Тогда
		ВызватьИсключение "Не удалось определить организацию — черновик не создан";
	КонецЕсли;
	// Счета, которые форма БП заполняет интерактивно (например, счёт НДС по реализации в строках),
	// типовой код дозаполнит в ПередЗаписью по своим правилам (СчетаУчетаВДокументах).
	Документ.ДополнительныеСвойства.Вставить("ЗаполнитьСчетаУчетаПередЗаписью", Истина);
	Документ.Записать(РежимЗаписиДокумента.Запись);

	Замечания = "";
	Если Не Документ.ПроверитьЗаполнение() Тогда
		Замечания = ТекстыСообщений();
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Описание, ЭтоДокумент", Документ.Ссылка, ОписаниеОбъекта(Документ, МД, Замечания), Истина);

КонецФункции

// При учёте по договорам БП договор сама не подставляет. Названный — ищем по наименованию;
// иначе единственный подходящий договор контрагента с этой организацией и видом. Несколько —
// пусть агент спросит; ни одного — оставляем пустым, проверка заполнения покажет это в окне.
Процедура ПодобратьДоговор(Документ, МД, Заданный, ВидДоговора)

	Если Заданный <> Неопределено Тогда
		Документ.ДоговорКонтрагента = ПривестиЗначение(Заданный, ТипРеквизита(МД, "ДоговорКонтрагента"), "contract");
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Документ.ДоговорКонтрагента) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 6 Д.Ссылка КАК Ссылка, Д.Наименование КАК Наименование
		|ИЗ Справочник.ДоговорыКонтрагентов КАК Д
		|ГДЕ Д.Владелец = &Контрагент И Д.Организация = &Организация И Д.ВидДоговора = &Вид И НЕ Д.ПометкаУдаления");
	Запрос.УстановитьПараметр("Контрагент", Документ.Контрагент);
	Запрос.УстановитьПараметр("Организация", Документ.Организация);
	Запрос.УстановитьПараметр("Вид", ВидДоговора);
	Договоры = Запрос.Выполнить().Выгрузить();
	Если Договоры.Количество() = 1 Тогда
		Документ.ДоговорКонтрагента = Договоры[0].Ссылка;
	ИначеЕсли Договоры.Количество() > 1 Тогда
		ВызватьИсключение "У контрагента несколько договоров («" + СтрСоединить(Договоры.ВыгрузитьКолонку("Наименование"), "», «")
			+ "») — спроси пользователя, по какому, и передай его в contract";
	КонецЕсли;

КонецПроцедуры

// Позиции от агента → таблица Номенклатура/Количество/Цена/Сумма; номенклатуру можно назвать текстом.
Функция ТаблицаПозиций(Позиции, МД)

	Если ТипЗнч(Позиции) <> Тип("Массив") Или Позиции.Количество() = 0 Тогда
		ВызватьИсключение "items: нужен хотя бы один товар или услуга";
	КонецЕсли;
	ТипНоменклатуры = ТипРеквизита(МД, "Номенклатура", МД.ТабличныеЧасти.Товары);
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Количество");
	Таблица.Колонки.Добавить("Цена");
	Таблица.Колонки.Добавить("Сумма");
	Для Каждого Позиция Из Позиции Цикл
		Номенклатура = ПривестиЗначение(Позиция.Получить("item"), ТипНоменклатуры, "item");
		Количество = Позиция.Получить("quantity");
		Цена = Позиция.Получить("price");
		Если ТипЗнч(Количество) <> Тип("Число") Или Количество <= 0 Тогда
			ВызватьИсключение "quantity для «" + Номенклатура + "» должно быть больше нуля";
		КонецЕсли;
		Если ТипЗнч(Цена) <> Тип("Число") Или Цена <= 0 Тогда
			ВызватьИсключение "price для «" + Номенклатура + "» не указана — спроси цену у пользователя";
		КонецЕсли;
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Номенклатура = Номенклатура;
		НоваяСтрока.Количество = Количество;
		НоваяСтрока.Цена = Цена;
		НоваяСтрока.Сумма = Окр(Количество * Цена, 2);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// У поступления нет типового заполнения из таблицы номенклатуры — делаем так же, как
// РеализацияТоваровУслуг.ЗаполнитьИзТаблицыНоменклатуры: сведения о номенклатуре (счета учёта,
// ставка НДС) берём у БП, товары и услуги — в свои табличные части.
Процедура ЗаполнитьПоступлениеИзТаблицы(Документ, Таблица)

	ПараметрыОбъекта = РаботаСНоменклатуройБП.НовыеПараметрыОбъекта();
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Документ);
	ПараметрыОбъекта.Реализация = Ложь;
	Сведения = БухгалтерскийУчетПереопределяемый.ПолучитьСведенияОСпискеНоменклатуры(
		Таблица.ВыгрузитьКолонку("Номенклатура"), ПараметрыОбъекта);

	Документ.Товары.Очистить();
	Документ.Услуги.Очистить();
	Для Каждого Позиция Из Таблица Цикл
		СведенияПозиции = Сведения[Позиция.Номенклатура];
		ЭтоУслуга = СведенияПозиции <> Неопределено И СведенияПозиции.Услуга;
		НоваяСтрока = ?(ЭтоУслуга, Документ.Услуги.Добавить(), Документ.Товары.Добавить());
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Позиция);
		Если СведенияПозиции <> Неопределено Тогда
			Если СведенияПозиции.СчетаУчета <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СведенияПозиции.СчетаУчета);
			КонецЕсли;
			НоваяСтрока.СтавкаНДС = СведенияПозиции.СтавкаНДС;
		КонецЕсли;
		ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, Документ.СуммаВключаетНДС);
	КонецЦикла;

КонецПроцедуры

// Организация задаётся до заполнения: от неё типовой код берёт условия счёта и реквизиты.
// Явно указанная — она; иначе единственная в базе; несколько — пусть агент уточнит.
Функция ОрганизацияДляДокумента(Описание)

	Если Описание <> Неопределено Тогда
		Организация = СсылкаИзJSON(Описание);
		Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
			ВызватьИсключение "organization должна быть ссылкой на Справочник.Организации";
		КонецЕсли;
		Возврат Организация;
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 О.Ссылка КАК Ссылка ИЗ Справочник.Организации КАК О ГДЕ НЕ О.ПометкаУдаления");
	Организации = Запрос.Выполнить().Выгрузить();
	Если Организации.Количество() = 1 Тогда
		Возврат Организации[0].Ссылка;
	КонецЕсли;
	ВызватьИсключение "В базе несколько организаций — спроси пользователя, от какой выставить счёт, "
		+ "и передай её в organization (найди через object_find по Справочник.Организации)";

КонецФункции

// Проводит документ, созданный консультантом. Возвращает Структура(Успех, Текст):
// при отказе — сообщения, которые типовой код выдал при проведении.
Функция ПровестиДокумент(Ссылка) Экспорт

	Если Не Метаданные.Документы.Содержит(Ссылка.Метаданные()) Тогда
		ВызватьИсключение "Проводить можно только документы";
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Новый Структура("Успех, Текст", Истина, "Документ проведён");
	Исключение
		Тексты = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		Если Тексты.Количество() = 0 Тогда
			Тексты.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		Возврат Новый Структура("Успех, Текст", Ложь, "Не проведён: " + СтрСоединить(Тексты, "; "));
	КонецПопытки;

КонецФункции

// Создаёт документ на основании другого (типовой механизм «ввод на основании»): заполнение
// делает сама конфигурация, как при команде «Создать на основании» в форме.
Функция СоздатьНаОсновании(ТекстВызова) Экспорт

	Аргументы = ИзJSON(ТекстВызова).Получить("args");
	Основание = СсылкаИзJSON(Аргументы.Получить("base"));
	МДОснования = Основание.Метаданные();
	МД = Метаданные.НайтиПоПолномуИмени(Строка(Аргументы.Получить("target")));
	Если МД = Неопределено Или Не Метаданные.Документы.Содержит(МД) Тогда
		ВызватьИсключение "target должен быть документом, например «Документ.СчетФактураВыданный»";
	КонецЕсли;
	Если Не МД.ВводитсяНаОсновании.Содержит(МДОснования) Тогда
		Возможные = Новый Массив;
		Для Каждого Документ Из Метаданные.Документы Цикл
			Если Документ.ВводитсяНаОсновании.Содержит(МДОснования) И Возможные.Количество() < 20 Тогда
				Возможные.Добавить(Документ.ПолноеИмя());
			КонецЕсли;
		КонецЦикла;
		ВызватьИсключение МД.ПолноеИмя() + " не вводится на основании " + МДОснования.ПолноеИмя()
			+ ". Можно: " + СтрСоединить(Возможные, ", ");
	КонецЕсли;
	Если Не ПравоДоступа("Добавление", МД) Тогда
		ВызватьИсключение "У пользователя нет права добавлять " + МД.Синоним;
	КонецЕсли;

	Объект = Документы[МД.Имя].СоздатьДокумент();
	Объект.Заполнить(Основание);
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если МД.Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Объект.Комментарий = СокрЛП("Создан ИИ-консультантом. " + ?(ЗначениеЗаполнено(Объект.Комментарий), Объект.Комментарий, ""));
	КонецЕсли;
	Объект.ДополнительныеСвойства.Вставить("ЗаполнитьСчетаУчетаПередЗаписью", Истина);
	Объект.Записать(РежимЗаписиДокумента.Запись);
	Замечания = "";
	Если Не Объект.ПроверитьЗаполнение() Тогда
		Замечания = ТекстыСообщений();
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Описание, ЭтоДокумент", Объект.Ссылка, ОписаниеОбъекта(Объект, МД, Замечания), Истина);

КонецФункции

// Отмена проведения существующего документа (по решению пользователя в окне 1С).
Функция ОтменитьПроведениеДокумента(Ссылка) Экспорт

	Если Не Метаданные.Документы.Содержит(Ссылка.Метаданные()) Тогда
		ВызватьИсключение "Отменять проведение можно только у документов";
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Попытка
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Возврат Новый Структура("Успех, Текст", Истина, "Проведение отменено");
	Исключение
		Возврат Новый Структура("Успех, Текст", Ложь, "Не удалось отменить проведение: " + ТекстыСообщений());
	КонецПопытки;

КонецФункции

// Имя формы списка и отбор для open_list: значения отбора приводим к типам реквизитов
// (наименование → ссылка), чтобы клиент открыл список уже с отбором.
Функция ПараметрыСписка(ТекстВызова) Экспорт

	Аргументы = ИзJSON(ТекстВызова).Получить("args");
	МД = Метаданные.НайтиПоПолномуИмени(Строка(Аргументы.Получить("full_name")));
	Если МД = Неопределено Или Не (Метаданные.Документы.Содержит(МД) Или Метаданные.Справочники.Содержит(МД)) Тогда
		ВызватьИсключение "Открыть можно список документа или справочника, например «Документ.СчетНаОплатуПокупателю»";
	КонецЕсли;
	Отбор = Новый Структура;
	Поля = Аргументы.Получить("filters");
	Если ТипЗнч(Поля) = Тип("Соответствие") Тогда
		Для Каждого Поле Из Поля Цикл
			Отбор.Вставить(Поле.Ключ, ПривестиЗначение(Поле.Значение, ТипРеквизита(МД, Поле.Ключ), Поле.Ключ));
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("ИмяФормы, Отбор, Представление", МД.ПолноеИмя() + ".ФормаСписка", Отбор, МД.Синоним);

КонецФункции

// Ответ агенту о результате действия с объектом: ссылка, представление и итог выбора пользователя.
Функция ОтветДействияJSON(Ид, Ссылка, Итог, Успех = Истина) Экспорт

	МД = Ссылка.Метаданные();
	Результат = ЗначениеДляJSON(Ссылка);
	Результат.Вставить("outcome", Итог);
	Если Метаданные.Документы.Содержит(МД) Тогда
		Результат.Вставить("kind", "document");
		Результат.Вставить("posted", Ссылка.Проведен);
		Если МД.Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
			Результат.Вставить("sum", Ссылка.СуммаДокумента);
		КонецЕсли;
	Иначе
		Результат.Вставить("kind", "catalog");
		Результат.Вставить("deleted", Ссылка.ПометкаУдаления);
	КонецЕсли;
	Возврат ОтветJSON(Ид, Успех, ВJSON(Результат), , Итог);

КонецФункции

// Отмена создания элемента справочника по выбору пользователя: только пометка на удаление,
// физически удаляет администратор обычной обработкой.
Функция ПометитьНаУдаление(Ссылка) Экспорт

	Объект = Ссылка.ПолучитьОбъект();
	Объект.УстановитьПометкуУдаления(Истина);
	Возврат Истина;

КонецФункции

Функция ОписаниеСчета(Документ)

	Строки = Новый Массив;
	Строки.Добавить(Строка(Документ.Ссылка));
	Строки.Добавить("Покупатель: " + Документ.Контрагент);
	Если ЗначениеЗаполнено(Документ.ДоговорКонтрагента) Тогда
		Строки.Добавить("Договор: " + Документ.ДоговорКонтрагента);
	КонецЕсли;
	Строки.Добавить("Организация: " + Документ.Организация);
	Для Каждого Товар Из Документ.Товары Цикл
		Строки.Добавить("" + Товар.НомерСтроки + ". " + Товар.Номенклатура + " — "
			+ Формат(Товар.Количество, "ЧГ=") + " × " + Формат(Товар.Цена, "ЧДЦ=2; ЧГ=") + " = "
			+ Формат(Товар.Сумма, "ЧДЦ=2; ЧГ=") + " (НДС " + Товар.СтавкаНДС + ": "
			+ Формат(Товар.СуммаНДС, "ЧДЦ=2; ЧН=0; ЧГ=") + ")");
	КонецЦикла;
	Строки.Добавить("Итого: " + Формат(Документ.СуммаДокумента, "ЧДЦ=2; ЧГ=") + " руб."
		+ ?(Документ.СуммаВключаетНДС, " (НДС в сумме)", " (НДС сверху)"));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции


// Создаёт документ (черновиком, без проведения) или элемент справочника по описанию агента.
//
// Аргументы вызова: full_name, fields {Реквизит: значение}, tables {ТабличнаяЧасть: [{Колонка: значение}]}.
// Значения приводятся к типу реквизита: ссылку на справочник можно передать наименованием
// (найдём сами, при неоднозначности — ошибка со списком вариантов), перечисление — именем
// или синонимом значения, дату — строкой ISO.
//
// Возвращаемое значение:
//   Структура - Ссылка, Описание (текст для диалога), ЭтоДокумент
//
Функция СоздатьОбъект(ТекстВызова) Экспорт

	Аргументы = ИзJSON(ТекстВызова).Получить("args");
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Нет аргументов вызова";
	КонецЕсли;
	ПолноеИмя = Аргументы.Получить("full_name");
	МД = Метаданные.НайтиПоПолномуИмени(Строка(ПолноеИмя));
	Если МД = Неопределено Тогда
		ВызватьИсключение "Нет объекта метаданных " + ПолноеИмя + ". Найди точное имя через metadata_search.";
	КонецЕсли;
	ЭтоДокумент = Метаданные.Документы.Содержит(МД);
	Если Не ЭтоДокумент И Не Метаданные.Справочники.Содержит(МД) Тогда
		ВызватьИсключение "Создавать можно только документы и элементы справочников";
	КонецЕсли;
	Если ЗапрещеноСоздавать(МД) Тогда
		ВызватьИсключение "Создание " + МД.ПолноеИмя() + " через консультанта запрещено (служебный справочник)";
	КонецЕсли;
	Если Не ПравоДоступа("Добавление", МД) Тогда
		ВызватьИсключение "У пользователя нет права добавлять " + МД.Синоним;
	КонецЕсли;

	Если ЭтоДокумент Тогда
		Объект = Документы[МД.Имя].СоздатьДокумент();
		Объект.Дата = ТекущаяДатаСеанса();
	Иначе
		Объект = Справочники[МД.Имя].СоздатьЭлемент();
	КонецЕсли;

	// Значения шапки — через типовое заполнение (умолчания ОбработкаЗаполнения), затем поверх него:
	// конфигурация может переопределить часть значений своими умолчаниями.
	ЗначенияШапки = Новый Структура;
	Поля = Аргументы.Получить("fields");
	Если ТипЗнч(Поля) = Тип("Соответствие") Тогда
		Для Каждого Поле Из Поля Цикл
			Тип = ТипРеквизита(МД, Поле.Ключ);
			ЗначенияШапки.Вставить(Поле.Ключ, ПривестиЗначение(Поле.Значение, Тип, Поле.Ключ));
		КонецЦикла;
	КонецЕсли;
	ПодставитьОрганизацию(МД, ЗначенияШапки);
	Объект.Заполнить(ЗначенияШапки);
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияШапки);
	// Частая путаница модели: название кладёт в НаименованиеПолное, а основное оставляет пустым.
	Если Не ЭтоДокумент И ЗначенияШапки.Свойство("НаименованиеПолное") И Не ЗначенияШапки.Свойство("Наименование")
		И ДлинаСвойства(МД, "Наименование") > 0 Тогда
		Объект.Наименование = Лев(ЗначенияШапки.НаименованиеПолное, МД.ДлинаНаименования);
	КонецЕсли;

	Таблицы = Аргументы.Получить("tables");
	Если ТипЗнч(Таблицы) = Тип("Соответствие") Тогда
		Для Каждого Таблица Из Таблицы Цикл
			ЗаполнитьТабличнуюЧасть(Объект, МД, Таблица.Ключ, Таблица.Значение);
		КонецЦикла;
	КонецЕсли;

	Если МД.Реквизиты.Найти("Комментарий") <> Неопределено Тогда
		Объект.Комментарий = СокрЛП("Создан ИИ-консультантом. " + ?(ЗначениеЗаполнено(Объект.Комментарий), Объект.Комментарий, ""));
	КонецЕсли;

	Замечания = "";
	Если ЭтоДокумент Тогда
		Объект.Записать(РежимЗаписиДокумента.Запись); // черновик
		// Настоящая проверка конфигурации (ОбработкаПроверкиЗаполнения снимает условно-обязательные
		// реквизиты) — ровно то, что помешает провести; показываем в окне, документ уже записан.
		Если Не Объект.ПроверитьЗаполнение() Тогда
			Замечания = ТекстыСообщений();
		КонецЕсли;
	Иначе
		Если Не Объект.ПроверитьЗаполнение() Тогда
			ВызватьИсключение "Элемент не записан: " + ТекстыСообщений();
		КонецЕсли;
		Объект.Записать();
	КонецЕсли;

	Возврат Новый Структура("Ссылка, Описание, ЭтоДокумент", Объект.Ссылка, ОписаниеОбъекта(Объект, МД, Замечания), ЭтоДокумент);

КонецФункции

// Типовое заполнение БП не всегда подставляет организацию (зависит от настроек пользователя),
// а от неё зависят банковский счёт, договор и прочие умолчания — задаём её до заполнения.
Процедура ПодставитьОрганизацию(МД, ЗначенияШапки)

	Реквизит = МД.Реквизиты.Найти("Организация");
	Если Реквизит = Неопределено Или ЗначенияШапки.Свойство("Организация") Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Организация = ОрганизацияДляДокумента(Неопределено);
	Исключение
		Если Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку Тогда
			ВызватьИсключение "В базе несколько организаций — спроси пользователя, какую указать, и передай её "
				+ "в fields.Организация (наименованием)";
		КонецЕсли;
		Возврат;
	КонецПопытки;
	Если Реквизит.Тип.СодержитТип(ТипЗнч(Организация)) Тогда
		ЗначенияШапки.Вставить("Организация", Организация);
	КонецЕсли;

КонецПроцедуры

// Служебные справочники прав и учётных записей — только руками администратора.
Функция ЗапрещеноСоздавать(МД)

	Запрещенные = СтрРазделить("Пользователи,ВнешниеПользователи,ГруппыПользователей,ГруппыВнешнихПользователей,"
		+ "ГруппыДоступа,ПрофилиГруппДоступа,УчетныеЗаписиЭлектроннойПочты,ДополнительныеОтчетыИОбработки,"
		+ "ВерсииРасширений,ПрограммыЭлектроннойПодписиИШифрования,СертификатыКлючейЭлектроннойПодписиИШифрования", ",");
	Возврат Метаданные.Справочники.Содержит(МД) И Запрещенные.Найти(МД.Имя) <> Неопределено;

КонецФункции

Функция ТипРеквизита(МД, Имя, ТабличнаяЧасть = Неопределено)

	Владелец = ?(ТабличнаяЧасть = Неопределено, МД, ТабличнаяЧасть);
	Реквизит = Владелец.Реквизиты.Найти(Имя);
	Если Реквизит = Неопределено И ТабличнаяЧасть = Неопределено Тогда
		Для Каждого Стандартный Из МД.СтандартныеРеквизиты Цикл
			Если Стандартный.Имя = Имя Тогда
				Реквизит = Стандартный;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Реквизит = Неопределено Тогда
		ВызватьИсключение "У " + Владелец.ПолноеИмя() + " нет реквизита «" + Имя + "» — посмотри metadata_describe";
	КонецЕсли;
	Возврат Реквизит.Тип;

КонецФункции

Процедура ЗаполнитьТабличнуюЧасть(Объект, МД, ИмяТабличнойЧасти, Строки)

	ТабличнаяЧасть = МД.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	Если ТабличнаяЧасть = Неопределено Тогда
		ВызватьИсключение "У " + МД.ПолноеИмя() + " нет табличной части «" + ИмяТабличнойЧасти + "»";
	КонецЕсли;
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		ВызватьИсключение "tables." + ИмяТабличнойЧасти + " должна быть массивом строк";
	КонецЕсли;
	Приемник = Объект[ИмяТабличнойЧасти];
	Приемник.Очистить();
	Для Каждого ОписаниеСтроки Из Строки Цикл
		НоваяСтрока = Приемник.Добавить();
		Для Каждого Поле Из ОписаниеСтроки Цикл
			Тип = ТипРеквизита(МД, Поле.Ключ, ТабличнаяЧасть);
			НоваяСтрока[Поле.Ключ] = ПривестиЗначение(Поле.Значение, Тип, ИмяТабличнойЧасти + "." + Поле.Ключ);
		КонецЦикла;
		// Единственный пересчёт, общий для всех конфигураций: сумма строки.
		ЕстьКолонки = ТабличнаяЧасть.Реквизиты.Найти("Количество") <> Неопределено
			И ТабличнаяЧасть.Реквизиты.Найти("Цена") <> Неопределено
			И ТабличнаяЧасть.Реквизиты.Найти("Сумма") <> Неопределено;
		Если ЕстьКолонки И Не ЗначениеЗаполнено(НоваяСтрока.Сумма) Тогда
			НоваяСтрока.Сумма = Окр(НоваяСтрока.Количество * НоваяСтрока.Цена, 2);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Приводит значение от агента к типу реквизита. Текст для ссылочного типа ищется по
// наименованию (и коду): так модели не нужно сначала искать каждую ссылку.
// Отбор object_find по реквизитам шапки: {"Контрагент": ссылка или наименование, "Организация": …}.
// Возвращает условия «Т.Имя = &ФN» и значения параметров; значение приводится к типу реквизита
// (строка — поиском по наименованию, как в object_create).
Функция ОтборПоРеквизитам(МД, Отборы)

	Результат = Новый Структура("Условия, Значения", Новый Массив, Новый Соответствие);
	Если ТипЗнч(Отборы) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;
	Номер = 0;
	Для Каждого Пара Из Отборы Цикл
		Имя = СокрЛП(Строка(Пара.Ключ));
		Реквизит = МД.Реквизиты.Найти(Имя);
		Если Реквизит = Неопределено Тогда
			Если Имя = "Дата" Или Имя = "Номер" Или Имя = "Проведен" Тогда
				ВызватьИсключение "filters: по полю " + Имя + " ищи текстом (text) — отбор только по реквизитам шапки";
			КонецЕсли;
			ВызватьИсключение "filters: у " + МД.ПолноеИмя() + " нет реквизита " + Имя + " — смотри metadata_describe";
		КонецЕсли;
		Номер = Номер + 1;
		Результат.Условия.Добавить("Т." + Имя + " = &Ф" + Номер);
		Результат.Значения.Вставить("Ф" + Номер, ПривестиЗначение(Пара.Значение, Реквизит.Тип, Имя));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПривестиЗначение(Значение, ОписаниеТипов, ИмяПоля)

	Если Значение = Неопределено Тогда
		Возврат ОписаниеТипов.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Соответствие") И Значение.Получить("_ref") <> Неопределено Тогда
		Ссылка = СсылкаИзJSON(Значение);
		Если Не ОписаниеТипов.СодержитТип(ТипЗнч(Ссылка)) Тогда
			ВызватьИсключение ИмяПоля + ": ссылка " + Значение.Получить("_ref") + " не подходит по типу";
		КонецЕсли;
		Возврат Ссылка;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Если ОписаниеТипов.СодержитТип(ТипЗнч(Значение)) Тогда
			Возврат Значение;
		КонецЕсли;
		Значение = Формат(Значение, "ЧРД=.; ЧГ=; БЛ=false; БИ=true");
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Ошибки = Новый Массив;
	Для Каждого Т Из ОписаниеТипов.Типы() Цикл
		Если Т = Тип("Строка") Тогда
			Возврат ОписаниеТипов.ПривестиЗначение(Текст);
		ИначеЕсли Т = Тип("Число") Тогда
			Попытка
				Возврат Число(СтрЗаменить(СтрЗаменить(Текст, " ", ""), ",", "."));
			Исключение
				Ошибки.Добавить("не число");
			КонецПопытки;
		ИначеЕсли Т = Тип("Дата") Тогда
			Дата = ЗначениеИзJSON(Текст);
			Если ТипЗнч(Дата) = Тип("Дата") Тогда
				Возврат Дата;
			КонецЕсли;
			Ошибки.Добавить("дату пиши как 2026-10-26");
		ИначеЕсли Т = Тип("Булево") Тогда
			Возврат СтрНайти("|да|истина|true|1|", "|" + НРег(Текст) + "|") > 0;
		Иначе
			МДТ = Метаданные.НайтиПоТипу(Т);
			Если МДТ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Найдено = НайтиПоПредставлению(МДТ, Текст, Ошибки);
			Если Найдено <> Неопределено Тогда
				Возврат Найдено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение ИмяПоля + " = «" + Текст + "»: " + ?(Ошибки.Количество() > 0, СтрСоединить(Ошибки, "; "),
		"значение не подходит по типу");

КонецФункции

Функция НайтиПоПредставлению(МДТ, Текст, Ошибки)

	Если Метаданные.Перечисления.Содержит(МДТ) Тогда
		Для Каждого ЗначениеПеречисления Из МДТ.ЗначенияПеречисления Цикл
			Если БезЁ(ЗначениеПеречисления.Имя) = БезЁ(Текст) Или БезЁ(ЗначениеПеречисления.Синоним) = БезЁ(Текст) Тогда
				Возврат Перечисления[МДТ.Имя][ЗначениеПеречисления.Имя];
			КонецЕсли;
		КонецЦикла;
		Ошибки.Добавить("в " + МДТ.ПолноеИмя() + " нет значения, допустимые: " + ЗначенияПеречисления(МДТ));
		Возврат Неопределено;
	КонецЕсли;
	Если Не (Метаданные.Справочники.Содержит(МДТ) Или Метаданные.ПланыВидовХарактеристик.Содержит(МДТ)
		Или Метаданные.ПланыСчетов.Содержит(МДТ)) Тогда
		Ошибки.Добавить(МДТ.ПолноеИмя() + " передавай ссылкой {_ref, uuid}");
		Возврат Неопределено;
	КонецЕсли;

	Условия = Новый Массив;
	Если ДлинаСвойства(МДТ, "Наименование") > 0 Тогда
		Условия.Добавить("Т.Наименование = &Текст");
	КонецЕсли;
	Если ДлинаСвойства(МДТ, "Код") > 0 Тогда
		Условия.Добавить("Т.Код = &Текст");
	КонецЕсли;
	Если Условия.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 6 Т.Ссылка КАК Ссылка, ПРЕДСТАВЛЕНИЕ(Т.Ссылка) КАК Имя ИЗ " + МДТ.ПолноеИмя()
		+ " КАК Т ГДЕ НЕ Т.ПометкаУдаления И (" + СтрСоединить(Условия, " ИЛИ ") + ")");
	Запрос.УстановитьПараметр("Текст", Текст);
	Найдено = Запрос.Выполнить().Выгрузить();
	Если Найдено.Количество() = 0 И ДлинаСвойства(МДТ, "Наименование") > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Т.Наименование = &Текст", "Т.Наименование ПОДОБНО &Образец");
		Образец = Текст;
		Для Каждого Символ Из СтрРазделить("%,_,[,],^,~", ",") Цикл
			Образец = СтрЗаменить(Образец, Символ, "");
		КонецЦикла;
		Запрос.УстановитьПараметр("Образец", "%" + Образец + "%");
		Найдено = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	Если Найдено.Количество() = 1 Тогда
		Возврат Найдено[0].Ссылка;
	ИначеЕсли Найдено.Количество() = 0 Тогда
		Ошибки.Добавить("в " + МДТ.ПолноеИмя() + " не найдено — уточни у пользователя или создай элемент");
	Иначе
		Ошибки.Добавить("в " + МДТ.ПолноеИмя() + " несколько подходящих: «"
			+ СтрСоединить(Найдено.ВыгрузитьКолонку("Имя"), "», «") + "» — уточни у пользователя");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ЗначенияПеречисления(МДТ)

	Имена = Новый Массив;
	Для Каждого ЗначениеПеречисления Из МДТ.ЗначенияПеречисления Цикл
		Если Имена.Количество() >= 15 Тогда
			Имена.Добавить("…");
			Прервать;
		КонецЕсли;
		Имена.Добавить(ЗначениеПеречисления.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

Функция ТекстыСообщенийМассивом()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат Тексты;

КонецФункции

Функция ТекстыСообщений()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат ?(Тексты.Количество() = 0, "проверка заполнения не прошла", СтрСоединить(Тексты, "; "));

КонецФункции

// Текст для окна после создания: заполненные реквизиты, строки табличных частей и
// замечания проверки заполнения — чтобы пользователь видел, что проверить перед проведением.
Функция ОписаниеОбъекта(Объект, МД, Замечания)

	Строки = Новый Массив;
	Строки.Добавить(Строка(Объект.Ссылка));
	Пропуск = "|Ссылка|ВерсияДанных|ПометкаУдаления|Проведен|Предопределенный|ИмяПредопределенныхДанных|Номер|Дата|Код|";
	Показано = 0;
	Для Каждого Реквизит Из МД.Реквизиты Цикл
		Значение = Объект[Реквизит.Имя];
		// Флажки и служебные поля — шум для пользователя: показываем только содержательное.
		Если Не ЗначениеЗаполнено(Значение) Или ТипЗнч(Значение) = Тип("Булево")
			Или ТипЗнч(Значение) = Тип("ХранилищеЗначения") Или Строка(Значение) = "Нет" Или Показано >= 14 Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(?(ЗначениеЗаполнено(Реквизит.Синоним), Реквизит.Синоним, Реквизит.Имя) + ": "
			+ Лев(Строка(Значение), 80));
		Показано = Показано + 1;
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из МД.ТабличныеЧасти Цикл
		Данные = Объект[ТабличнаяЧасть.Имя];
		Если Данные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(?(ЗначениеЗаполнено(ТабличнаяЧасть.Синоним), ТабличнаяЧасть.Синоним, ТабличнаяЧасть.Имя)
			+ ": строк " + Данные.Количество());
		Для Каждого СтрокаДанных Из Данные Цикл
			Если СтрокаДанных.НомерСтроки > 5 Тогда
				Строки.Добавить("  …");
				Прервать;
			КонецЕсли;
			Значения = Новый Массив;
			Для Каждого Колонка Из ТабличнаяЧасть.Реквизиты Цикл
				Если ЗначениеЗаполнено(СтрокаДанных[Колонка.Имя]) И Значения.Количество() < 5 Тогда
					Значения.Добавить(Строка(СтрокаДанных[Колонка.Имя]));
				КонецЕсли;
			КонецЦикла;
			Строки.Добавить("  " + СтрокаДанных.НомерСтроки + ". " + СтрСоединить(Значения, " · "));
		КонецЦикла;
	КонецЦикла;
	Если ЗначениеЗаполнено(Замечания) Тогда
		Строки.Добавить("");
		Строки.Добавить("⚠ Перед проведением исправить: " + Замечания);
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции


// Изменение реквизитов существующего объекта в два шага: сначала считаем разницу «было → станет»
// и показываем её пользователю в окне 1С, записываем — только после согласия. Версия данных
// защищает от записи поверх чужих правок, сделанных, пока окно было открыто.
Функция ПодготовитьИзменение(ТекстВызова) Экспорт

	Аргументы = ИзJSON(ТекстВызова).Получить("args");
	Ссылка = СсылкаИзJSON(Аргументы.Получить("ref"));
	Объект = Ссылка.ПолучитьОбъект();
	Изменения = ИзмененияОбъекта(Объект, Аргументы.Получить("fields"));
	Строки = Новый Массив;
	Строки.Добавить(Строка(Ссылка));
	Строки.Добавить("");
	Для Каждого Изменение Из Изменения Цикл
		Строки.Добавить(Изменение.Представление + ": " + ?(ЗначениеЗаполнено(Изменение.Было), Лев(Строка(Изменение.Было), 80), "(пусто)")
			+ "  →  " + ?(ЗначениеЗаполнено(Изменение.Стало), Лев(Строка(Изменение.Стало), 80), "(пусто)"));
	КонецЦикла;
	Если Метаданные.Документы.Содержит(Ссылка.Метаданные()) И Ссылка.Проведен Тогда
		Строки.Добавить("");
		Строки.Добавить("Документ проведён — после изменения будет перепроведён.");
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Описание, ВерсияДанных", Ссылка, СтрСоединить(Строки, Символы.ПС), Объект.ВерсияДанных);

КонецФункции

Функция ПрименитьИзменение(ТекстВызова, ВерсияДанных) Экспорт

	Аргументы = ИзJSON(ТекстВызова).Получить("args");
	Ссылка = СсылкаИзJSON(Аргументы.Получить("ref"));
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект.ВерсияДанных <> ВерсияДанных Тогда
		Возврат Новый Структура("Успех, Текст", Ложь,
			"Объект изменили, пока окно подтверждения было открыто — ничего не записано, покажи изменения заново");
	КонецЕсли;
	Изменения = ИзмененияОбъекта(Объект, Аргументы.Получить("fields"));
	Для Каждого Изменение Из Изменения Цикл
		Объект[Изменение.Имя] = Изменение.Стало;
	КонецЦикла;
	ЭтоДокумент = Метаданные.Документы.Содержит(Ссылка.Метаданные());
	Попытка
		Если ЭтоДокумент И Объект.Проведен Тогда
			Объект.Записать(РежимЗаписиДокумента.Проведение);
			Текст = "изменено и перепроведено";
		ИначеЕсли ЭтоДокумент Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Текст = "изменено";
		Иначе
			Если Не Объект.ПроверитьЗаполнение() Тогда
				Возврат Новый Структура("Успех, Текст", Ложь, "Не записано: " + ТекстыСообщений());
			КонецЕсли;
			Объект.Записать();
			Текст = "изменено";
		КонецЕсли;
	Исключение
		Тексты = ТекстыСообщенийМассивом();
		Если Тексты.Количество() = 0 Тогда
			Тексты.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		Возврат Новый Структура("Успех, Текст", Ложь, "Не записано (в базе ничего не изменилось): " + СтрСоединить(Тексты, "; "));
	КонецПопытки;
	Имена = Новый Массив;
	Для Каждого Изменение Из Изменения Цикл
		Имена.Добавить(Изменение.Имя);
	КонецЦикла;
	Возврат Новый Структура("Успех, Текст", Истина, Текст + ": " + СтрСоединить(Имена, ", "));

КонецФункции

Функция ИзмененияОбъекта(Объект, Поля)

	МД = Объект.Метаданные();
	Если Не (Метаданные.Документы.Содержит(МД) Или Метаданные.Справочники.Содержит(МД)) Тогда
		ВызватьИсключение "Изменять можно документы и элементы справочников";
	КонецЕсли;
	Если Не ПравоДоступа("Изменение", МД) Тогда
		ВызватьИсключение "У пользователя нет права изменять " + МД.Синоним;
	КонецЕсли;
	Если Метаданные.Справочники.Содержит(МД) И ЗапрещеноСоздавать(МД) Тогда
		ВызватьИсключение "Изменение " + МД.ПолноеИмя() + " через консультанта запрещено (служебный справочник)";
	КонецЕсли;
	Если ТипЗнч(Поля) <> Тип("Соответствие") Или Поля.Количество() = 0 Тогда
		ВызватьИсключение "fields — что изменить: {Реквизит: новое значение}";
	КонецЕсли;
	Служебные = "|Ссылка|ВерсияДанных|ПометкаУдаления|Проведен|Предопределенный|ИмяПредопределенныхДанных|ЭтоГруппа|";
	Изменения = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Если СтрНайти(Служебные, "|" + Поле.Ключ + "|") > 0 Тогда
			ВызватьИсключение "«" + Поле.Ключ + "» так не меняется: проведение — document_post / document_unpost, удаление — только пользователь сам";
		КонецЕсли;
		Тип = ТипРеквизита(МД, Поле.Ключ);
		Стало = ПривестиЗначение(Поле.Значение, Тип, Поле.Ключ);
		Было = Объект[Поле.Ключ];
		Если Было = Стало Тогда
			Продолжить;
		КонецЕсли;
		Реквизит = МД.Реквизиты.Найти(Поле.Ключ);
		Представление = ?(Реквизит <> Неопределено И ЗначениеЗаполнено(Реквизит.Синоним), Реквизит.Синоним, Поле.Ключ);
		Изменения.Добавить(Новый Структура("Имя, Представление, Было, Стало", Поле.Ключ, Представление, Было, Стало));
	КонецЦикла;
	Если Изменения.Количество() = 0 Тогда
		ВызватьИсключение "Значения уже такие — менять нечего";
	КонецЕсли;
	Возврат Изменения;

КонецФункции

#КонецОбласти

#Область Инструменты

Функция ПоискМетаданных(Аргументы, Сводка)

	Слова = СтрРазделить(БезЁ(СокрЛП(Строка(Аргументы.Получить("query")))), " ", Ложь);
	Вид = Аргументы.Получить("kind");
	Лимит = 40;

	Найдено = Новый Массив;
	Всего = 0;
	Для Каждого Коллекция Из КоллекцииМетаданных() Цикл
		Если ЗначениеЗаполнено(Вид) И НРег(Коллекция.Вид) <> НРег(Вид) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Объект Из Коллекция.Объекты Цикл
			Текст = БезЁ(Объект.Имя + " " + Объект.Синоним);
			Подходит = Истина;
			Для Каждого Слово Из Слова Цикл
				Если СтрНайти(Текст, Слово) = 0 Тогда
					Подходит = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не Подходит Тогда
				Продолжить;
			КонецЕсли;
			Всего = Всего + 1;
			Если Найдено.Количество() < Лимит Тогда
				Элемент = Новый Соответствие;
				Элемент.Вставить("full_name", Объект.ПолноеИмя());
				Элемент.Вставить("synonym", Объект.Синоним);
				Найдено.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Сводка = "найдено " + Всего + ?(Всего > Лимит, ", показаны первые " + Лимит, "");
	Результат = Новый Соответствие;
	Результат.Вставить("items", Найдено);
	Результат.Вставить("total", Всего);
	Возврат Результат;

КонецФункции

Функция ОписаниеМетаданных(Аргументы, Сводка)

	ПолноеИмя = Аргументы.Получить("full_name");
	МД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МД = Неопределено Тогда
		ВызватьИсключение "Нет объекта метаданных " + ПолноеИмя + ". Найди точное имя через metadata_search.";
	КонецЕсли;

	Результат = Новый Соответствие;
	Результат.Вставить("full_name", МД.ПолноеИмя());
	Результат.Вставить("synonym", МД.Синоним);

	Попытка
		Стандартные = Новый Массив;
		Для Каждого Реквизит Из МД.СтандартныеРеквизиты Цикл
			Стандартные.Добавить(Реквизит.Имя
				+ ?(Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку, " [обязательный]", ""));
		КонецЦикла;
		Результат.Вставить("standard_attributes", СтрСоединить(Стандартные, ", "));
	Исключение
		// у вида объекта нет стандартных реквизитов
	КонецПопытки;

	Попытка
		ДобавитьПоля(Результат, "dimensions", МД.Измерения);
	Исключение
		// не регистр
	КонецПопытки;
	Попытка
		ДобавитьПоля(Результат, "resources", МД.Ресурсы);
	Исключение
		// не регистр
	КонецПопытки;
	Попытка
		ДобавитьПоля(Результат, "attributes", МД.Реквизиты);
	Исключение
		// нет реквизитов
	КонецПопытки;

	Попытка
		Таблицы = Новый Соответствие;
		Для Каждого ТабличнаяЧасть Из МД.ТабличныеЧасти Цикл
			Таблицы.Вставить(ТабличнаяЧасть.Имя, ОписаниеПолей(ТабличнаяЧасть.Реквизиты));
		КонецЦикла;
		Если Таблицы.Количество() > 0 Тогда
			Результат.Вставить("tabular_sections", Таблицы);
		КонецЕсли;
	Исключение
		// нет табличных частей
	КонецПопытки;

	Попытка
		Движения = Новый Массив;
		Для Каждого Регистр Из МД.Движения Цикл
			Движения.Добавить(Регистр.ПолноеИмя());
		КонецЦикла;
		Результат.Вставить("register_records", Движения);
	Исключение
		// не документ
	КонецПопытки;

	Попытка
		Результат.Вставить("register_kind", Строка(МД.ВидРегистра));
	Исключение
		// не регистр накопления
	КонецПопытки;

	Попытка
		Значения = Новый Массив;
		Для Каждого Значение Из МД.ЗначенияПеречисления Цикл
			Значения.Добавить(Значение.Имя);
		КонецЦикла;
		Результат.Вставить("enum_values", СтрСоединить(Значения, ", "));
	Исключение
		// не перечисление
	КонецПопытки;

	Сводка = МД.ПолноеИмя();
	Возврат Результат;

КонецФункции

Функция ПоискОбъектов(Аргументы, Сводка)

	ПолноеИмя = Аргументы.Получить("full_name");
	МД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МД = Неопределено Тогда
		ВызватьИсключение "Нет объекта метаданных " + ПолноеИмя;
	КонецЕсли;
	Текст = СокрЛП(Строка(Аргументы.Получить("text")));
	Для Каждого Символ Из СтрРазделить("%,_,[,],^,~", ",") Цикл
		Текст = СтрЗаменить(Текст, Символ, "");
	КонецЦикла;
	// В данных «ё» встречается непоследовательно: «_» в ПОДОБНО совпадёт и с «е», и с «ё».
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "ё", "_"), "Ё", "_"), "е", "_"), "Е", "_");
	Лимит = ЛимитИзАргументов(Аргументы, 20, 100);
	// Отбор по реквизитам шапки: {"Контрагент": "Альфа-Инжиниринг"} — документы нужного контрагента,
	// а не все подряд (по номеру их не найти).
	Отбор = ОтборПоРеквизитам(МД, Аргументы.Получить("filters"));
	ДопУсловие = ?(Отбор.Условия.Количество() = 0, "", " И " + СтрСоединить(Отбор.Условия, " И "));

	Если Метаданные.Документы.Содержит(МД) Тогда
		Шаблон = "ВЫБРАТЬ ПЕРВЫЕ %1 Т.Ссылка КАК Ссылка, Т.Дата КАК Дата, Т.Номер КАК Номер, Т.Проведен КАК Проведен
			|ИЗ %2 КАК Т ГДЕ Т.Номер ПОДОБНО &Образец" + ДопУсловие + " УПОРЯДОЧИТЬ ПО Т.Дата УБЫВ";
		// Сначала номера, оканчивающиеся на текст («45» → 0000-000045), потом содержащие.
		Образцы = ЗначениеВМассиве("%" + Текст, "%" + Текст + "%");
	Иначе
		Условия = Новый Массив;
		Если ДлинаСвойства(МД, "Наименование") > 0 Тогда
			Условия.Добавить("Т.Наименование ПОДОБНО &Образец");
		КонецЕсли;
		Если ДлинаСвойства(МД, "Код") > 0 Тогда
			Условия.Добавить("Т.Код ПОДОБНО &Образец");
		КонецЕсли;
		Если Условия.Количество() = 0 Тогда
			ВызватьИсключение "Поиск по тексту для " + ПолноеИмя + " не поддерживается — используй query_run";
		КонецЕсли;
		Шаблон = "ВЫБРАТЬ ПЕРВЫЕ %1 Т.Ссылка КАК Ссылка ИЗ %2 КАК Т ГДЕ (" + СтрСоединить(Условия, " ИЛИ ") + ")"
			+ ДопУсловие + " УПОРЯДОЧИТЬ ПО Т.Ссылка";
		Образцы = ЗначениеВМассиве("%" + Текст + "%");
	КонецЕсли;

	Запрос = Новый Запрос(СтрШаблон(Шаблон, Формат(Лимит, "ЧГ=0"), МД.ПолноеИмя()));
	Для Каждого Пара Из Отбор.Значения Цикл
		Запрос.УстановитьПараметр(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	Найдено = Новый Массив;
	Для Каждого Образец Из Образцы Цикл
		Запрос.УстановитьПараметр("Образец", Образец);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Элемент = ЗначениеДляJSON(Выборка.Ссылка);
			Если ТипЗнч(Элемент) = Тип("Соответствие") И Метаданные.Документы.Содержит(МД) Тогда
				Элемент.Вставить("date", ЗначениеДляJSON(Выборка.Дата));
				Элемент.Вставить("posted", Выборка.Проведен);
			КонецЕсли;
			Найдено.Добавить(Элемент);
		КонецЦикла;
		Если Найдено.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Ни одной подстроки целиком: ищем по словам в любом порядке («Сидоренко Лотос» →
	// «Сидоренко Павел Андреевич ИП (Лотос)»), а для контрагента — ещё и по ИНН.
	Если Найдено.Количество() = 0 И Не Метаданные.Документы.Содержит(МД) Тогда
		Условия = Новый Массив;
		Запрос = Новый Запрос;
		Если МД.Реквизиты.Найти("ИНН") <> Неопределено И СтрДлина(Текст) >= 10 И СтрНайти(Текст, " ") = 0 Тогда
			Условия.Добавить("Т.ИНН = &ИНН");
			Запрос.УстановитьПараметр("ИНН", Текст);
		ИначеЕсли ДлинаСвойства(МД, "Наименование") > 0 Тогда
			Номер = 0;
			Для Каждого Слово Из СтрРазделить(Текст, " ,.«»""()", Ложь) Цикл
				Если СтрДлина(Слово) < 2 Тогда
					Продолжить;
				КонецЕсли;
				Номер = Номер + 1;
				Условия.Добавить("Т.Наименование ПОДОБНО &С" + Номер);
				Запрос.УстановитьПараметр("С" + Номер, "%" + Слово + "%");
			КонецЦикла;
		КонецЕсли;
		Если Условия.Количество() > 0 Тогда
			Запрос.Текст = СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ %1 Т.Ссылка КАК Ссылка ИЗ %2 КАК Т ГДЕ %3 УПОРЯДОЧИТЬ ПО Т.Ссылка",
				Формат(Лимит, "ЧГ=0"), МД.ПолноеИмя(), СтрСоединить(Условия, " И ") + ДопУсловие);
			Для Каждого Пара Из Отбор.Значения Цикл
				Запрос.УстановитьПараметр(Пара.Ключ, Пара.Значение);
			КонецЦикла;
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Найдено.Добавить(ЗначениеДляJSON(Выборка.Ссылка));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Сводка = "найдено " + Найдено.Количество();
	Результат = Новый Соответствие;
	Результат.Вставить("items", Найдено);
	Если Найдено.Количество() = 0 Тогда
		Результат.Вставить("hint", "Ничего не найдено. Попробуй одно самое характерное слово (фамилию, часть названия) или ИНН — "
			+ "прежде чем говорить пользователю, что объекта нет");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ДанныеОбъекта(Аргументы, Сводка)

	Ссылка = СсылкаИзJSON(Аргументы.Получить("ref"));
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение "Объект не найден (битая ссылка): " + Строка(Ссылка);
	КонецЕсли;
	МД = Ссылка.Метаданные();

	Реквизиты = Новый Соответствие;
	Для Каждого Реквизит Из МД.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = "Ссылка" Или Реквизит.Имя = "ВерсияДанных" Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ДобавитьЗаполненное(Реквизиты, Реквизит.Имя, Объект[Реквизит.Имя]);
		Исключение
			// стандартный реквизит недоступен через объект
		КонецПопытки;
	КонецЦикла;
	Для Каждого Реквизит Из МД.Реквизиты Цикл
		ДобавитьЗаполненное(Реквизиты, Реквизит.Имя, Объект[Реквизит.Имя]);
	КонецЦикла;

	Таблицы = Новый Соответствие;
	Для Каждого ТабличнаяЧасть Из МД.ТабличныеЧасти Цикл
		Строки = Объект[ТабличнаяЧасть.Имя];
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Данные = Новый Массив;
		Для Каждого СтрокаТЧ Из Строки Цикл
			Если Данные.Количество() >= 50 Тогда
				Прервать;
			КонецЕсли;
			ДанныеСтроки = Новый Соответствие;
			ДобавитьЗаполненное(ДанныеСтроки, "НомерСтроки", СтрокаТЧ.НомерСтроки);
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				ДобавитьЗаполненное(ДанныеСтроки, Реквизит.Имя, СтрокаТЧ[Реквизит.Имя]);
			КонецЦикла;
			Данные.Добавить(ДанныеСтроки);
		КонецЦикла;
		Таблица = Новый Соответствие;
		Таблица.Вставить("rows_total", Строки.Количество());
		Таблица.Вставить("rows", Данные);
		Таблицы.Вставить(ТабличнаяЧасть.Имя, Таблица);
	КонецЦикла;

	Результат = ЗначениеДляJSON(Ссылка);
	Результат.Вставить("attributes", Реквизиты);
	Если Таблицы.Количество() > 0 Тогда
		Результат.Вставить("tabular_sections", Таблицы);
	КонецЕсли;
	Сводка = Строка(Ссылка);
	Возврат Результат;

КонецФункции

Функция ДвиженияДокумента(Аргументы, Сводка)

	Ссылка = СсылкаИзJSON(Аргументы.Получить("ref"));
	МД = Ссылка.Метаданные();
	Если Не Метаданные.Документы.Содержит(МД) Тогда
		ВызватьИсключение "Движения есть только у документов, а это " + МД.ПолноеИмя();
	КонецЕсли;

	Регистры = Новый Соответствие;
	ВсегоЗаписей = 0;
	Для Каждого Регистр Из МД.Движения Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 50 * ИЗ " + Регистр.ПолноеИмя() + " КАК Т ГДЕ Т.Регистратор = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Продолжить;
		КонецЕсли;
		Записи = Новый Массив;
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись = Новый Соответствие;
			Для Каждого Колонка Из Результат.Колонки Цикл
				Если Колонка.Имя = "Регистратор" Или Колонка.Имя = "МоментВремени" Тогда
					Продолжить;
				КонецЕсли;
				ДобавитьЗаполненное(Запись, Колонка.Имя, Выборка[Колонка.Имя]);
			КонецЦикла;
			Записи.Добавить(Запись);
		КонецЦикла;
		ВсегоЗаписей = ВсегоЗаписей + Записи.Количество();
		Регистры.Вставить(Регистр.ПолноеИмя(), Записи);
	КонецЦикла;

	Сводка = ?(Регистры.Количество() = 0, "движений нет",
		"" + Регистры.Количество() + " регистр(ов), " + ВсегоЗаписей + " записей");
	Ответ = Новый Соответствие;
	Ответ.Вставить("posted", Ссылка.Проведен);
	Ответ.Вставить("registers", Регистры);
	Возврат Ответ;

КонецФункции

Функция ВыполнитьЗапрос(Аргументы, Сводка)

	Текст = Аргументы.Получить("text");
	Если Не ЗначениеЗаполнено(Текст) Тогда
		ВызватьИсключение "Пустой текст запроса";
	КонецЕсли;
	Лимит = ЛимитИзАргументов(Аргументы, 50, 500);

	Запрос = Новый Запрос(Текст);
	Параметры = Аргументы.Получить("params");
	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Для Каждого Параметр Из Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, ЗначениеИзJSON(Параметр.Значение));
		КонецЦикла;
	КонецЕсли;

	Результат = Запрос.Выполнить();
	Колонки = Новый Массив;
	Для Каждого Колонка Из Результат.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Выборка = Результат.Выбрать();
	Всего = Выборка.Количество();
	Пока Выборка.Следующий() И Строки.Количество() < Лимит Цикл
		Значения = Новый Массив;
		Для Каждого Имя Из Колонки Цикл
			Значения.Добавить(ЗначениеДляJSON(Выборка[Имя]));
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;

	Сводка = "" + Всего + " строк" + ?(Всего > Лимит, ", показаны первые " + Лимит, "");
	Ответ = Новый Соответствие;
	Ответ.Вставить("columns", Колонки);
	Ответ.Вставить("rows", Строки);
	Ответ.Вставить("total", Всего);
	Возврат Ответ;

КонецФункции

// Пробное проведение: проводим в транзакции и откатываем. Пользователь получает ровно те
// сообщения, которые увидел бы при проведении, а при успехе — будущие движения; в базе
// ничего не меняется.
Функция ПробноеПроведение(Аргументы, Сводка)

	Ссылка = СсылкаИзJSON(Аргументы.Получить("ref"));
	МД = Ссылка.Метаданные();
	Если Не Метаданные.Документы.Содержит(МД) Тогда
		ВызватьИсключение "Проверять проведение можно только у документов";
	КонецЕсли;
	Если МД.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		ВызватьИсключение МД.ПолноеИмя() + " не проводится";
	КонецЕсли;

	Результат = Новый Соответствие;
	Результат.Вставить("document", ЗначениеДляJSON(Ссылка));
	Результат.Вставить("posted_now", Ссылка.Проведен);
	ПолучитьСообщенияПользователю(Истина);
	ТекстОшибки = "";
	МестоОшибки = Новый Массив;
	НачатьТранзакцию();
	Движения = Неопределено;
	ОшибкаДвижений = "";
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Успех = Истина;
	Исключение
		Успех = Ложь;
		Информация = ИнформацияОбОшибке();
		ТекстОшибки = КраткоеПредставлениеОшибки(Информация);
		МестоОшибки = МестоОшибки(Информация);
	КонецПопытки;
	Если Успех Тогда
		// Чтение будущих движений — отдельно: его сбой не значит, что документ не проводится.
		Попытка
			Движения = ДвиженияДокумента(Аргументы, "");
		Исключение
			ОшибкаДвижений = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Сообщения = ТекстыСообщенийМассивом();
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;

	Результат.Вставить("would_post", Успех);
	Результат.Вставить("messages", Сообщения);
	Если Успех И Движения <> Неопределено Тогда
		Результат.Вставить("movements", Движения.Получить("registers"));
		Сводка = "провёлся бы: " + Движения.Получить("registers").Количество() + " регистр(ов); в базе ничего не изменено";
	ИначеЕсли Успех Тогда
		Результат.Вставить("movements_error", "Документ проводится, но прочитать будущие движения не удалось: " + ОшибкаДвижений);
		Сводка = "провёлся бы; движения прочитать не удалось";
	Иначе
		Результат.Вставить("error", Лев(ТекстОшибки, 1500));
		Если МестоОшибки.Количество() > 0 Тогда
			// Где именно упало: модуль(строка) — передай в code_read, чтобы посмотреть код этого места.
			Результат.Вставить("where", МестоОшибки);
		КонецЕсли;
		Сводка = "не проведётся: " + ?(Сообщения.Количество() > 0, Сообщения[0], Лев(СтрПолучитьСтроку(ТекстОшибки, 1), 200));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Журнал регистрации: по умолчанию ошибки за последние сутки. Нужны права администратора.
Функция ПоискВЖурнале(Аргументы, Сводка)

	Конец = ТекущаяДатаСеанса();
	Начало = Конец - 86400;
	Если Аргументы.Получить("from") <> Неопределено Тогда
		Начало = ЗначениеИзJSON(Аргументы.Получить("from"));
	КонецЕсли;
	Если Аргументы.Получить("to") <> Неопределено Тогда
		Конец = КонецДня(ЗначениеИзJSON(Аргументы.Получить("to")));
	КонецЕсли;
	Отбор = Новый Структура("ДатаНачала, ДатаОкончания", Начало, Конец);
	Уровень = НРег(Строка(Аргументы.Получить("level")));
	Если Уровень = "warning" Тогда
		Уровни = Новый Массив;
		Уровни.Добавить(УровеньЖурналаРегистрации.Ошибка);
		Уровни.Добавить(УровеньЖурналаРегистрации.Предупреждение);
		Отбор.Вставить("Уровень", Уровни);
	ИначеЕсли Уровень <> "all" Тогда
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
	КонецЕсли;
	Пользователь = Аргументы.Получить("user");
	Если Пользователь = "me" Тогда
		Отбор.Вставить("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь());
	ИначеЕсли ЗначениеЗаполнено(Пользователь) Тогда
		Найденный = ПользователиИнформационнойБазы.НайтиПоИмени(Пользователь);
		Если Найденный = Неопределено Тогда
			ВызватьИсключение "Нет пользователя информационной базы «" + Пользователь + "»";
		КонецЕсли;
		Отбор.Вставить("Пользователь", Найденный);
	КонецЕсли;
	Если Аргументы.Получить("ref") <> Неопределено Тогда
		Отбор.Вставить("Данные", СсылкаИзJSON(Аргументы.Получить("ref")));
	КонецЕсли;

	Таблица = Новый ТаблицаЗначений;
	Попытка
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, , , 2000);
	Исключение
		ВызватьИсключение "Журнал регистрации недоступен (нужны права администратора): "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Текст = БезЁ(Строка(Аргументы.Получить("text")));
	Лимит = ЛимитИзАргументов(Аргументы, 30, 100);
	Записи = Новый Массив;
	Всего = 0;
	// Журнал выгружается от старых к новым — идём с конца, чтобы показать свежие.
	Для Индекс = 1 По Таблица.Количество() Цикл
		ЗаписьЖурнала = Таблица[Таблица.Количество() - Индекс];
		Комментарий = ЗаписьЖурнала.Комментарий;
		Если ЗначениеЗаполнено(Текст) И Текст <> "неопределено" И СтрНайти(БезЁ(Комментарий + " " + ЗаписьЖурнала.ПредставлениеСобытия), Текст) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Если Записи.Количество() < Лимит Тогда
			Запись = Новый Соответствие;
			Запись.Вставить("date", ЗаписьЖурнала.Дата);
			Запись.Вставить("user", ЗаписьЖурнала.ИмяПользователя);
			Запись.Вставить("event", ЗаписьЖурнала.ПредставлениеСобытия);
			Запись.Вставить("level", Строка(ЗаписьЖурнала.Уровень));
			Запись.Вставить("data", Строка(ЗаписьЖурнала.ПредставлениеДанных));
			Запись.Вставить("comment", Лев(Комментарий, 700));
			Записи.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Сводка = "записей: " + Всего + ?(Всего > Лимит, ", показаны последние " + Лимит, "");
	Ответ = Новый Соответствие;
	Ответ.Вставить("from", Начало);
	Ответ.Вставить("to", Конец);
	Ответ.Вставить("total", Всего);
	Ответ.Вставить("items", Записи);
	Возврат Ответ;

КонецФункции

// Остатки и обороты регистра без написания запроса: модель называет регистр, период,
// группировки и отборы, а текст запроса к виртуальной таблице строим здесь.
Функция ИтогиРегистра(Аргументы, Сводка, Вид)

	МД = Метаданные.НайтиПоПолномуИмени(Строка(Аргументы.Получить("register")));
	Если МД = Неопределено Тогда
		ВызватьИсключение "Нет регистра " + Аргументы.Получить("register") + ". Пример: «РегистрБухгалтерии.Хозрасчетный»";
	КонецЕсли;
	ЭтоБух = Метаданные.РегистрыБухгалтерии.Содержит(МД);
	Если Не ЭтоБух И Не Метаданные.РегистрыНакопления.Содержит(МД) Тогда
		ВызватьИсключение "Нужен регистр накопления или бухгалтерии";
	КонецЕсли;
	Оборотный = Не ЭтоБух И МД.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты;
	Если Вид = "balance" И Оборотный Тогда
		ВызватьИсключение МД.ПолноеИмя() + " — оборотный регистр, остатков у него нет: используй register_turnover";
	КонецЕсли;

	Доступные = Новый Массив;
	Для Каждого Измерение Из МД.Измерения Цикл
		Доступные.Добавить(Измерение.Имя);
	КонецЦикла;
	Если ЭтоБух Тогда
		Доступные.Добавить("Счет");
		Для Номер = 1 По МД.ПланСчетов.МаксКоличествоСубконто Цикл
			Доступные.Добавить("Субконто" + Номер);
		КонецЦикла;
	КонецЕсли;

	Группировки = Аргументы.Получить("group_by");
	Если ТипЗнч(Группировки) <> Тип("Массив") Тогда
		Группировки = Новый Массив;
		Если ЭтоБух Тогда
			Группировки.Добавить("Счет");
		КонецЕсли;
	КонецЕсли;
	Для Каждого Имя Из Группировки Цикл
		Если Доступные.Найти(Имя) = Неопределено Тогда
			ВызватьИсключение "Группировать можно по: " + СтрСоединить(Доступные, ", ");
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	УсловиеСчета = "";
	Отборы = Аргументы.Получить("filters");
	Если ТипЗнч(Отборы) = Тип("Соответствие") Тогда
		Номер = 0;
		Для Каждого Отбор Из Отборы Цикл
			Номер = Номер + 1;
			Параметр = "П" + Номер;
			Если ЭтоБух И Отбор.Ключ = "Счет" Тогда
				Счет = ?(ТипЗнч(Отбор.Значение) = Тип("Соответствие"), СсылкаИзJSON(Отбор.Значение),
					ПланыСчетов[МД.ПланСчетов.Имя].НайтиПоКоду(Строка(Отбор.Значение)));
				Если Не ЗначениеЗаполнено(Счет) Тогда
					ВызватьИсключение "Нет счёта с кодом «" + Отбор.Значение + "» в плане счетов " + МД.ПланСчетов.Имя;
				КонецЕсли;
				УсловиеСчета = "Счет В ИЕРАРХИИ (&" + Параметр + ")";
				Запрос.УстановитьПараметр(Параметр, Счет);
			ИначеЕсли МД.Измерения.Найти(Отбор.Ключ) <> Неопределено Тогда
				Тип = МД.Измерения.Найти(Отбор.Ключ).Тип;
				Условия.Добавить(Отбор.Ключ + " = &" + Параметр);
				Запрос.УстановитьПараметр(Параметр, ПривестиЗначение(Отбор.Значение, Тип, Отбор.Ключ));
			ИначеЕсли ЭтоБух И СтрНачинаетсяС(Отбор.Ключ, "Субконто") Тогда
				Если ТипЗнч(Отбор.Значение) <> Тип("Соответствие") Тогда
					ВызватьИсключение Отбор.Ключ + ": передай ссылку {_ref, uuid} — найди объект через object_find";
				КонецЕсли;
				Условия.Добавить(Отбор.Ключ + " = &" + Параметр);
				Запрос.УстановитьПараметр(Параметр, СсылкаИзJSON(Отбор.Значение));
			Иначе
				ВызватьИсключение "Отбирать можно по: " + СтрСоединить(Доступные, ", ");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Условие = СтрСоединить(Условия, " И ");
	Если ЭтоБух И СтрНайти(Условие, "Субконто") > 0 Тогда
		// В условии виртуальной таблицы бухрегистра субконто не фильтруются — переносим в ГДЕ.
		УсловиеГДЕ = Условие;
		Условие = "";
	Иначе
		УсловиеГДЕ = "";
	КонецЕсли;

	Ресурсы = Новый Массив;
	Для Каждого Ресурс Из МД.Ресурсы Цикл
		Если ЭтоБух Тогда
			Суффиксы = ?(Вид = "balance", "ОстатокДт,ОстатокКт", "ОборотДт,ОборотКт");
		ИначеЕсли Вид = "balance" Тогда
			Суффиксы = "Остаток";
		Иначе
			Суффиксы = ?(Оборотный, "Оборот", "Приход,Расход");
		КонецЕсли;
		Для Каждого Суффикс Из СтрРазделить(Суффиксы, ",") Цикл
			Ресурсы.Добавить(Ресурс.Имя + Суффикс);
		КонецЦикла;
	КонецЦикла;

	Если Вид = "balance" Тогда
		Дата = ?(Аргументы.Получить("date") = Неопределено, ТекущаяДатаСеанса(), ЗначениеИзJSON(Аргументы.Получить("date")));
		Запрос.УстановитьПараметр("Дата", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
		Таблица = МД.ПолноеИмя() + ".Остатки(&Дата" + ?(ЭтоБух, ", " + УсловиеСчета + ", , " + Условие, ", " + Условие) + ")";
		Период = "на " + Формат(Дата, "ДЛФ=D");
	Иначе
		Начало = ЗначениеИзJSON(Аргументы.Получить("from"));
		Конец = ЗначениеИзJSON(Аргументы.Получить("to"));
		Если ТипЗнч(Начало) <> Тип("Дата") Или ТипЗнч(Конец) <> Тип("Дата") Тогда
			ВызватьИсключение "Для оборотов нужны from и to: «2026-07-01», «2026-09-30»";
		КонецЕсли;
		Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
		Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
		Таблица = МД.ПолноеИмя() + ".Обороты(&Начало, &Конец, " + ?(ЭтоБух, ", " + УсловиеСчета + ", , " + Условие, ", " + Условие) + ")";
		Период = "с " + Формат(Начало, "ДЛФ=D") + " по " + Формат(Конец, "ДЛФ=D");
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Имя Из Группировки Цикл
		Поля.Добавить("Т." + Имя + " КАК " + Имя);
	КонецЦикла;
	Итоговые = Новый Массив;
	Для Каждого Имя Из Ресурсы Цикл
		Поля.Добавить("СУММА(Т." + Имя + ") КАК " + Имя);
		Итоговые.Добавить("СУММА(Т." + Имя + ") КАК " + Имя);
	КонецЦикла;
	Лимит = ЛимитИзАргументов(Аргументы, 50, 500);
	ГДЕ = ?(ЗначениеЗаполнено(УсловиеГДЕ), " ГДЕ " + СтрЗаменить(УсловиеГДЕ, "Субконто", "Т.Субконто"), "");
	// Остатки бухрегистра с разбивкой — по сальдо Дт−Кт по убыванию: «кто больше всех должен» оказывается
	// первым и не теряется за лимитом строк. Остальное — по самим группировкам.
	Порядок = СтрСоединить(Группировки, ", ");
	Если ЭтоБух И Вид = "balance" И МД.Ресурсы.Найти("Сумма") <> Неопределено Тогда
		Порядок = "СУММА(Т.СуммаОстатокДт - Т.СуммаОстатокКт) УБЫВ";
	КонецЕсли;
	Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + " " + СтрСоединить(Поля, ", ") + " ИЗ " + Таблица + " КАК Т" + ГДЕ
		+ ?(Группировки.Количество() > 0, " СГРУППИРОВАТЬ ПО " + СтрСоединить(Группировки, ", ")
			+ " УПОРЯДОЧИТЬ ПО " + Порядок, "")
		+ "; ВЫБРАТЬ " + СтрСоединить(Итоговые, ", ") + " ИЗ " + Таблица + " КАК Т" + ГДЕ;
	Запрос.Текст = Текст;
	Пакет = Запрос.ВыполнитьПакет();

	// Ресурсы с нулевым итогом (налоговый учёт, валюта, количество там, где их нет) — шум для модели.
	Итоги = Новый Соответствие;
	ВыборкаИтогов = Пакет[1].Выбрать();
	Если ВыборкаИтогов.Следующий() Тогда
		Для Каждого Имя Из Ресурсы Цикл
			// Сумму Дт и Кт бухрегистра показываем всегда: без нулевой стороны модель путает Дт с Кт.
			Основной = ЭтоБух И СтрНачинаетсяС(Имя, "Сумма") И (СтрЗаканчиваетсяНа(Имя, "Дт") Или СтрЗаканчиваетсяНа(Имя, "Кт"))
				И (СтрНачинаетсяС(Имя, "СуммаОстаток") Или СтрНачинаетсяС(Имя, "СуммаОборот"));
			Если ЗначениеЗаполнено(ВыборкаИтогов[Имя]) Или Основной Тогда
				Итоги.Вставить(Имя, ?(ВыборкаИтогов[Имя] = NULL, 0, ВыборкаИтогов[Имя]));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Колонки = Новый Массив;
	Для Каждого Имя Из Группировки Цикл
		Колонки.Добавить(Имя);
	КонецЦикла;
	Для Каждого Имя Из Ресурсы Цикл
		Если Итоги.Получить(Имя) <> Неопределено Тогда
			Колонки.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Строки = Новый Массив;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Значения = Новый Массив;
		Для Каждого Имя Из Колонки Цикл
			Значения.Добавить(ЗначениеДляJSON(Выборка[Имя]));
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;

	Сводка = "строк: " + Строки.Количество() + ", " + Период;
	Ответ = Новый Соответствие;
	Ответ.Вставить("period", Период);
	Ответ.Вставить("columns", Колонки);
	Ответ.Вставить("rows", Строки);
	Ответ.Вставить("totals", Итоги);
	Ответ.Вставить("query", Текст);
	Возврат Ответ;

КонецФункции


// Цепочка мест ошибки от внешней к исходной причине: «Модуль(строка): исходная строка».
Функция МестоОшибки(Информация)

	Места = Новый Массив;
	Текущая = Информация;
	Пока Текущая <> Неопределено И Места.Количество() < 6 Цикл
		Если ЗначениеЗаполнено(Текущая.ИмяМодуля) Тогда
			Места.Добавить(Текущая.ИмяМодуля + "(" + Формат(Текущая.НомерСтроки, "ЧГ=0") + "): "
				+ Лев(СокрЛП(Текущая.ИсходнаяСтрока), 160));
		КонецЕсли;
		Текущая = Текущая.Причина;
	КонецЦикла;
	Возврат Места;

КонецФункции


// Регламентированные отчёты (декларации, бухотчётность): список и чтение сохранённых показателей.
// Показатели хранятся в ДанныеОтчета (ХранилищеЗначения) структурой формы отчёта: ПоказателиОтчета
// (ячейки по разделам), ДанныеМногостраничныхРазделов, ДанныеМногострочныхРазделов. Разворачиваем
// её в JSON без пустых значений; что означают коды ячеек — расшифровывает сервер агента.
Функция РегламентированныйОтчет(Аргументы, Сводка)

	Вид = Строка(Аргументы.Получить("kind"));
	Если Вид = "read" Тогда
		Ссылка = СсылкаИзJSON(Аргументы.Получить("ref"));
		Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
			ВызватьИсключение "ref — ссылка на Документ.РегламентированныйОтчет (возьми из kind=list)";
		КонецЕсли;
		Данные = Ссылка.ДанныеОтчета.Получить();
		Счетчик = Новый Структура("Значений", 0);
		Ответ = Новый Соответствие;
		Ответ.Вставить("report", ЗначениеДляJSON(Ссылка));
		Ответ.Вставить("source", Ссылка.ИсточникОтчета);
		Ответ.Вставить("form", Ссылка.ВыбраннаяФорма);
		Ответ.Вставить("period", Ссылка.ПредставлениеПериода);
		Ответ.Вставить("organization", Строка(Ссылка.Организация));
		Ответ.Вставить("status", Ссылка.СтатусОтчета);
		Раздел = Аргументы.Получить("section");
		Раздел = ?(ЗначениеЗаполнено(Раздел), Строка(Раздел), "");
		Показатели = ПоказателиРегламентированногоОтчета(Ссылка, Данные, Раздел);
		Ответ.Вставить("indicators", Показатели);
		Если Аргументы.Получить("raw") = Истина Тогда
			Ответ.Вставить("data", РазвернутьДанныеОтчета(Данные, 0, Счетчик, Раздел));
		КонецЕсли;
		Сводка = Ссылка.НаименованиеОтчета + ", " + Ссылка.ПредставлениеПериода + ": показателей " + Показатели.Количество();
		Возврат Ответ;
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 50 Т.Ссылка КАК Ссылка, Т.ИсточникОтчета КАК Источник, Т.НаименованиеОтчета КАК Наименование,
	|	Т.ПредставлениеПериода КАК Период, Т.ДатаНачала КАК Начало, Т.ДатаОкончания КАК Конец, Т.Вид КАК Корректировка,
	|	Т.СтатусОтчета КАК Статус, ПРЕДСТАВЛЕНИЕ(Т.Организация) КАК Организация
	|ИЗ Документ.РегламентированныйОтчет КАК Т
	|ГДЕ НЕ Т.ПометкаУдаления И Т.ИсточникОтчета ПОДОБНО &Вид И Т.ДатаОкончания МЕЖДУ &ДатаС И &ДатаПо
	|УПОРЯДОЧИТЬ ПО Т.ДатаОкончания УБЫВ, Т.Дата УБЫВ");
	Фильтр = Аргументы.Получить("report_type");
	Запрос.УстановитьПараметр("Вид", "%" + ?(ЗначениеЗаполнено(Фильтр), Строка(Фильтр), "") + "%");
	ДатаС = ЗначениеИзJSON(Аргументы.Получить("from"));
	ДатаПо = ЗначениеИзJSON(Аргументы.Получить("to"));
	Запрос.УстановитьПараметр("ДатаС", ?(ТипЗнч(ДатаС) = Тип("Дата"), ДатаС, Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("ДатаПо", ?(ТипЗнч(ДатаПо) = Тип("Дата"), КонецДня(ДатаПо), Дата(3999, 12, 31)));
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Соответствие;
		Элемент.Вставить("ref", ЗначениеДляJSON(Выборка.Ссылка));
		Элемент.Вставить("type", Выборка.Источник);
		Элемент.Вставить("name", Выборка.Наименование);
		Элемент.Вставить("period", Выборка.Период);
		Элемент.Вставить("from", ЗначениеДляJSON(Выборка.Начало));
		Элемент.Вставить("to", ЗначениеДляJSON(Выборка.Конец));
		Элемент.Вставить("correction", Выборка.Корректировка);
		Элемент.Вставить("status", Выборка.Статус);
		Элемент.Вставить("organization", Выборка.Организация);
		Строки.Добавить(Элемент);
	КонецЦикла;
	Сводка = "отчётов: " + Строки.Количество();
	Ответ = Новый Соответствие;
	Ответ.Вставить("reports", Строки);
	Возврат Ответ;

КонецФункции

// Заполненные ячейки отчёта с расшифровкой: раздел, строка и графа из кода ячейки (П0003 00020 003 →
// раздел 3, строка 200, графа 3) и текст строки из макета формы, где у ячейки то же имя.
Функция ПоказателиРегламентированногоОтчета(Ссылка, Данные, Раздел)

	Показатели = Новый Массив;
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Показатели;
	КонецЕсли;
	Макеты = Новый Соответствие;
	ПоказателиОтчета = Неопределено;
	Если Данные.Свойство("ПоказателиОтчета", ПоказателиОтчета) И ТипЗнч(ПоказателиОтчета) = Тип("Структура") Тогда
		Для Каждого ЭлементРаздела Из ПоказателиОтчета Цикл
			ИмяРаздела = СтрЗаменить(ЭлементРаздела.Ключ, "ПолеТабличногоДокумента", "");
			Если ЗначениеЗаполнено(Раздел) И СтрНайти(НРег(ИмяРаздела), НРег(Раздел)) = 0 Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьПоказатели(Показатели, Ссылка, ИмяРаздела, ЭлементРаздела.Значение, 0, Макеты);
		КонецЦикла;
	КонецЕсли;
	// Многостраничные разделы (раздел 2 по каждому агенту и т.п.): ячейки страниц в колонке «Данные».
	ДанныеРазделов = Неопределено;
	Если Данные.Свойство("ДанныеМногостраничныхРазделов", ДанныеРазделов) И ТипЗнч(ДанныеРазделов) = Тип("Структура") Тогда
		Для Каждого ЭлементРаздела Из ДанныеРазделов Цикл
			Если ЗначениеЗаполнено(Раздел) И СтрНайти(НРег(ЭлементРаздела.Ключ), НРег(Раздел)) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(ЭлементРаздела.Значение) <> Тип("ТаблицаЗначений")
				Или ЭлементРаздела.Значение.Колонки.Найти("Данные") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Страница = 0;
			Для Каждого СтрокаСтраницы Из ЭлементРаздела.Значение Цикл
				Страница = Страница + 1;
				ДобавитьПоказатели(Показатели, Ссылка, ЭлементРаздела.Ключ, СтрокаСтраницы.Данные, Страница, Макеты);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	// Бухотчётность и новые формы: дерево разделов, в разделе — строки «Показатель» (Идентификатор, Данные).
	Дерево = Неопределено;
	Если Данные.Свойство("ДеревоДанныхРазделов", Дерево) И ТипЗнч(Дерево) = Тип("ДеревоЗначений") Тогда
		Для Каждого СтрокаРаздела Из Дерево.Строки Цикл
			ИмяРаздела = Строка(СтрокаРаздела.Идентификатор);
			Если ЗначениеЗаполнено(Раздел) И СтрНайти(НРег(ИмяРаздела), НРег(Раздел)) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Ячейки = Новый Соответствие;
			СобратьПоказателиДерева(СтрокаРаздела.Строки, Ячейки);
			ДобавитьПоказатели(Показатели, Ссылка, ИмяРаздела, Ячейки, 0, Макеты);
		КонецЦикла;
	КонецЕсли;
	Возврат Показатели;

КонецФункции

Процедура СобратьПоказателиДерева(Строки, Ячейки)

	Для Каждого СтрокаДерева Из Строки Цикл
		Если СтрокаДерева.Тип = "Показатель" И ЗначениеЗаполнено(СтрокаДерева.Идентификатор) Тогда
			Ячейки.Вставить(Строка(СтрокаДерева.Идентификатор), СтрокаДерева.Данные);
		ИначеЕсли СтрокаДерева.Тип <> "Расшифровка" Тогда
			СобратьПоказателиДерева(СтрокаДерева.Строки, Ячейки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоказатели(Показатели, Ссылка, ИмяРаздела, Ячейки, Страница, Макеты)

	Если Не (ТипЗнч(Ячейки) = Тип("Структура") Или ТипЗнч(Ячейки) = Тип("Соответствие")) Тогда
		Возврат;
	КонецЕсли;
	Макет = МакетРаздела(Ссылка, ИмяРаздела, Макеты);
	Для Каждого Ячейка Из Ячейки Цикл
		Значение = Ячейка.Значение;
		Если ТипЗнч(Значение) = Тип("Булево") Или Не ЗначениеЗаполнено(Значение) Или Показатели.Количество() >= 400 Тогда
			Продолжить;
		КонецЕсли;
		Имя = Строка(Ячейка.Ключ);
		Описание = Новый Соответствие;
		Описание.Вставить("section", ИмяРаздела);
		Описание.Вставить("cell", Имя);
		// Код строки и графы из имени ячейки — только для деклараций вида П<раздел><строка><графа>;
		// у бухотчётности схема другая, её код строки виден в подписи из макета.
		Если СтрДлина(Имя) = 13 И Лев(Имя, 1) = "П" И СтрНайти(Ссылка.ИсточникОтчета, "БухОтчетность") = 0 Тогда
			Описание.Вставить("line", Сред(Имя, 9, 3));
			Описание.Вставить("column", Сред(Имя, 12, 2));
		КонецЕсли;
		Если Страница > 0 Тогда
			Описание.Вставить("page", Страница);
		КонецЕсли;
		Подпись = ТекстСтрокиМакета(Макет, Имя);
		Если ЗначениеЗаполнено(Подпись) Тогда
			Описание.Вставить("label", Подпись);
		КонецЕсли;
		Описание.Вставить("value", ЗначениеДляJSON(Значение));
		Показатели.Добавить(Описание);
	КонецЦикла;

КонецПроцедуры

Функция МакетРаздела(Ссылка, ИмяРаздела, Макеты)

	Ключ = ИмяРаздела;
	Если Макеты.Получить(Ключ) <> Неопределено Тогда
		Возврат Макеты.Получить(Ключ);
	КонецЕсли;
	Макет = Ложь;
	МДОтчета = Метаданные.Отчеты.Найти(Ссылка.ИсточникОтчета);
	ИмяМакета = Ссылка.ВыбраннаяФорма + "_" + ИмяРаздела;
	Если МДОтчета <> Неопределено И МДОтчета.Макеты.Найти(ИмяМакета) <> Неопределено Тогда
		Попытка
			Макет = Отчеты[МДОтчета.Имя].ПолучитьМакет(ИмяМакета);
		Исключение
			Макет = Ложь;
		КонецПопытки;
	КонецЕсли;
	Макеты.Вставить(Ключ, Макет);
	Возврат Макет;

КонецФункции

// Текст строки макета левее ячейки показателя: «Сумма налога, исчисленная к уплате … 200».
Функция ТекстСтрокиМакета(Макет, ИмяЯчейки)

	Если ТипЗнч(Макет) <> Тип("ТабличныйДокумент") Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Область = Макет.Область(ИмяЯчейки);
	Исключение
		Возврат "";
	КонецПопытки;
	Тексты = Новый Массив;
	// Название строки бывает в рядах выше (многострочная ячейка): если в своём ряду одни коды — берём выше.
	Для Сдвиг = 0 По 2 Цикл
		Для Колонка = 1 По Область.Лево - 1 Цикл
			Текст = СокрЛП(СтрЗаменить(Макет.Область(Область.Верх - Сдвиг, Колонка).Текст, Символы.ПС, " "));
			Если ЗначениеЗаполнено(Текст) И Тексты.Найти(Текст) = Неопределено Тогда
				Тексты.Вставить(0, Текст);
			КонецЕсли;
		КонецЦикла;
		Если СтрДлина(СтрСоединить(Тексты, "")) > 25 Или Область.Верх - Сдвиг <= 1 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(СтрСоединить(Тексты, " · "), 240);

КонецФункции

Функция РазвернутьДанныеОтчета(Значение, Глубина, Счетчик, Раздел)

	Если Глубина > 6 Или Счетчик.Значений > 3000 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Т = ТипЗнч(Значение);
	Если Т = Тип("Структура") Или Т = Тип("Соответствие") Или Т = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Соответствие;
		Для Каждого Элемент Из Значение Цикл
			Ключ = Строка(Элемент.Ключ);
			// Служебное окружение формы и сохранённые настройки печати — не показатели.
			Если СтрНайти("|ОкружениеСохранения|ДеревоНастройкиСтраниц|ДанныеВариантовАвтоЗаполнения|ДанныеПомощникаЗаполнения|", "|" + Ключ + "|") > 0 Тогда
				Продолжить;
			КонецЕсли;
			// Отбор раздела — по вхождению имени на первых двух уровнях (ПоказателиОтчета → ПолеТабличногоДокументаРаздел3).
			Если Глубина = 1 И ЗначениеЗаполнено(Раздел) И СтрНайти(НРег(Ключ), НРег(Раздел)) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Вложенное = РазвернутьДанныеОтчета(Элемент.Значение, Глубина + 1, Счетчик, Раздел);
			Если Вложенное <> Неопределено Тогда
				Результат.Вставить(Ключ, Вложенное);
			КонецЕсли;
		КонецЦикла;
		Возврат ?(Результат.Количество() = 0, Неопределено, Результат);
	ИначеЕсли Т = Тип("ТаблицаЗначений") Тогда
		Строки = Новый Массив;
		Для Каждого СтрокаТаблицы Из Значение Цикл
			Если Строки.Количество() >= 40 Тогда
				Прервать;
			КонецЕсли;
			Запись = Новый Соответствие;
			Для Каждого Колонка Из Значение.Колонки Цикл
				Вложенное = РазвернутьДанныеОтчета(СтрокаТаблицы[Колонка.Имя], Глубина + 1, Счетчик, Раздел);
				Если Вложенное <> Неопределено Тогда
					Запись.Вставить(Колонка.Имя, Вложенное);
				КонецЕсли;
			КонецЦикла;
			Если Запись.Количество() > 0 Тогда
				Строки.Добавить(Запись);
			КонецЕсли;
		КонецЦикла;
		Возврат ?(Строки.Количество() = 0, Неопределено, Строки);
	ИначеЕсли Т = Тип("Массив") Или Т = Тип("ФиксированныйМассив") Тогда
		Строки = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Вложенное = РазвернутьДанныеОтчета(Элемент, Глубина + 1, Счетчик, Раздел);
			Если Вложенное <> Неопределено И Строки.Количество() < 40 Тогда
				Строки.Добавить(Вложенное);
			КонецЕсли;
		КонецЦикла;
		Возврат ?(Строки.Количество() = 0, Неопределено, Строки);
	ИначеЕсли Т = Тип("ДеревоЗначений") Или Т = Тип("КоллекцияСтрокДереваЗначений") Тогда
		// Бухотчётность хранит разделы деревом: колонки строк + вложенные «Строки».
		Строки = Новый Массив;
		Колонки = ?(Т = Тип("ДеревоЗначений"), Значение.Колонки, Неопределено);
		Для Каждого СтрокаДерева Из ?(Т = Тип("ДеревоЗначений"), Значение.Строки, Значение) Цикл
			Если Строки.Количество() >= 60 Тогда
				Прервать;
			КонецЕсли;
			Запись = Новый Соответствие;
			Для Каждого Колонка Из ?(Колонки = Неопределено, СтрокаДерева.Владелец().Колонки, Колонки) Цикл
				Вложенное = РазвернутьДанныеОтчета(СтрокаДерева[Колонка.Имя], Глубина + 1, Счетчик, Раздел);
				Если Вложенное <> Неопределено Тогда
					Запись.Вставить(Колонка.Имя, Вложенное);
				КонецЕсли;
			КонецЦикла;
			Вложенные = РазвернутьДанныеОтчета(СтрокаДерева.Строки, Глубина + 1, Счетчик, Раздел);
			Если Вложенные <> Неопределено Тогда
				Запись.Вставить("Строки", Вложенные);
			КонецЕсли;
			Если Запись.Количество() > 0 Тогда
				Строки.Добавить(Запись);
			КонецЕсли;
		КонецЦикла;
		Возврат ?(Строки.Количество() = 0, Неопределено, Строки);
	ИначеЕсли Т = Тип("ХранилищеЗначения") Тогда
		Возврат РазвернутьДанныеОтчета(Значение.Получить(), Глубина + 1, Счетчик, Раздел);
	ИначеЕсли Т = Тип("Булево") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Счетчик.Значений = Счетчик.Значений + 1;
	Возврат ЗначениеДляJSON(Значение);

КонецФункции


// Книга продаж или покупок за период: итоги и разбивка без написания запроса.
Функция КнигаНДС(Аргументы, Сводка)

	Продажи = Строка(Аргументы.Получить("book")) <> "purchases";
	Регистр = ?(Продажи, "РегистрНакопления.НДСЗаписиКнигиПродаж", "РегистрНакопления.НДСЗаписиКнигиПокупок");
	Контрагент = ?(Продажи, "Покупатель", "Поставщик");
	Начало = ЗначениеИзJSON(Аргументы.Получить("from"));
	Конец = ЗначениеИзJSON(Аргументы.Получить("to"));
	Если ТипЗнч(Начало) <> Тип("Дата") Или ТипЗнч(Конец) <> Тип("Дата") Тогда
		ВызватьИсключение "Нужен период: from и to, например «2026-07-01» и «2026-09-30»";
	КонецЕсли;
	Разрезы = Новый Соответствие;
	Разрезы.Вставить("rate", "Т.СтавкаНДС");
	Разрезы.Вставить("counterparty", "Т." + Контрагент);
	Разрезы.Вставить("invoice", "Т.СчетФактура");
	Разрезы.Вставить("event", "Т.Событие");
	Разрез = Разрезы.Получить(Строка(Аргументы.Получить("group_by")));
	Если Разрез = Неопределено Тогда
		Разрез = "Т.СтавкаНДС";
	КонецЕсли;
	Условия = Новый Массив;
	Условия.Добавить("Т.Период МЕЖДУ &Начало И &Конец");
	Условия.Добавить("Т.Активность");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Если Аргументы.Получить("additional_sheets") <> Истина Тогда
		// Записи доп. листов относятся к прошлым периодам — в книгу периода не входят.
		Условия.Добавить("НЕ Т.ЗаписьДополнительногоЛиста");
	КонецЕсли;
	Если Аргументы.Получить("counterparty") <> Неопределено Тогда
		Условия.Добавить("Т." + Контрагент + " = &Контрагент");
		Запрос.УстановитьПараметр("Контрагент", ПривестиЗначение(Аргументы.Получить("counterparty"),
			Новый ОписаниеТипов("СправочникСсылка.Контрагенты"), "counterparty"));
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ " + Разрез + " КАК Разрез, КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.СчетФактура) КАК Документов,
	|	СУММА(Т.СуммаБезНДС) КАК СуммаБезНДС, СУММА(Т.НДС) КАК НДС
	|ИЗ " + Регистр + " КАК Т ГДЕ " + СтрСоединить(Условия, " И ") + "
	|СГРУППИРОВАТЬ ПО " + Разрез + "
	|УПОРЯДОЧИТЬ ПО НДС УБЫВ";
	Лимит = ЛимитИзАргументов(Аргументы, 40, 300);
	Данные = Запрос.Выполнить().Выгрузить();
	Строки = Новый Массив;
	Для Каждого СтрокаДанных Из Данные Цикл
		Если Строки.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Запись = Новый Соответствие;
		Запись.Вставить("group", ?(ЗначениеЗаполнено(СтрокаДанных.Разрез), Строка(СтрокаДанных.Разрез), "(не указано)"));
		Запись.Вставить("documents", СтрокаДанных.Документов);
		Запись.Вставить("sum_without_vat", СтрокаДанных.СуммаБезНДС);
		Запись.Вставить("vat", СтрокаДанных.НДС);
		Строки.Добавить(Запись);
	КонецЦикла;
	Итоги = Новый Соответствие;
	Итоги.Вставить("sum_without_vat", Данные.Итог("СуммаБезНДС"));
	Итоги.Вставить("vat", Данные.Итог("НДС"));
	Период = "с " + Формат(Начало, "ДЛФ=D") + " по " + Формат(Конец, "ДЛФ=D");
	Сводка = ?(Продажи, "книга продаж", "книга покупок") + " " + Период + ": НДС " + Формат(Итоги.Получить("vat"), "ЧДЦ=2; ЧН=0");
	Ответ = Новый Соответствие;
	Ответ.Вставить("book", ?(Продажи, "Книга продаж", "Книга покупок"));
	Ответ.Вставить("period", Период);
	Ответ.Вставить("rows", Строки);
	Ответ.Вставить("totals", Итоги);
	Ответ.Вставить("additional_sheets", Аргументы.Получить("additional_sheets") = Истина);
	Если Данные.Количество() > Лимит Тогда
		Ответ.Вставить("truncated", "показаны первые " + Лимит + " из " + Данные.Количество() + "; итоги — по всем");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Сверка НДС за квартал: декларация ↔ книги ↔ счёт 68.02. Каждое сравнение — с суммами и разницей.
Функция СверкаНДС(Аргументы, Сводка)

	Дата = ЗначениеИзJSON(Аргументы.Получить("date"));
	Если ТипЗнч(Дата) <> Тип("Дата") Тогда
		ВызватьИсключение "date — любая дата внутри квартала, например «2026-09-30»";
	КонецЕсли;
	Начало = НачалоКвартала(Дата);
	Конец = КонецКвартала(Дата);
	Аргументы.Вставить("from", Формат(Начало, "ДФ=yyyy-MM-dd"));
	Аргументы.Вставить("to", Формат(Конец, "ДФ=yyyy-MM-dd"));

	// Последняя (с наибольшим номером корректировки) декларация за квартал.
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ.РегламентированныйОтчет КАК Т
	|ГДЕ НЕ Т.ПометкаУдаления И Т.ИсточникОтчета = ""РегламентированныйОтчетНДС"" И Т.ДатаНачала = &Начало
	|УПОРЯДОЧИТЬ ПО Т.Вид УБЫВ, Т.Дата УБЫВ");
	Запрос.УстановитьПараметр("Начало", Начало);
	Выборка = Запрос.Выполнить().Выбрать();
	Декларация = Новый Соответствие;
	Ответ = Новый Соответствие;
	Если Выборка.Следующий() Тогда
		Ответ.Вставить("declaration", ЗначениеДляJSON(Выборка.Ссылка));
		Для Каждого Показатель Из ПоказателиРегламентированногоОтчета(Выборка.Ссылка, Выборка.Ссылка.ДанныеОтчета.Получить(), "") Цикл
			Если Показатель.Получить("line") <> Неопределено И ТипЗнч(Показатель.Получить("value")) = Тип("Число") Тогда
				Ключ = Показатель.Получить("section") + "." + Показатель.Получить("line") + "." + Показатель.Получить("column");
				Декларация.Вставить(Ключ, Показатель.Получить("value"));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Ответ.Вставить("declaration", "декларации за квартал в базе нет");
	КонецЕсли;

	Аргументы.Вставить("book", "sales");
	Продажи = КнигаНДС(Аргументы, "").Получить("totals").Получить("vat");
	Аргументы.Вставить("book", "purchases");
	Покупки = КнигаНДС(Аргументы, "").Получить("totals").Получить("vat");

	Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("68.02");
	Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Т.СуммаОборотДт), 0) КАК Дт, ЕСТЬNULL(СУММА(Т.СуммаОборотКт), 0) КАК Кт
	|ИЗ РегистрБухгалтерии.Хозрасчетный.Обороты(&Начало, &Конец, , Счет = &Счет, , , , ) КАК Т");
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Запрос.УстановитьПараметр("Счет", Счет);
	Обороты = Запрос.Выполнить().Выгрузить()[0];

	Исчислено = Декларация.Получить("Раздел3.118.05");
	Вычеты = Декларация.Получить("Раздел3.190.03");
	КУплате = Декларация.Получить("Раздел3.200.03");
	КВозмещению = Декларация.Получить("Раздел3.210.03");
	Раздел1 = Декларация.Получить("Раздел1.040.03");
	Сверки = Новый Массив;
	ДобавитьСверку(Сверки, "НДС исчисленный: декларация стр. 118 ↔ книга продаж", Исчислено, Продажи);
	ДобавитьСверку(Сверки, "Вычеты: декларация стр. 190 ↔ книга покупок", Вычеты, Покупки);
	Если Исчислено <> Неопределено И Вычеты <> Неопределено Тогда
		ДобавитьСверку(Сверки, "Стр. 200 (к уплате) ↔ стр. 118 − стр. 190", ?(КУплате = Неопределено, 0, КУплате)
			- ?(КВозмещению = Неопределено, 0, КВозмещению), Исчислено - Вычеты);
	КонецЕсли;
	ДобавитьСверку(Сверки, "Раздел 1 стр. 040 ↔ раздел 3 стр. 200", Раздел1, КУплате);
	ДобавитьСверку(Сверки, "Книга продаж ↔ оборот Кт 68.02 (начислено)", Продажи, Обороты.Кт);
	Ответ.Вставить("quarter", Формат(Начало, "ДЛФ=D") + " – " + Формат(Конец, "ДЛФ=D"));
	Ответ.Вставить("checks", Сверки);
	Ответ.Вставить("account_68_02", Новый Структура("ОборотДт, ОборотКт", Обороты.Дт, Обороты.Кт));
	Ответ.Вставить("note", "Расхождение до 1 руб. — округление в декларации до рублей. Кт 68.02 может включать "
		+ "восстановленный НДС и НДС налогового агента, которых нет в книге продаж — смотри обороты по документам.");
	Расхождений = 0;
	Для Каждого Сверка Из Сверки Цикл
		Если Не Сверка.Получить("ok") Тогда
			Расхождений = Расхождений + 1;
		КонецЕсли;
	КонецЦикла;
	Сводка = "сверка НДС " + Ответ.Получить("quarter") + ": расхождений " + Расхождений + " из " + Сверки.Количество();
	Возврат Ответ;

КонецФункции

Процедура ДобавитьСверку(Сверки, Название, Слева, Справа)

	Сверка = Новый Соответствие;
	Сверка.Вставить("check", Название);
	Сверка.Вставить("left", Слева);
	Сверка.Вставить("right", Справа);
	Если ТипЗнч(Слева) = Тип("Число") И ТипЗнч(Справа) = Тип("Число") Тогда
		Сверка.Вставить("difference", Слева - Справа);
		Сверка.Вставить("ok", Макс(Слева - Справа, Справа - Слева) <= 1);
	Иначе
		Сверка.Вставить("ok", Ложь);
		Сверка.Вставить("difference", "нет данных для сравнения");
	КонецЕсли;
	Сверки.Добавить(Сверка);

КонецПроцедуры

// Бухгалтерские отчёты по счёту без написания запроса: ОСВ, анализ счёта по субконто,
// карточка счёта. Сальдо — развёрнутое до уровня субконто, как в ОСВ БП по счетам расчётов.
Функция ОтчетПоСчету(Аргументы, Сводка)

	Вид = Строка(Аргументы.Получить("kind"));
	Если СтрНайти("|osv|analysis|card|", "|" + Вид + "|") = 0 Тогда
		ВызватьИсключение "kind: osv (оборотно-сальдовая ведомость), analysis (счёт в разрезе субконто), card (карточка счёта)";
	КонецЕсли;
	ИмяРегистра = Аргументы.Получить("register");
	МД = Метаданные.НайтиПоПолномуИмени(?(ЗначениеЗаполнено(ИмяРегистра), Строка(ИмяРегистра), "РегистрБухгалтерии.Хозрасчетный"));
	Если МД = Неопределено Или Не Метаданные.РегистрыБухгалтерии.Содержит(МД) Тогда
		ВызватьИсключение "Нужен регистр бухгалтерии, например «РегистрБухгалтерии.Хозрасчетный»";
	КонецЕсли;
	Если МД.Ресурсы.Найти("Сумма") = Неопределено Тогда
		ВызватьИсключение "У регистра " + МД.ПолноеИмя() + " нет ресурса «Сумма»";
	КонецЕсли;

	Начало = ЗначениеИзJSON(Аргументы.Получить("from"));
	Конец = ЗначениеИзJSON(Аргументы.Получить("to"));
	Если ТипЗнч(Начало) <> Тип("Дата") Или ТипЗнч(Конец) <> Тип("Дата") Тогда
		ВызватьИсключение "Нужен период: from и to, например «2026-09-01» и «2026-09-30»";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));

	Счет = Неопределено;
	КодСчета = Аргументы.Получить("account");
	Если ЗначениеЗаполнено(КодСчета) Тогда
		Счет = ПланыСчетов[МД.ПланСчетов.Имя].НайтиПоКоду(Строка(КодСчета));
		Если Не ЗначениеЗаполнено(Счет) Тогда
			ВызватьИсключение "Нет счёта с кодом «" + КодСчета + "» в плане счетов " + МД.ПланСчетов.Имя;
		КонецЕсли;
		Запрос.УстановитьПараметр("Счет", Счет);
	ИначеЕсли Вид <> "osv" Тогда
		ВызватьИсключение "Для " + Вид + " нужен account — код счёта, например «62» или «51»";
	КонецЕсли;

	// Отбор по объекту аналитики: в любом из субконто (контрагент, договор, номенклатура…).
	Аналитика = Неопределено;
	Если Аргументы.Получить("counterparty") <> Неопределено Тогда
		Если Метаданные.Справочники.Найти("Контрагенты") = Неопределено Тогда
			ВызватьИсключение "В конфигурации нет справочника Контрагенты — передай subconto ссылкой";
		КонецЕсли;
		Аналитика = ПривестиЗначение(Аргументы.Получить("counterparty"), Новый ОписаниеТипов("СправочникСсылка.Контрагенты"), "counterparty");
	ИначеЕсли Аргументы.Получить("subconto") <> Неопределено Тогда
		Аналитика = СсылкаИзJSON(Аргументы.Получить("subconto"));
	КонецЕсли;
	Запрос.УстановитьПараметр("Аналитика", Аналитика);
	Колво = МД.ПланСчетов.МаксКоличествоСубконто;

	Если Вид = "card" Тогда
		Возврат КарточкаСчета(МД, Запрос, Счет, Аналитика, Колво, Аргументы, Сводка);
	КонецЕсли;

	УсловияАналитики = Новый Массив;
	Для Номер = 1 По Колво Цикл
		УсловияАналитики.Добавить("Т.Субконто" + Номер + " = &Аналитика");
	КонецЦикла;
	ГДЕ = ?(Аналитика = Неопределено, "", " ГДЕ (" + СтрСоединить(УсловияАналитики, " ИЛИ ") + ")");
	Таблица = МД.ПолноеИмя() + ".ОстаткиИОбороты(&Начало, &Конец, , , "
		+ ?(Счет = Неопределено, "", "Счет В ИЕРАРХИИ (&Счет)") + ", , ) КАК Т";
	Ресурсы = СтрРазделить("СуммаНачальныйОстатокДт,СуммаНачальныйОстатокКт,СуммаОборотДт,СуммаОборотКт,"
		+ "СуммаКонечныйОстатокДт,СуммаКонечныйОстатокКт", ",");
	Суммы = Новый Массив;
	Для Каждого Имя Из Ресурсы Цикл
		Суммы.Добавить("СУММА(Т." + Имя + ") КАК " + Имя);
	КонецЦикла;

	Если Вид = "osv" Тогда
		Запрос.Текст = "ВЫБРАТЬ Т.Счет КАК Счет, " + СтрСоединить(Суммы, ", ") + " ИЗ " + Таблица + ГДЕ + " СГРУППИРОВАТЬ ПО Т.Счет";
		Данные = Запрос.Выполнить().Выгрузить();
		// Без счёта — ОСВ по счетам первого уровня, как типовая; со счётом — по его субсчетам.
		Данные.Колонки.Добавить("Группа");
		Верхние = Новый Соответствие;
		Для Каждого СтрокаДанных Из Данные Цикл
			Группа = СтрокаДанных.Счет;
			Если Счет = Неопределено Тогда
				Группа = Верхние.Получить(СтрокаДанных.Счет);
				Если Группа = Неопределено Тогда
					Группа = СтрокаДанных.Счет;
					Пока ЗначениеЗаполнено(Группа.Родитель) Цикл
						Группа = Группа.Родитель;
					КонецЦикла;
					Верхние.Вставить(СтрокаДанных.Счет, Группа);
				КонецЕсли;
			КонецЕсли;
			СтрокаДанных.Группа = Группа;
		КонецЦикла;
		Данные.Свернуть("Группа", СтрСоединить(Ресурсы, ","));
		Данные.Колонки.Добавить("Код");
		Для Каждого СтрокаДанных Из Данные Цикл
			СтрокаДанных.Код = СтрокаДанных.Группа.Код;
		КонецЦикла;
		Данные.Сортировать("Код");
		Колонки = Новый Массив;
		Колонки.Добавить("Счет");
		ПолеГруппы = "Группа";
	Иначе
		Разрезы = Аргументы.Получить("group_by");
		Если ТипЗнч(Разрезы) <> Тип("Массив") Или Разрезы.Количество() = 0 Тогда
			Разрезы = ЗначениеВМассиве("Субконто1");
		КонецЕсли;
		Поля = Новый Массив;
		Для Каждого Разрез Из Разрезы Цикл
			Если СтрНайти("|Счет|Субконто1|Субконто2|Субконто3|", "|" + Разрез + "|") = 0 Тогда
				ВызватьИсключение "group_by: Счет, Субконто1, Субконто2, Субконто3";
			КонецЕсли;
			Поля.Добавить("Т." + Разрез);
		КонецЦикла;
		Порядок = "ВЫРАЗИТЬ(СУММА(Т.СуммаКонечныйОстатокДт - Т.СуммаКонечныйОстатокКт) КАК ЧИСЛО(15, 2))";
		Запрос.Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + ", " + СтрСоединить(Суммы, ", ") + " ИЗ " + Таблица + ГДЕ
			+ " СГРУППИРОВАТЬ ПО " + СтрСоединить(Поля, ", ") + " УПОРЯДОЧИТЬ ПО " + Порядок + " УБЫВ";
		Данные = Запрос.Выполнить().Выгрузить();
		Колонки = Разрезы;
		ПолеГруппы = Неопределено;
	КонецЕсли;

	Лимит = ЛимитИзАргументов(Аргументы, 60, 300);
	// Забалансовые счета ведутся без двойной записи — в общий итог ОСВ их не складываем.
	Итоги = Новый Соответствие;
	ИтогиЗабалансовых = Новый Соответствие;
	Для Каждого Имя Из Ресурсы Цикл
		Итоги.Вставить(Имя, 0);
		ИтогиЗабалансовых.Вставить(Имя, 0);
		Колонки.Добавить(Имя);
	КонецЦикла;
	ЕстьЗабалансовые = Ложь;
	Для Каждого СтрокаДанных Из Данные Цикл
		СчетСтроки = ?(ПолеГруппы <> Неопределено, СтрокаДанных.Группа, Счет);
		Забалансовый = ЗначениеЗаполнено(СчетСтроки) И СчетСтроки.Забалансовый;
		ЕстьЗабалансовые = ЕстьЗабалансовые Или Забалансовый;
		Приемник = ?(Забалансовый, ИтогиЗабалансовых, Итоги);
		Для Каждого Имя Из Ресурсы Цикл
			Приемник.Вставить(Имя, Приемник.Получить(Имя) + СтрокаДанных[Имя]);
		КонецЦикла;
	КонецЦикла;
	Строки = Новый Массив;
	Для Каждого СтрокаДанных Из Данные Цикл
		Если Строки.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Нулевая = Истина;
		Для Каждого Имя Из Ресурсы Цикл
			Нулевая = Нулевая И Не ЗначениеЗаполнено(СтрокаДанных[Имя]);
		КонецЦикла;
		Если Нулевая Тогда
			Продолжить;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого Имя Из Колонки Цикл
			Если Имя = "Счет" И ПолеГруппы <> Неопределено Тогда
				Значения.Добавить(СтрокаДанных.Код + " " + СтрокаДанных.Группа.Наименование);
			ИначеЕсли Имя = "Счет" Тогда
				Значения.Добавить(?(ЗначениеЗаполнено(СтрокаДанных.Счет), СтрокаДанных.Счет.Код + " " + СтрокаДанных.Счет.Наименование, ""));
			Иначе
				Значения.Добавить(ЗначениеДляJSON(СтрокаДанных[Имя]));
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;

	Период = "с " + Формат(Начало, "ДЛФ=D") + " по " + Формат(Конец, "ДЛФ=D");
	Сводка = ?(Вид = "osv", "ОСВ", "анализ счёта") + ?(Счет = Неопределено, "", " " + Счет.Код) + ", " + Период
		+ ", строк: " + Строки.Количество();
	Ответ = Новый Соответствие;
	Ответ.Вставить("report", ?(Вид = "osv", "Оборотно-сальдовая ведомость", "Анализ счёта по субконто"));
	Ответ.Вставить("period", Период);
	Если Счет <> Неопределено Тогда
		Ответ.Вставить("account", Счет.Код + " " + Счет.Наименование);
	КонецЕсли;
	Если Аналитика <> Неопределено Тогда
		Ответ.Вставить("filter", Строка(Аналитика));
	КонецЕсли;
	Ответ.Вставить("columns", Колонки);
	Ответ.Вставить("rows", Строки);
	Ответ.Вставить("totals", Итоги);
	Если ЕстьЗабалансовые И Счет = Неопределено Тогда
		Ответ.Вставить("off_balance_totals", ИтогиЗабалансовых);
	ИначеЕсли ЕстьЗабалансовые Тогда
		Ответ.Вставить("totals", ИтогиЗабалансовых);
	КонецЕсли;
	Если Данные.Количество() > Лимит Тогда
		Ответ.Вставить("truncated", "показаны первые " + Лимит + " из " + Данные.Количество() + " строк; итоги — по всем");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Карточка счёта: сальдо на начало, проводки по дням с корреспонденцией и нарастающим
// сальдо (плюс — дебетовое, минус — кредитовое), обороты и сальдо на конец.
Функция КарточкаСчета(МД, Запрос, Счет, Аналитика, Колво, Аргументы, Сводка)

	УсловияОстатков = Новый Массив;
	УсловияДвижений = Новый Массив;
	Для Номер = 1 По Колво Цикл
		УсловияОстатков.Добавить("Т.Субконто" + Номер + " = &Аналитика");
		УсловияДвижений.Добавить("Т.СубконтоДт" + Номер + " = &Аналитика");
		УсловияДвижений.Добавить("Т.СубконтоКт" + Номер + " = &Аналитика");
	КонецЦикла;
	ЕстьСодержание = МД.Реквизиты.Найти("Содержание") <> Неопределено;
	Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(СУММА(Т.СуммаНачальныйОстатокДт - Т.СуммаНачальныйОстатокКт), 0) КАК Сальдо
	|ИЗ " + МД.ПолноеИмя() + ".ОстаткиИОбороты(&Начало, &Конец, , , Счет В ИЕРАРХИИ (&Счет), , ) КАК Т"
		+ ?(Аналитика = Неопределено, "", " ГДЕ (" + СтрСоединить(УсловияОстатков, " ИЛИ ") + ")") + ";
	|ВЫБРАТЬ Т.Период КАК Период, Т.Регистратор КАК Регистратор, Т.СчетДт КАК СчетДт, Т.СчетКт КАК СчетКт,
	|	ВЫБОР КОГДА Т.СчетДт В ИЕРАРХИИ (&Счет) ТОГДА Т.Сумма ИНАЧЕ 0 КОНЕЦ КАК Дт,
	|	ВЫБОР КОГДА Т.СчетКт В ИЕРАРХИИ (&Счет) ТОГДА Т.Сумма ИНАЧЕ 0 КОНЕЦ КАК Кт,
	|	ВЫБОР КОГДА Т.СчетДт В ИЕРАРХИИ (&Счет) ТОГДА ПРЕДСТАВЛЕНИЕ(Т.СубконтоДт1) ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Т.СубконтоКт1) КОНЕЦ КАК Аналитика,
	|	ВЫБОР КОГДА Т.СчетДт В ИЕРАРХИИ (&Счет) ТОГДА ПРЕДСТАВЛЕНИЕ(Т.СубконтоКт1) ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Т.СубконтоДт1) КОНЕЦ КАК КорАналитика"
		+ ?(ЕстьСодержание, ", Т.Содержание КАК Содержание", ", """" КАК Содержание") + "
	|ИЗ " + МД.ПолноеИмя() + ".ДвиженияССубконто(&Начало, &Конец, СчетДт В ИЕРАРХИИ (&Счет) ИЛИ СчетКт В ИЕРАРХИИ (&Счет), , ) КАК Т"
		+ ?(Аналитика = Неопределено, "", " ГДЕ (" + СтрСоединить(УсловияДвижений, " ИЛИ ") + ")") + "
	|УПОРЯДОЧИТЬ ПО Т.Период, Т.Регистратор, Т.НомерСтроки";
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[0].Выбрать();
	НачальноеСальдо = ?(Выборка.Следующий(), Выборка.Сальдо, 0);

	Лимит = ЛимитИзАргументов(Аргументы, 80, 400);
	Сальдо = НачальноеСальдо;
	ОборотДт = 0;
	ОборотКт = 0;
	Строки = Новый Массив;
	Выборка = Пакет[1].Выбрать();
	Всего = Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		// Проводка внутри счёта (например, 51 → 51) попадает и в Дт, и в Кт — на сальдо не влияет.
		ОборотДт = ОборотДт + Выборка.Дт;
		ОборотКт = ОборотКт + Выборка.Кт;
		Сальдо = Сальдо + Выборка.Дт - Выборка.Кт;
		Если Строки.Количество() < Лимит Тогда
			Значения = Новый Массив;
			Значения.Добавить(Формат(Выборка.Период, "ДФ=dd.MM.yyyy"));
			Значения.Добавить(ЗначениеДляJSON(Выборка.Регистратор));
			Значения.Добавить(Выборка.СчетДт.Код);
			Значения.Добавить(Выборка.СчетКт.Код);
			Значения.Добавить(Выборка.Дт);
			Значения.Добавить(Выборка.Кт);
			Значения.Добавить(Сальдо);
			// У корреспондирующего счёта может не быть субконто — тогда ПРЕДСТАВЛЕНИЕ даёт NULL, а JSON его не примет.
			Значения.Добавить(?(Выборка.Аналитика = NULL, "", Выборка.Аналитика));
			Значения.Добавить(?(Выборка.КорАналитика = NULL, "", Выборка.КорАналитика));
			Значения.Добавить(?(Выборка.Содержание = NULL, "", Лев(Выборка.Содержание, 100)));
			Строки.Добавить(Значения);
		КонецЕсли;
	КонецЦикла;

	Период = "с " + Формат(Запрос.Параметры.Начало, "ДЛФ=D") + " по " + Формат(Запрос.Параметры.Конец, "ДЛФ=D");
	Сводка = "карточка " + Счет.Код + ", " + Период + ", проводок: " + Всего;
	Ответ = Новый Соответствие;
	Ответ.Вставить("report", "Карточка счёта " + Счет.Код + " " + Счет.Наименование);
	Ответ.Вставить("period", Период);
	Если Аналитика <> Неопределено Тогда
		Ответ.Вставить("filter", Строка(Аналитика));
	КонецЕсли;
	Ответ.Вставить("columns", СтрРазделить("Дата,Документ,СчетДт,СчетКт,Дт,Кт,Сальдо,Аналитика,КорАналитика,Содержание", ","));
	Ответ.Вставить("rows", Строки);
	Итоги = Новый Соответствие;
	Итоги.Вставить("СальдоНаНачало", НачальноеСальдо);
	Итоги.Вставить("ОборотДт", ОборотДт);
	Итоги.Вставить("ОборотКт", ОборотКт);
	Итоги.Вставить("СальдоНаКонец", Сальдо);
	Итоги.Вставить("Проводок", Всего);
	Ответ.Вставить("totals", Итоги);
	Ответ.Вставить("saldo_sign", "Сальдо: плюс — дебетовое, минус — кредитовое");
	Если Всего > Лимит Тогда
		Ответ.Вставить("truncated", "показаны первые " + Лимит + " из " + Всего + " проводок; итоги — по всем");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Запуск отчёта на СКД: вариант, период, параметры и отборы задаёт агент, результат
// выводится в табличный документ (как видит пользователь) и отдаётся строками ячеек.
Функция ЗапуститьОтчет(Аргументы, Сводка)

	МД = Метаданные.НайтиПоПолномуИмени(Строка(Аргументы.Получить("report")));
	Если МД = Неопределено Или Не Метаданные.Отчеты.Содержит(МД) Тогда
		ВызватьИсключение "report — полное имя отчёта, например «Отчет.ВедомостьПоТоварамНаСкладах»; найди через metadata_search с kind Отчет";
	КонецЕсли;
	Если Не ПравоДоступа("Использование", МД) Тогда
		ВызватьИсключение "У пользователя нет права на отчёт " + МД.Синоним;
	КонецЕсли;
	Если МД.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		ВызватьИсключение МД.Синоним + " построен не на СКД — его можно только открыть пользователю. Для бухгалтерии есть account_report.";
	КонецЕсли;
	ОтчетОбъект = Отчеты[МД.Имя].Создать();
	СКД = ОтчетОбъект.ПолучитьМакет(МД.ОсновнаяСхемаКомпоновкиДанных.Имя);
	// Бухгалтерские отчёты БП берут параметры из служебного «НастройкиОтчета», который заполняет форма
	// отчёта; без неё они молча формируются пустыми — честнее отказать.
	Если СКД.Параметры.Найти("НастройкиОтчета") <> Неопределено Тогда
		ВызватьИсключение МД.Синоним + " — бухгалтерский отчёт, его настройки готовит форма. Для ОСВ, анализа и "
			+ "карточки счёта используй account_report, для остального — register_balance / register_turnover или query_run.";
	КонецЕсли;

	ИмяВарианта = Аргументы.Получить("variant");
	Вариант = Неопределено;
	Имена = Новый Массив;
	Для Каждого Кандидат Из СКД.ВариантыНастроек Цикл
		Имена.Добавить(Кандидат.Имя + ?(ЗначениеЗаполнено(Кандидат.Представление), " (" + Кандидат.Представление + ")", ""));
		Если Вариант = Неопределено Или (ЗначениеЗаполнено(ИмяВарианта)
			И (БезЁ(Кандидат.Имя) = БезЁ(ИмяВарианта) Или БезЁ(Кандидат.Представление) = БезЁ(ИмяВарианта))) Тогда
			Вариант = Кандидат;
		КонецЕсли;
	КонецЦикла;
	Если Вариант = Неопределено Тогда
		ВызватьИсключение "У отчёта нет вариантов настроек";
	КонецЕсли;

	Компоновщик = ОтчетОбъект.КомпоновщикНастроек;
	Адрес = ПоместитьВоВременноеХранилище(СКД, Новый УникальныйИдентификатор);
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Адрес));
	Компоновщик.ЗагрузитьНастройки(Вариант.Настройки);
	Настройки = Компоновщик.Настройки;

	// Период: стандартные имена параметров типовых отчётов.
	Начало = ЗначениеИзJSON(Аргументы.Получить("from"));
	Конец = ЗначениеИзJSON(Аргументы.Получить("to"));
	ЕстьПериод = ТипЗнч(Начало) = Тип("Дата") И ТипЗнч(Конец) = Тип("Дата");
	Использованы = Новый Массив;
	Для Каждого Доступный Из Настройки.ПараметрыДанных.ДоступныеПараметры.Элементы Цикл
		Имя = Строка(Доступный.Параметр);
		Значение = Неопределено;
		Если ЕстьПериод И Доступный.ТипЗначения.СодержитТип(Тип("СтандартныйПериод")) Тогда
			Значение = Новый СтандартныйПериод(НачалоДня(Начало), КонецДня(Конец));
		ИначеЕсли ЕстьПериод И СтрНайти("|началопериода|датаначала|начало|", "|" + НРег(Имя) + "|") > 0 Тогда
			Значение = НачалоДня(Начало);
		ИначеЕсли ЕстьПериод И СтрНайти("|конецпериода|датаокончания|конец|период|", "|" + НРег(Имя) + "|") > 0
			И Доступный.ТипЗначения.СодержитТип(Тип("Дата")) Тогда
			Значение = КонецДня(Конец);
		КонецЕсли;
		Если Значение <> Неопределено Тогда
			Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Имя, Значение);
			Использованы.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	// Часть отчётов держит период в реквизитах объекта, а не в параметрах схемы.
	Если ЕстьПериод И МД.Реквизиты.Найти("НачалоПериода") <> Неопределено Тогда
		ОтчетОбъект.НачалоПериода = НачалоДня(Начало);
	КонецЕсли;
	Если ЕстьПериод И МД.Реквизиты.Найти("КонецПериода") <> Неопределено Тогда
		ОтчетОбъект.КонецПериода = КонецДня(Конец);
	КонецЕсли;

	Параметры = Аргументы.Получить("params");
	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Для Каждого Параметр Из Параметры Цикл
			Доступный = Настройки.ПараметрыДанных.ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных(Параметр.Ключ));
			Реквизит = МД.Реквизиты.Найти(Параметр.Ключ);
			Если Доступный = Неопределено И Реквизит <> Неопределено Тогда
				ОтчетОбъект[Параметр.Ключ] = ПривестиЗначение(Параметр.Значение, Реквизит.Тип, Параметр.Ключ);
				Использованы.Добавить(Параметр.Ключ);
				Продолжить;
			ИначеЕсли Доступный = Неопределено Тогда
				ВызватьИсключение "У отчёта нет параметра «" + Параметр.Ключ + "». Есть: " + ПараметрыОтчета(Настройки);
			КонецЕсли;
			Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Параметр.Ключ,
				ПривестиЗначение(Параметр.Значение, Доступный.ТипЗначения, Параметр.Ключ));
			Использованы.Добавить(Параметр.Ключ);
		КонецЦикла;
	КонецЕсли;

	Отборы = Аргументы.Получить("filters");
	Если ТипЗнч(Отборы) = Тип("Соответствие") Тогда
		Для Каждого Отбор Из Отборы Цикл
			Поле = Новый ПолеКомпоновкиДанных(Отбор.Ключ);
			Доступное = Настройки.Отбор.ДоступныеПоляОтбора.НайтиПоле(Поле);
			Если Доступное = Неопределено Тогда
				ВызватьИсключение "Отбор по полю «" + Отбор.Ключ + "» недоступен в отчёте";
			КонецЕсли;
			Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Элемент.ЛевоеЗначение = Поле;
			Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Элемент.ПравоеЗначение = ПривестиЗначение(Отбор.Значение, Доступное.ТипЗначения, Отбор.Ключ);
			Элемент.Использование = Истина;
		КонецЦикла;
	КонецЕсли;

	Попытка
		// Через объект отчёта: так отрабатывает его ПриКомпоновкеРезультата, как при кнопке «Сформировать».
		ТабДок = Новый ТабличныйДокумент;
		ОтчетОбъект.СкомпоноватьРезультат(ТабДок);
	Исключение
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ". Параметры отчёта: " + ПараметрыОтчета(Настройки);
	КонецПопытки;

	Лимит = ЛимитИзАргументов(Аргументы, 80, 300);
	Строки = Новый Массив;
	Всего = 0;
	Для НомерСтроки = 1 По ТабДок.ВысотаТаблицы Цикл
		Ячейки = Новый Массив;
		Последняя = 0;
		Предыдущий = "";
		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
			Текст = СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст);
			// Объединённая ячейка отдаёт свой текст в каждой колонке — оставляем один раз (числа не трогаем).
			Если Текст = Предыдущий И ЗначениеЗаполнено(Текст) И СтрНайти("0123456789-", Лев(Текст, 1)) = 0 Тогда
				Текст = "";
			Иначе
				Предыдущий = Текст;
			КонецЕсли;
			Ячейки.Добавить(Текст);
			Если ЗначениеЗаполнено(Текст) Тогда
				Последняя = НомерКолонки;
			КонецЕсли;
		КонецЦикла;
		Если Последняя = 0 Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Если Строки.Количество() < Лимит Тогда
			Пока Ячейки.Количество() > Последняя Цикл
				Ячейки.Удалить(Ячейки.ВГраница());
			КонецЦикла;
			Строки.Добавить(СтрСоединить(Ячейки, " | "));
		КонецЕсли;
	КонецЦикла;

	Сводка = МД.Синоним + ", вариант «" + Вариант.Имя + "», строк: " + Всего;
	Ответ = Новый Соответствие;
	Ответ.Вставить("report", МД.Синоним);
	Ответ.Вставить("variant", Вариант.Имя);
	Ответ.Вставить("variants", Имена);
	Ответ.Вставить("parameters_set", Использованы);
	Ответ.Вставить("rows", Строки);
	Если Всего > Лимит Тогда
		Ответ.Вставить("truncated", "показаны первые " + Лимит + " из " + Всего + " строк — сузь период или отбор");
	КонецЕсли;
	Если Всего = 0 Тогда
		Ответ.Вставить("note", "Отчёт пуст. Это не доказывает, что данных нет: проверь период, параметры и отборы "
			+ "или посчитай запросом, прежде чем так отвечать");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция ПараметрыОтчета(Настройки)

	Имена = Новый Массив;
	Для Каждого Доступный Из Настройки.ПараметрыДанных.ДоступныеПараметры.Элементы Цикл
		Если Имена.Количество() >= 40 Тогда
			Прервать;
		КонецЕсли;
		Имена.Добавить(Строка(Доступный.Параметр) + " (" + ТипСтрокой(Доступный.ТипЗначения) + ")");
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

// Какие расширения установлены, активны ли они и какие объекты конфигурации меняют:
// нужно, когда ошибка или поведение «не как в типовой».
Функция СписокРасширений(Аргументы, Сводка)

	Список = Новый Массив;
	Попытка
		Установленные = РасширенияКонфигурации.Получить();
	Исключение
		Установленные = Неопределено;
	КонецПопытки;
	Если Установленные <> Неопределено Тогда
		Для Каждого Расширение Из Установленные Цикл
			Описание = Новый Соответствие;
			Описание.Вставить("name", Расширение.Имя);
			Описание.Вставить("synonym", Расширение.Синоним);
			Описание.Вставить("version", Расширение.Версия);
			Описание.Вставить("purpose", Строка(Расширение.Назначение));
			Описание.Вставить("active", Расширение.Активно);
			Описание.Вставить("safe_mode", Строка(Расширение.БезопасныйРежим));
			Описание.Вставить("scope", Строка(Расширение.ОбластьДействия));
			Если Расширение.Имя = "иик_ИИКонсультант" Тогда
				Описание.Вставить("note", "это сам ИИ-консультант: только свои объекты, объекты конфигурации не меняет");
			КонецЕсли;
			Список.Добавить(Описание);
		КонецЦикла;
	КонецЕсли;

	// Объекты, доработанные расширениями (заимствованные с изменениями) и собственные объекты расширений.
	Измененные = Новый Массив;
	Собственные = Новый Соответствие;
	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Документы);
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыБухгалтерии);
	Коллекции.Добавить(Метаданные.Отчеты);
	Коллекции.Добавить(Метаданные.Обработки);
	Коллекции.Добавить(Метаданные.ОбщиеМодули);
	Коллекции.Добавить(Метаданные.ОбщиеФормы);
	Коллекции.Добавить(Метаданные.Перечисления);
	Коллекции.Добавить(Метаданные.ПланыВидовХарактеристик);
	Коллекции.Добавить(Метаданные.ПланыСчетов);
	Коллекции.Добавить(Метаданные.Роли);
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Объект Из Коллекция Цикл
			Владелец = Объект.РасширениеКонфигурации();
			Если Владелец <> Неопределено Тогда
				Имена = Собственные.Получить(Владелец.Имя);
				Если Имена = Неопределено Тогда
					Имена = Новый Массив;
					Собственные.Вставить(Владелец.Имя, Имена);
				КонецЕсли;
				Если Имена.Количество() < 100 Тогда
					Имена.Добавить(Объект.ПолноеИмя());
				КонецЕсли;
			ИначеЕсли Объект.ЕстьИзмененияРасширениямиКонфигурации() И Измененные.Количество() < 200 Тогда
				Измененные.Добавить(Объект.ПолноеИмя());
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Установленные = Неопределено Тогда
		// Без прав на администрирование расширений список берём по метаданным активных расширений.
		Для Каждого КлючИЗначение Из Собственные Цикл
			Описание = Новый Соответствие;
			Описание.Вставить("name", КлючИЗначение.Ключ);
			Описание.Вставить("active", Истина);
			Список.Добавить(Описание);
		КонецЦикла;
	КонецЕсли;

	Сводка = "расширений: " + Список.Количество() + ", доработано объектов: " + Измененные.Количество();
	Ответ = Новый Соответствие;
	// Прямой ответ про конкретный объект: «Документ.X» или имя модуля из текста ошибки.
	ИмяОбъекта = Аргументы.Получить("object");
	Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
		Части = СтрРазделить(СтрЗаменить(СтрЗаменить(Строка(ИмяОбъекта), "{", ""), "}", ""), ".");
		МДОбъекта = ?(Части.Количество() >= 2, Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]), Неопределено);
		Если МДОбъекта = Неопределено Тогда
			ВызватьИсключение "object: не найден объект «" + ИмяОбъекта + "», пример — «Документ.РеализацияТоваровУслуг»";
		КонецЕсли;
		Изменен = МДОбъекта.ЕстьИзмененияРасширениямиКонфигурации();
		Ответ.Вставить("object", МДОбъекта.ПолноеИмя());
		Ответ.Вставить("object_changed_by_extensions", Изменен);
		Ответ.Вставить("object_verdict", МДОбъекта.ПолноеИмя() + ?(Изменен,
			" ИЗМЕНЁН расширением — причина может быть в нём (расширение могло отстать от версии конфигурации)",
			" расширениями НЕ изменён — причина не в расширениях, ищи в данных или в типовом коде"));
		Сводка = МДОбъекта.ПолноеИмя() + ?(Изменен, " изменён расширением", " не изменён расширениями");
	КонецЕсли;
	Ответ.Вставить("extensions", Список);
	Ответ.Вставить("changed_objects", Измененные);
	Ответ.Вставить("changed_objects_note", "объекты, изменённые каким-либо расширением (какое именно — по списку не видно)");
	Ответ.Вставить("own_objects", Собственные);
	Если Установленные = Неопределено Тогда
		Ответ.Вставить("note", "Нет прав читать список расширений: показаны только активные (по метаданным сеанса)");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нижний регистр и «ё» → «е»: модель пишет «счёт», а в синонимах «Счет».
Функция БезЁ(Текст)

	Возврат СтрЗаменить(НРег(Текст), "ё", "е");

КонецФункции

Функция КоллекцииМетаданных()

	Коллекции = Новый Массив;
	ДобавитьКоллекцию(Коллекции, "Справочник", Метаданные.Справочники);
	ДобавитьКоллекцию(Коллекции, "Документ", Метаданные.Документы);
	ДобавитьКоллекцию(Коллекции, "РегистрНакопления", Метаданные.РегистрыНакопления);
	ДобавитьКоллекцию(Коллекции, "РегистрСведений", Метаданные.РегистрыСведений);
	ДобавитьКоллекцию(Коллекции, "РегистрБухгалтерии", Метаданные.РегистрыБухгалтерии);
	ДобавитьКоллекцию(Коллекции, "Перечисление", Метаданные.Перечисления);
	ДобавитьКоллекцию(Коллекции, "ПланСчетов", Метаданные.ПланыСчетов);
	ДобавитьКоллекцию(Коллекции, "ПланВидовХарактеристик", Метаданные.ПланыВидовХарактеристик);
	ДобавитьКоллекцию(Коллекции, "Отчет", Метаданные.Отчеты);
	ДобавитьКоллекцию(Коллекции, "Обработка", Метаданные.Обработки);
	ДобавитьКоллекцию(Коллекции, "Константа", Метаданные.Константы);
	ДобавитьКоллекцию(Коллекции, "ЖурналДокументов", Метаданные.ЖурналыДокументов);
	Возврат Коллекции;

