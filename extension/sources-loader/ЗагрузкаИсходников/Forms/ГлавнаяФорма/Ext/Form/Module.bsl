// Загружает тексты модулей из выгрузки конфигурации в файлы в регистр иик_ИсходныйКод расширения
// ИИ-консультанта: по ним работают code_read и code_search. Запуск — extension/load-sources.sh:
//   1cv8 ENTERPRISE /F<база> /Execute ЗагрузкаИсходников.epf /C"<лог>|Конфигурация=<каталог>|Расширение1=<каталог>"
// Каждый источник перезаписывается целиком: старые модули этого источника удаляются.

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Части = СтрРазделить(ПараметрЗапуска, "|", Ложь);
	Если Части.Количество() > 0 Тогда
		Лог = ЗагрузитьНаСервере(ПараметрЗапуска);
		Запись = Новый ЗаписьТекста(Части[0], КодировкаТекста.UTF8);
		Запись.Записать(Лог);
		Запись.Закрыть();
	КонецЕсли;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьНаСервере(Параметры)

	Лог = Новый Массив;
	Если Метаданные.РегистрыСведений.Найти("иик_ИсходныйКод") = Неопределено Тогда
		Возврат "ОШИБКА: в базе нет расширения ИИ-консультанта (или стоит старая версия без хранилища исходников) — "
			+ "сначала установите его: extension/deploy.sh <база>";
	КонецЕсли;
	Части = СтрРазделить(Параметры, "|", Ложь);
	Для Индекс = 1 По Части.Количество() - 1 Цикл
		Позиция = СтрНайти(Части[Индекс], "=");
		Источник = СокрЛП(Лев(Части[Индекс], Позиция - 1));
		Каталог = СокрЛП(Сред(Части[Индекс], Позиция + 1));
		Попытка
			Лог.Добавить(ЗагрузитьИсточник(Источник, Каталог));
		Исключение
			Лог.Добавить("ОШИБКА " + Источник + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьИсточник(Источник, Каталог)

	Корень = СтрЗаменить(Каталог, "\", "/");
	Корень = ?(СтрЗаканчиваетсяНа(Корень, "/"), Корень, Корень + "/");
	Файлы = НайтиФайлы(Корень, "*.bsl", Истина);
	Если Файлы.Количество() = 0 Тогда
		ВызватьИсключение "в " + Каталог + " нет модулей *.bsl — это выгрузка конфигурации в файлы?";
	КонецЕсли;

	Набор = РегистрыСведений.иик_ИсходныйКод.СоздатьНаборЗаписей();
	Набор.Отбор.Источник.Установить(Источник);
	Набор.Записать();

	Модулей = 0;
	Строк = 0;
	Пропущено = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Путь = Сред(СтрЗаменить(Файл.ПолноеИмя, "\", "/"), СтрДлина(Корень) + 1);
		Модуль = ИмяМодуля(Путь);
		Если Модуль = Неопределено Тогда
			Если Пропущено.Количество() < 5 Тогда
				Пропущено.Добавить(Путь);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(Файл.ПолноеИмя, КодировкаТекста.UTF8);
		Код = СтрЗаменить(Текст.ПолучитьТекст(), Символы.ВК, "");
		Запись = РегистрыСведений.иик_ИсходныйКод.СоздатьМенеджерЗаписи();
		Запись.Источник = Источник;
		Запись.Модуль = Модуль;
		Запись.Текст = Код;
		Запись.Строк = Текст.КоличествоСтрок();
		Запись.Методы = Методы(Код);
		Запись.Записать();
		Модулей = Модулей + 1;
		Строк = Строк + Запись.Строк;
	КонецЦикла;
	Возврат СтрШаблон("%1: модулей %2, строк %3%4", Источник, Модулей, Формат(Строк, "ЧГ=0"),
		?(Пропущено.Количество() = 0, "", "; не распознаны, например: " + СтрСоединить(Пропущено, ", ")));

КонецФункции

// Путь в выгрузке → имя модуля, как его пишет 1С в тексте ошибки
// (Documents/X/Ext/ObjectModule.bsl → Документ.X.МодульОбъекта).
&НаСервереБезКонтекста
Функция ИмяМодуля(Путь)

	Части = СтрРазделить(Путь, "/", Ложь);
	Классы = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить("Catalogs=Справочник,Documents=Документ,DataProcessors=Обработка,Reports=Отчет,"
		+ "CommonModules=ОбщийМодуль,CommonForms=ОбщаяФорма,CommonCommands=ОбщаяКоманда,InformationRegisters=РегистрСведений,"
		+ "AccumulationRegisters=РегистрНакопления,AccountingRegisters=РегистрБухгалтерии,CalculationRegisters=РегистрРасчета,"
		+ "ChartsOfAccounts=ПланСчетов,ChartsOfCharacteristicTypes=ПланВидовХарактеристик,ChartsOfCalculationTypes=ПланВидовРасчета,"
		+ "ExchangePlans=ПланОбмена,Enums=Перечисление,DocumentJournals=ЖурналДокументов,BusinessProcesses=БизнесПроцесс,"
		+ "Tasks=Задача,Constants=Константа,HTTPServices=HTTPСервис,WebServices=WebСервис,SettingsStorages=ХранилищеНастроек,"
		+ "FilterCriteria=КритерийОтбора,Sequences=Последовательность", ",") Цикл
		Классы.Вставить(Лев(Пара, СтрНайти(Пара, "=") - 1), Сред(Пара, СтрНайти(Пара, "=") + 1));
	КонецЦикла;
	Модули = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить("ObjectModule.bsl=МодульОбъекта,ManagerModule.bsl=МодульМенеджера,"
		+ "RecordSetModule.bsl=МодульНабораЗаписей,ValueManagerModule.bsl=МодульМенеджераЗначения,Module.bsl=Модуль", ",") Цикл
		Модули.Вставить(Лев(Пара, СтрНайти(Пара, "=") - 1), Сред(Пара, СтрНайти(Пара, "=") + 1));
	КонецЦикла;

	Если Части.Количество() = 2 И Части[0] = "Ext" Тогда
		Приложения = Новый Соответствие;
		Приложения.Вставить("ManagedApplicationModule.bsl", "МодульУправляемогоПриложения");
		Приложения.Вставить("SessionModule.bsl", "МодульСеанса");
		Приложения.Вставить("ExternalConnectionModule.bsl", "МодульВнешнегоСоединения");
		Приложения.Вставить("OrdinaryApplicationModule.bsl", "МодульОбычногоПриложения");
		Имя = Приложения.Получить(Части[1]);
		Возврат ?(Имя = Неопределено, Неопределено, "Конфигурация." + Имя);
	КонецЕсли;
	Класс = Классы.Получить(Части[0]);
	Если Класс = Неопределено Или Части.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект = Части[1];
	Если Класс = "ОбщийМодуль" Тогда
		Возврат "ОбщийМодуль." + Объект;
	ИначеЕсли Класс = "ОбщаяФорма" Тогда
		Возврат "ОбщаяФорма." + Объект + ".Форма";
	ИначеЕсли Класс = "ОбщаяКоманда" Тогда
		Возврат "ОбщаяКоманда." + Объект + ".МодульКоманды";
	ИначеЕсли Части[2] = "Forms" И Части.Количество() > 3 Тогда
		Возврат Класс + "." + Объект + ".Форма." + Части[3] + ".Форма";
	ИначеЕсли Части[2] = "Commands" И Части.Количество() > 3 Тогда
		Возврат Класс + "." + Объект + ".Команда." + Части[3] + ".МодульКоманды";
	КонецЕсли;
	Вид = Модули.Получить(Части[Части.ВГраница()]);
	Возврат ?(Вид = Неопределено, Неопределено, Класс + "." + Объект + "." + Вид);

КонецФункции

// Процедуры и функции модуля — «строка|вид|имя|1 (экспорт)|аннотация» по строке на метод.
// Аннотация — перехват в расширении (&Вместо("Имя"), &Перед, &После, &ИзменениеИКонтроль): по ней
// консультант видит, какую типовую процедуру подменяет расширение.
&НаСервереБезКонтекста
Функция Методы(Код)

	Найдено = Новый Массив;
	Номер = 0;
	Аннотация = "";
	Для Каждого СтрокаКода Из СтрРазделить(Код, Символы.ПС, Истина) Цикл
		Номер = Номер + 1;
		Начало = СокрЛ(СтрокаКода);
		Если СтрНачинаетсяС(Начало, "&") Тогда
			Нижний = НРег(Начало);
			Если СтрНачинаетсяС(Нижний, "&вместо") Или СтрНачинаетсяС(Нижний, "&перед") Или СтрНачинаетсяС(Нижний, "&после")
				Или СтрНачинаетсяС(Нижний, "&изменениеиконтроль") Тогда
				Аннотация = СокрП(Начало);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Нижний = НРег(Начало);
		Если СтрНачинаетсяС(Нижний, "асинх ") Тогда
			Начало = СокрЛ(Сред(Начало, 7));
			Нижний = НРег(Начало);
		КонецЕсли;
		Если СтрНачинаетсяС(Нижний, "процедура ") Тогда
			Вид = "Процедура";
		ИначеЕсли СтрНачинаетсяС(Нижний, "функция ") Тогда
			Вид = "Функция";
		Иначе
			Если ЗначениеЗаполнено(Начало) И Не СтрНачинаетсяС(Начало, "//") Тогда
				Аннотация = "";
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Остаток = СокрЛ(Сред(Начало, СтрДлина(Вид) + 2));
		Скобка = СтрНайти(Остаток, "(");
		Если Скобка < 2 Тогда
			Продолжить;
		КонецЕсли;
		Имя = СокрЛП(Лев(Остаток, Скобка - 1));
		Найдено.Добавить(СтрШаблон("%1|%2|%3|%4|%5", Формат(Номер, "ЧГ=0"), Вид, Имя,
			?(СтрНайти(Нижний, "экспорт") > 0, "1", "0"), СтрЗаменить(Аннотация, "|", "/")));
		Аннотация = "";
	КонецЦикла;
	Возврат СтрСоединить(Найдено, Символы.ПС);

КонецФункции
